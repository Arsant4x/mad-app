  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  invoiceTenant Invoice @relation("InvoiceLine_invoiceId_tenant", fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ **رقمُ السطر في مستنده — ترتيبُه المعلَن لا المصادَف** (`ق-١٤١٢`): يُكتب من ترتيب الإدخال
  /// (`1..n` بلا فجوة — `numberLines`) ويُقرأ به كلُّ ما يعرض السطور أو يختمها (`LINE_ORDER`)، فالشاشةُ
  /// والطباعةُ و`cbc:ID` في المستند المختوم ترى الترتيبَ نفسَه. كانت السطورُ تُقرأ بلا ترتيب فتأتي بترتيبها
  /// على القرص، وهو يتبدّل بما يُحذف ويُكتب حولها — **وأسقط اختبارَ الخصم متقطّعاً**.
  /// **بلا افتراضٍ في القاعدة**: كلُّ إنشاءٍ يذكره، ومكرَّرُه في المستند الواحد يُرفض (الفريدُ أدناه).
  lineNo Int

  description String

  /// ⭐ **The item this line sold — the link COGS needs and never had.**
  ///
  /// Nullable in the column, mandatory in the DTO for stocked lines. Three
  /// populations share the table and the difference matters:
  ///
  ///   · rows written before this wave — NULL, and no COGS is computed for
  ///     them, because nothing can say which item left the shelf;
  ///   · service lines (rent, a consulting hour, a maintenance callout) —
  ///     NULL by nature, and no COGS applies to them either;
  ///   · stocked lines from here on — always set.
  ///
  /// ⚠️ The consequence is deliberate and must not be read as a defect: a
  /// margin report over an old document shows revenue with no cost against it.
  /// The alternative — inventing an item for a line that never had one — would
  /// produce a *wrong* cost instead of an absent one.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product? @relation("InvoiceLine_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Precision follows the platform-wide scale table in
  /// `common/money/rounding.ts` — quantity 3dp, net unit price 6dp. A pharmacy
  /// sells by the pill, a salon measures in millilitres and a fuel pump in
  /// litres; two decimals silently round those away at the point of entry.
  ///
  /// ⚠️ Widening a numeric column REWRITES the table under an
  /// `AccessExclusiveLock` — measured: 925ms per million rows, and a
  /// concurrent SELECT is blocked, not slowed. That is why this is set at the
  /// smallest table size the platform will ever have, not later.
  quantity    Decimal @db.Decimal(18, 3)
  /// وحدةُ الكمّية كما كانت على الصنف لحظةَ كتابة السطر — تُنسخ ولا تُقرأ من الصنف لاحقاً،
  /// فالمستندُ يذكر وحدتَه ولو تغيّر الصنف؛ `null` لما كُتب قبل ① أو لصنفٍ لم يُعلن وحدتَه.
  unitCode    String?
  unitPrice   Decimal @db.Decimal(18, 6)
  /// ④B1 — خصمُ السطر مبلغاً (BT-136): صافي السطر = الكمية × السعر − الخصم (BT-131)؛ صفرٌ للقائم — صادقٌ لا افتراض.
  discount    Decimal @default(0) @db.Decimal(18, 2)
  /// ⑧ **مشتقّةٌ من الفئة** لا مُدخَلة: `S`/`LEGACY_STANDARD` ⟵ النسبةُ الأساسية من المصدر الواحد،
  /// وغيرُها صفر. بقي العمودُ لأن الدفترَ والمستندَ يقرآنه؛ والاقترانُ بالفئة قيدُ `CHECK`.
  taxRate     Decimal @default(15) @db.Decimal(5, 2)
  /// ⑧ فئةُ الضريبة **منسوخةً لحظةَ البيع** من الصنف (أو معلَنةً على سطرٍ بلا صنف) — كما `unitCode`؛
  /// والقائمُ: `S` لما كُتب بـ`15`، و`LEGACY_ZERO` لما كُتب بصفرٍ (محبوسٌ على ما سبق الهجرة).
  taxCategory TaxCategory
  taxExemptionReasonCode String?
  taxExemptionReason     String?

  createdAt DateTime @default(now())

  /// الحركات التي سبّبها هذا السطر — `Restrict` من الطرف الآخر: سطرٌ حرّك
  /// مخزوناً لا يُحذف وتُترك حركته يتيمة.
  stockMovements StockMovement[]

  /// **لسطر الإشعار الدائن وحده** (`SPEC 30.2` · `30.4`، موجة أ 2026-09-03): سطرُ الفاتورة
  /// الأصلية الذي يُردّ. به تُعرف حركةُ البيع الأصلية فتُعاد طبقاتها، ويُحسب ما أُرجع منه
  /// سابقاً كي لا يُرجَع أكثر ممّا بِيع. `Restrict`: سطرُ بيعٍ رُدّ منه شيء لا يُحذف.
  /// سطرُ إشعارٍ بلا هذا الرابط إشعارٌ محاسبيّ (خصم · تصحيح) لا يمسّ المخزون.
  returnsLineId String?
  returnsLine   InvoiceLine?  @relation("InvoiceLineReturns", fields: [returnsLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  returnsLineTenant InvoiceLine? @relation("InvoiceLine_returnsLineId_tenant", fields: [companyId, returnsLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  returnedBy    InvoiceLine[] @relation("InvoiceLineReturns")

  /// حالة البضاعة المرتجعة — انظر `ReturnCondition`. فارغةٌ على سطور الفواتير والإشعارات المدينة.
  returnCondition ReturnCondition?

  @@index([companyId, productId])
  @@index([returnsLineId])
  /// رقمُ السطر فريدٌ في مستنده — وفهرسُه هو ما تقرأ به السطورُ مستندَها (لم يكن على `invoiceId` فهرسٌ قطّ).
  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
  stockMovement_invoiceLineId_tenant StockMovement[] @relation("StockMovement_invoiceLineId_tenant")
  invoiceLine_returnsLineId_tenant InvoiceLine[] @relation("InvoiceLine_returnsLineId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A purchase supplier / service provider. Same shape and role as Customer,
/// just for the purchase side.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: نظيرُ `Customer` في جهة الشراء.
model Supplier {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  vatNumber String?
  phone     String?
  category  String?

  warranties Warranty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  /// سندات الصرف للمورّد (`ق-٨٧١`) — `Restrict` على المورّد: من صُرف له لا يُحذف.
  payments  SupplierPayment[]
  /// أسطرُ القيود المنسوبة إلى هذا المورّد — بُعدٌ تحليلي (`ق-٨٧٣`)، انظر JournalLine.
  journalLines JournalLine[]

  @@unique([companyId, name])

  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  @@map("suppliers")
  supplierPayment_supplierId_tenant SupplierPayment[] @relation("SupplierPayment_supplierId_tenant")
  warranty_supplierId_tenant Warranty[] @relation("Warranty_supplierId_tenant")
  journalLine_supplierId_tenant JournalLine[] @relation("JournalLine_supplierId_tenant")
  purchase_supplierId_tenant Purchase[] @relation("Purchase_supplierId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// حالةُ سداد فاتورة الشراء — **مشتقّةٌ مخزَّنة** (`ق-٨٧٢`) من مجموع تخصيصات
/// سندات الصرف مقابل الإجمالي، كـ`InvoiceStatus` حرفياً: `recomputePurchaseStatus`
/// هي المدخلُ الوحيد لكتابتها داخل معاملة كل تغيير تخصيص، وحارسُ انحرافٍ يقارن
/// المخزَّنَ بالمحسوب. ولا `OVERDUE` هنا: التأخّرُ يُقرأ من `dueDate` لحظةَ العرض
/// ولا يُخزَّن — فحالةٌ زمنية مخزَّنة تشيخ بين تغييرَين.
enum PurchaseStatus {
  DUE
  PARTIAL
  PAID
}

/// نوعُ مستند الشراء — كما `InvoiceDocType` للبيع (`ق-١٠٠٦`/③: «ولا نمطَ ثانٍ»): الشراءُ الأصل،
/// **وإشعارُ المورّد الدائن** (يخفّض ما ندين به: إعادةُ بضاعةٍ أو تخفيضُ سعر)، **وإشعارُه المدين**
/// (فوترةٌ إضافية). المبالغُ مخزَّنةٌ موجبةً والنوعُ يحمل الاتجاه — كالبيع حرفاً.
enum PurchaseDocType {
  PURCHASE
  SUPPLIER_CREDIT_NOTE
  SUPPLIER_DEBIT_NOTE
}

/// A purchase invoice / recurring obligation (utilities, rent, payroll...).
///
/// السدادُ **مستندٌ يُرحَّل** (`ق-٨٦٦` · `ق-٨٧١`): `SupplierPayment` وتخصيصاتُه هما
/// مصدرُ «المسدَّد» و«المتبقّي» — ولا حقلَ مبلغٍ مسدَّد هنا. وكان علَمان
/// (`paid` · `paidDate`) يقولان «سُدِّد» بلا حسابٍ ولا مبلغٍ ولا قيد، فبقي `2100`
/// لا ينقص أبداً؛ **حُذفا** ولم يبقيا مشتقَّين بالاسم الثنائيّ (عائلة `?? MOCK`).
model Purchase {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  no         String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  supplierTenant Supplier @relation("Purchase_supplierId_tenant", fields: [companyId, supplierId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ **إشعارُ المورّد صفٌّ في جدول الشراء نفسِه بنوعه** (`ق-١٠٠٦`/③ — «كما في إشعار البيع،
  /// ولا نمطَ ثانٍ»): مستندُه هو، **وقيدُه قيدُنا** (`ق-١٠٠٦`/①). لا رقمَ منّا يُصدَر له
  /// (رقمُنا `SCN-`/`SDN-` مرجعٌ داخليّ) ولا ختمَ ولا سلسلةَ — ورقمُه في `supplierRef`.
  docType PurchaseDocType @default(PURCHASE)
  /// الإشعاراتُ وحدَها: الشراءُ الذي يصحّحه هذا الإشعار — أو الإشعارُ المقابل الذي يصحّحه
  /// (دائنٌ على مدينٍ زائد وعكسُه). `Restrict`: شراءٌ صدر عليه إشعارٌ يبقى في الملفّ.
  relatedPurchaseId String?
  relatedPurchase   Purchase?  @relation("PurchaseAdjustments", fields: [relatedPurchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  relatedPurchaseTenant Purchase? @relation("Purchase_relatedPurchaseId_tenant", fields: [companyId, relatedPurchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  adjustments       Purchase[] @relation("PurchaseAdjustments")
  /// سببُ الإشعار كما على مستند المورّد.
  adjustmentReason String?
  /// **رقمُ مستند المورّد** كما على ورقته — فاتورتُه أو إشعارُه — **مرجعٌ خارجيٌّ لا رقمُنا**
  /// (`ق-١٠٠٦`/①: «يُسجَّل مرجعاً خارجياً كما يُسجَّل رقمُ فاتورة الشراء»).
  supplierRef String?

  date     DateTime  @db.Date
  dueDate  DateTime? @db.Date
  /// اللافتة كما كتبها التاجر — للعرض. نصٌّ حرّ، فقد يكون فئةً لا يعرفها النظام.
  category String?
  /// الرمز الذي **تُتَّخذ به القرارات** (الإطفاء · تقرير التأسيس · حساب الترحيل).
  /// نصٌّ عربيّ حرفاً بحرف كان يقرّرها، فمسافةٌ لاحقة كانت تنقل الفاتورة من
  /// تقريرٍ إلى لا شيء. المصدر الواحد: `common/purchase-categories.ts`.
  categoryCode String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("Purchase_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  subtotal  Decimal @db.Decimal(18, 2)
  taxAmount Decimal @db.Decimal(18, 2)
  exempt    Boolean @default(false)
  /// ⑥A1 (`ق-١٣٢٥` · `ق-٨٢٤`/①) — **إلى أيِّ توريدٍ تُنسَب ضريبةُ مدخلات هذا الشراء.**
  ///
  /// ⚠️ **وهو غيرُ `exempt`**: ذاك يقول «لا ضريبةَ على الشراء أصلاً»، وهذا يقول «الضريبةُ
  /// حُمِّلت — فأين استُعملت؟». فصيانةُ مبنىً سكنيّ **شراءٌ خاضع** ومدخلُه **معفى الاستعمال**.
  /// و`LEGACY_UNASSIGNED` للقائم: يُعامَل معاملةَ المشترك ويُعدّ، وقيدُ `CHECK` يمنعه للجديد.
  inputVatUse InputVatUse @default(LEGACY_UNASSIGNED)
  /// ⚖️ `ق-١٣٣٠` · `ق-١٣٤٢` — **يُرحَّل غيرُ القابل للخصم من ضريبته إلى تكلفة ما اشتُري؟**
  ///
  /// `true` لكلِّ مستندٍ بعد البناء، و`false` لما سبقه: **القديمُ يُعدّ ويُعلَن ولا يُحوَّل** (`ق-١١٧٨`) —
  /// ضريبتُه باقيةٌ في `1250` ويعدّها الإقرارُ «غيرَ مرحَّل». والإشعارُ يرث قيمةَ أصله عند إنشائه، فلا يُرحِّل
  /// إشعارٌ جديد عكسَ ما لم يُرحَّل لأصلٍ قديم.
  nonDeductibleTracked Boolean @default(true)
  /// VAT was charged but there's no valid tax invoice, so its input VAT cannot
  /// be reclaimed — the purchase is dropped from the VAT declaration. Distinct
  /// from `exempt` (no VAT at all).
  ///
  /// ⚖️ `ق-١٣٦١` — **ويمسّ الدفترَ لا الإقرارَ وحدَه** (صُحّح: كان «this affects only the declaration, not the ledger»
  /// منقولاً عن النموذج): الضريبةُ غيرُ المستردّة **تدخل تكلفةَ ما اشتُري عند الشراء، كالمنسوب إلى المعفى** — «فهي غيرُ مستردّة،
  /// والمعاييرُ لا تفرّق بسبب عدم الاسترداد». فتخرج من `1250` إلى موضعها (طبقةٌ · وسيطٌ · حسابُ الفئة · `5100`) بقاعدة الانتشار
  /// نفسِها (`non-deductible-vat.util.ts`)؛ **وما سبق البناء يُعدّ ولا يُحوَّل** (`nonDeductibleTracked`).
  excludeFromVat Boolean @default(false)
  total     Decimal @db.Decimal(18, 2)

  /// Establishment ("مصروفات تأسيس") costs may be marked for amortization over
  /// `amortizeMonths`. Reporting metadata only — the expense still hits 5500 in
  /// full; there is no automatic monthly posting (same stance as key money).
  amortize       Boolean @default(false)
  amortizeMonths Int?
  /// Which establishment line this purchase belongs to ("رسوم ترخيص",
  /// "تجهيزات") — groups the incorporation-expenses report. Free text: the
  /// items differ per business and the mockup never constrained them.
  incorpItem     String?

  currency      String  @default("SAR")
  exchangeRate  Decimal @default(1) @db.Decimal(18, 6)
  baseSubtotal  Decimal @db.Decimal(18, 2)
  baseTaxAmount Decimal @db.Decimal(18, 2)
  baseTotal     Decimal @db.Decimal(18, 2)

  /// مشتقّةٌ مخزَّنة — انظر `PurchaseStatus`. تُكتب من `recomputePurchaseStatus` وحدها.
  status PurchaseStatus @default(DUE)

  /// ⚖️ **الحذفُ إلغاءٌ بقيد عكس لا محو** (`ق-٩٩٧`/②): لحظةُ الإلغاء. الصفُّ يبقى بقيده وقيدِ عكسه، ولا يقبل
  /// تعديلاً ولا إشعاراً ولا يدخل المفتوحة، والإقرارُ يقرأ الإلغاءَ في ربعه لا في ربع الأصل.
  voidedAt DateTime?

  /// Same deal as Invoice.journalEntryId — null if required accounts aren't
  /// set up yet, Restrict so the entry can't be deleted out from under it.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("Purchase_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// تخصيصاتُ سندات الصرف عليها — مصدرُ الحقيقة الوحيد لـ«المسدَّد».
  paymentAllocations SupplierPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments PurchaseAttachment[]
  lines       PurchaseLine[]
  /// ٢٥ استلاماتُ هذا الشراء — الضمنيُّ الواحد، أو استلاماتٌ مسجَّلة على مرّات (وما أُلغي يبقى بـ`voidedAt`).
  receipts    GoodsReceipt[]
  /// ٧ توزيعاتُ التكلفة المحمَّلة التي يحملها هذا الشراء الخدميّ (فاتورةُ ناقلٍ أو مخلّص).
  landedCostDistributions LandedCostDistribution[]
  /// `ق-١٣٤٢` أحداثُ ضريبة المدخلات غيرِ القابلة للخصم لهذا المستند (شراءً كان أو إشعارَ مورّد).
  nonDeductibleVatEvents NonDeductibleVatEvent[]
  /// ⚖️ `ق-١٣٦٤` حصصُ فرقِ السعر على الطبقات ومخارجها — لإشعار السعر من المورّد.
  layerCostShares LayerCostShare[]

  @@unique([companyId, no])
  @@index([companyId, categoryCode])
  @@index([relatedPurchaseId])
  @@map("purchases")
  supplierPaymentAllocation_purchaseId_tenant SupplierPaymentAllocation[] @relation("SupplierPaymentAllocation_purchaseId_tenant")
  purchaseAttachment_purchaseId_tenant PurchaseAttachment[] @relation("PurchaseAttachment_purchaseId_tenant")
  landedCostDistribution_purchaseId_tenant LandedCostDistribution[] @relation("LandedCostDistribution_purchaseId_tenant")
  nonDeductibleVatEvent_purchaseId_tenant NonDeductibleVatEvent[] @relation("NonDeductibleVatEvent_purchaseId_tenant")
  layerCostShare_purchaseId_tenant LayerCostShare[] @relation("LayerCostShare_purchaseId_tenant")
  goodsReceipt_purchaseId_tenant GoodsReceipt[] @relation("GoodsReceipt_purchaseId_tenant")
  purchaseLine_purchaseId_tenant PurchaseLine[] @relation("PurchaseLine_purchaseId_tenant")
  purchase_relatedPurchaseId_tenant Purchase[] @relation("Purchase_relatedPurchaseId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⭐ **The purchase line — the row this platform never had.**
///
/// A purchase was a header: supplier, category, `subtotal`, `total`. Nothing
/// on it said *what* was bought, so `postPurchaseToLedger` had one signal to
/// route by — a free-text category string — and no event anywhere carried
/// (item, quantity, cost) together. That absence is why inventory layers had
/// no input and COGS had no trigger: not a missing feature, a missing row.
///
/// ⚠️ **This wave creates the row and stops there.** Posting still reads the
/// header, exactly as before — the ledger does not change by one entry. What
/// changes is that a later wave finally has something to read.
///
/// The split the plan calls for — `مخزني ← أصل · خدمي ← مصروف` — is expressed
/// by `productId`: a line with an item is stocked, a line without one is a
/// service. No separate flag, because a flag can disagree with the item and
/// then something has to decide which lies.
model PurchaseLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("PurchaseLine_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  description String

  /// Set ⇒ stocked line. Null ⇒ service line, and **no COGS is ever computed
  /// for it** — there is no item to consume a cost layer from.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product? @relation("PurchaseLine_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Born at the platform scale, not widened into it later — the guard in
  /// `common/money/rounding.spec.ts` fails the build otherwise.
  quantity  Decimal @db.Decimal(18, 3)
  /// وحدةُ الكمّية منسوخةً من الصنف لحظةَ الكتابة (كما في `InvoiceLine.unitCode`).
  unitCode  String?
  unitPrice Decimal @db.Decimal(18, 6)
  taxRate   Decimal @default(15) @db.Decimal(5, 2)

  /// ٥+٦ الدفعةُ والانتهاءُ كما وصلا على السطر (`ق-١٠٨٦`) — الاستلامُ يصنع منهما كيانَ الدفعة ويربط طبقتَه به.
  /// كانت أسطرُ الشراء بلا حقلِ دفعةٍ أصلاً (`ق-١٠٨٠`)؛ ولصنفٍ معلَنٍ تتبّعُه غيابُهما يُردّ مسمًّى ولا يُقبل صامتاً.
  batchNo    String?
  expiryDate DateTime? @db.Date

  /// **لسطر إشعار المورّد وحده** — مرآةُ `InvoiceLine.returnsLineId`: سطرُ الشراء الأصليّ الذي
  /// يصحّحه. به تُعرف طبقةُ الاستلام الأصلية فتخرج منها المُعادة أو يُعدَّل سعرُها
  /// (`ق-١٠٠٦`/③)، ويُحسب ما أُعيد منه سابقاً. `Restrict`: سطرُ شراءٍ صُحِّح لا يُحذف.
  /// سطرٌ بلا هذا الرابط إشعارٌ محاسبيّ لا يمسّ الرفّ.
  returnsPurchaseLineId String?
  returnsPurchaseLine   PurchaseLine?  @relation("PurchaseLineReturns", fields: [returnsPurchaseLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  returnsPurchaseLineTenant PurchaseLine? @relation("PurchaseLine_returnsPurchaseLineId_tenant", fields: [companyId, returnsPurchaseLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  returnedBy            PurchaseLine[] @relation("PurchaseLineReturns")
  /// هل **أُعيدت البضاعةُ فعلاً** إلى المورّد (تخرج من الرفّ) — أم أنه إشعارُ سعرٍ بلا بضاعة
  /// (الرفُّ يبقى وتكلفتُه تتبع). على الإشعار الدائن وحده؛ والمدينُ فوترةٌ لا بضاعةَ تُعاد فيه.
  goodsReturned Boolean @default(false)

  /// ⚖️ **السطرُ المُعدَّل يُحفظ متجاوَزاً لا محذوفاً** (`ق-٩٩٧`/①): تعديلُ البنود قبل الاستهلاك يعكس استلامَ
  /// السطر بحركةٍ خارجة تشير إليه ثم يستلم الجديد — فالقديمُ يبقى لأن دفترَ المخزون يرويه. الحيُّ ما كان هذا فارغاً.
  supersededAt DateTime?

  createdAt DateTime @default(now())

  stockMovements StockMovement[]

  /// ٢٥ استلاماتُ هذا السطر — كاملةً أو على مرّات (`ق-١١٢٢`/②)؛ والمتبقّي للاستلام = `quantity − Σ` غيرِ الملغى منها.
  receiptLines GoodsReceiptLine[]
  /// ٧ توزيعُ هذا السطر الخدميّ على طبقاتٍ — واحدٌ فعّال (فهرسٌ جزئيّ في الهجرة)، وما أُلغي يبقى.
  landedCostDistributions LandedCostDistribution[]
  /// `ق-١٣٤٢` مواضعُ حصّة هذا السطر من الضريبة غيرِ القابلة للخصم — حدثاً حدثاً.
  nonDeductibleVatEventLines NonDeductibleVatEventLine[]

  @@index([purchaseId])
  @@index([companyId, productId])
  @@index([returnsPurchaseLineId])
  @@map("purchase_lines")
  stockMovement_purchaseLineId_tenant StockMovement[] @relation("StockMovement_purchaseLineId_tenant")
  landedCostDistribution_purchaseLineId_tenant LandedCostDistribution[] @relation("LandedCostDistribution_purchaseLineId_tenant")
  nonDeductibleVatEventLine_purchaseLineId_tenant NonDeductibleVatEventLine[] @relation("NonDeductibleVatEventLine_purchaseLineId_tenant")
  goodsReceiptLine_purchaseLineId_tenant GoodsReceiptLine[] @relation("GoodsReceiptLine_purchaseLineId_tenant")
  purchaseLine_returnsPurchaseLineId_tenant PurchaseLine[] @relation("PurchaseLine_returnsPurchaseLineId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⭐ **الاستلامُ المستقلّ — كيانٌ فوق الشراء لا بدلَه** (`٢٥` · `ق-١١٢١` · `ق-١١٢٢` · `ق-١١٣١`).
///
/// كان الاستلامُ ضمنيّاً داخل إنشاء الشراء: لا جدولَ ولا رقمَ ولا استلامَ جزئيّ، والطبقةُ مؤرَّخةٌ
/// **بتاريخ فاتورة المورّد** لا بوصول البضاعة (`ق-١٩` يفرّق بين الحدثين والمبنيُّ كان يجمعهما).
/// الآن لكلِّ وصولٍ مستندُه: رقمٌ `GR-YYYY-NNNN` من العدّاد الذرّيّ (`ق-٣٢٨`)، ومستودعٌ وتاريخُ
/// استلامٍ **هو تاريخُ الطبقة** (`acquiredAt = receivedAt`)، وسطورٌ تشير إلى سطور الشراء بالكمّية
/// المستلَمة — فشراءٌ يُستلم على مرّاتٍ له استلاماتٌ عدّة، وما لم يُستلم لا طبقةَ له ولا مخزونَ في الميزانية.
///
/// ## المحاسبة — قيدان لا قيد (`ق-١١٢١`)
/// الفاتورةُ: مدينٌ **وسيطُ الاستلام** (بضاعةٌ مستلَمة غيرُ مفوترة) بقيمة البنود المخزنية / دائنٌ `2100`.
/// وكلُّ استلامٍ — ضمنيّاً كان أو مسجَّلاً — مدينٌ `1300` / دائنٌ الوسيط بما استُلم. فيتصافى الوسيطُ حين
/// يلتقي الحدثان، ويبقى فيه ما فُوتر ولم يُستلم (مدين) أو ما استُلم ولم يُفوتر (دائن — لا يقع اليوم لأن
/// مرجعَ الشراء إلزاميّ). وحارسُ الرصيد يقرأ ما بقي فيه **من المستندات** ويطابقه بالدفتر (`goods-receipts.service`).
///
/// ## الضمنيُّ يبقى الافتراض (`ق-١١٢٢`/⑤)
/// إنشاءُ شراءٍ بسطورٍ مخزنية يُنشئ استلاماً كاملاً بتاريخ الشراء (`implicit = true`) ما لم يُطلب غيرُه
/// (`receiveNow: false` على الطلب — لا علَمَ على المنشأة). والقائمُ قبل البناء (`213` سطراً على التطوير)
/// كُتبت له صفوفُ استلامٍ **من حركاته القائمة** في الهجرة — تاريخُ الحركة ومستودعُها وكمّيتُها، قراءةً لا
/// تخميناً — والطبقاتُ لم تُمسّ (`ق-١١٢٢`/③) وقيودُها بقيت على `1300` مباشرةً.
///
/// ## ما يُؤجَّل معلَناً (`ق-١١٢٢`/④)
/// الاستلامُ قبل الفاتورة (أمرُ الشراء) بابٌ لا يُفتح: `purchaseId` **إلزاميٌّ اليوم**، ويُرخى العمودُ
/// بهجرةٍ حين يُبنى أمرُ الشراء — لا عمودٌ فارغٌ ينتظر مساراً لا وجودَ له.
model GoodsReceipt {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// `GR-YYYY-NNNN` — من العدّاد الذرّيّ لا من `count()` (`ق-٣٢٨`).
  no String

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("GoodsReceipt_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  warehouseTenant Warehouse @relation("GoodsReceipt_warehouseId_tenant", fields: [companyId, warehouseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("GoodsReceipt_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// تاريخُ وصول البضاعة — **وهو تاريخُ الطبقة** الذي يرتّب الرفّ (`FIFO`/`FEFO`).
  receivedAt DateTime @db.Date

  /// وُلد مع الشراء (الافتراضُ الضمنيّ) أو من صفوف ما قبل البناء — لا بيدٍ على شاشة الاستلام.
  /// تعديلُ بنود الشراء يعكس الضمنيَّ ويُعيده؛ والمسجَّلُ بيدٍ يجمّد البنود حتى يُعكس هو أوّلاً.
  implicit Boolean @default(false)

  notes String?

  /// قيدُ الاستلام (مدين `1300` / دائن الوسيط) — `null` لاستلامات ما قبل البناء التي رُحِّلت داخل قيد شرائها.
  journalEntryId String?
  journalEntry   JournalEntry? @relation("GoodsReceiptEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("GoodsReceipt_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ الإلغاءُ عكسٌ لا محو: الصفُّ يبقى، والطبقاتُ تُفرَغ بحركاتٍ خارجة، والقيدُ يُعكس.
  voidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines GoodsReceiptLine[]

  @@unique([companyId, no])
  @@index([purchaseId])
  @@index([companyId, receivedAt])
  @@map("goods_receipts")
  goodsReceiptLine_goodsReceiptId_tenant GoodsReceiptLine[] @relation("GoodsReceiptLine_goodsReceiptId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// سطرُ الاستلام — كمّيةٌ مستلَمة من سطر شراءٍ بعينه، وحركةُ الإدخال تشير إليه **وإلى سطر الشراء معاً**
/// فلا ينكسر ما يقرأ `purchaseLineId` (الإعادةُ إلى المورّد · إشعارُ السعر · العكس).
model GoodsReceiptLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  goodsReceiptTenant GoodsReceipt @relation("GoodsReceiptLine_goodsReceiptId_tenant", fields: [companyId, goodsReceiptId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  purchaseLineId String
  purchaseLine   PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseLineTenant PurchaseLine @relation("GoodsReceiptLine_purchaseLineId_tenant", fields: [companyId, purchaseLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الكمّيةُ المستلَمة في هذا الاستلام — موجبةٌ (قيدُ `CHECK`) ولا تتجاوز ما بقي من السطر (الخدمة).
  quantity Decimal @db.Decimal(18, 3)

  /// ما رُحِّل لهذا السطر بالعملة الأساسية (مدين `1300`). **والاستلامُ الذي يُكمل السطر يرحّل الفرقَ** عمّا
  /// رُحِّل قبله — لا كمّيتَه مضروبةً مدوَّرةً — فيتصافى الوسيطُ بلا هللةٍ عالقة من تدويرٍ متكرّر.
  baseAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  stockMovements StockMovement[]

  @@index([goodsReceiptId])
  @@index([purchaseLineId])
  @@map("goods_receipt_lines")
  stockMovement_goodsReceiptLineId_tenant StockMovement[] @relation("StockMovement_goodsReceiptLineId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// طريقةُ توزيع التكلفة المحمَّلة على الطبقات — **لكلِّ توزيعٍ لا للمنشأة** (خطّةُ الأجهزة `§٧.٢`).
enum LandedCostMethod {
  /// بالقيمة: نصيبُ كلِّ طبقةٍ بنسبة قيمة سطر استلامها الأساسية (الافتراض).
  VALUE
  /// بالكمّية: بنسبة الكمّية المستلَمة في الطبقة.
  QUANTITY
  /// يدوياً: مبالغُ لكلِّ طبقة، ومجموعُها قيمةُ السطر.
  MANUAL
}

/// ⭐ **التكلفةُ المحمَّلة — توزيعُ فاتورةٍ خدمية على طبقاتٍ مسمّاة** (`٧` · `ق-١١٤٥` · `ق-١١٤٦`).
///
/// فاتورةُ الناقل أو المخلّص أو الجمارك **شراءٌ خدميٌّ كما هي** (مورّدُها الناقل، ذمّتُها `2100`، ضريبتُها
/// `1250`، ومصروفُها حسابُ فئتها) — **ولا نوعَ مستندٍ ثالث ولا رقمَ تسلسل**. وما يُضاف توزيعٌ: سطرُ شراءٍ
/// خدميّ ⟵ طبقاتٌ (كلُّ طبقةٍ سطرُ استلامٍ بعينه — `1:1` مقيساً `219/219`) ⟵ مبلغٌ بالعملة الأساسية.
///
/// ## نقطةُ التعليق الطبقةُ لا الشراء (`ق-١١٤٦`)
/// الوصلةُ من سطر الاستلام إلى طبقته تمرّ بحركته (`goods_receipt_line ⟵ stock_movement ⟵ inventory_layer`)
/// ولا مفتاحَ مباشراً — فالصفُّ هنا يشير إلى **الطبقة** (وحدةُ التكلفة التي تتغيّر) ويُقرأ استلامُها وشراؤها
/// من خلالها. وإرساليةٌ تصل استلاماتٍ عدّة تُوزَّع على طبقاتِ استلاماتٍ عدّة بلا بابٍ جديد.
///
/// ## المحاسبة — قيدُ إعادة تصنيفٍ مستقلّ، وقيدُ الشراء لا يُمسّ (`ق-١٠٧٥`)
/// مدينٌ `1300` بحصّة ما على الرفّ · مدينٌ `5100` بحصّة ما استُهلك قبل الوصول (في فترة التوزيع لا فترة
/// البيع) · دائنٌ حسابُ فئة الشراء الخدميّ بما وُزِّع. **والنمطُ نمطُ إشعار السعر** (`layer-cost-spread.util`):
/// تكلفةُ الوحدة تزيد بنصيبها، وما استُهلك يذهب إلى تكلفة المبيعات الآن.
///
/// ## حدودٌ مسمّاة
/// - توزيعٌ واحد فعّال لكلِّ سطر شراء — **فهرسٌ جزئيّ في الهجرة** (`WHERE "voidedAt" IS NULL`) لأن Prisma لا تعبّر
///   عن الشرط، والخدمةُ تردّ `409` باسمه قبله.
/// - الإلغاءُ عكسٌ لا محو، **ويُرفض بعد استهلاكٍ لاحق** من طبقاته (المتبقّي لحظةَ التوزيع محفوظٌ على السطر) —
///   حتى يُبنى بابُه؛ وتعديلُ الشراء الخدميّ أو إلغاءُ استلامٍ على طبقته توزيعٌ قائم يُرفض مسمّىً.
/// - لا تقديرَ مبدئيّاً ولا وزنَ/حجمَ (`ق-١١٤٥`/②④) — والتوزيعُ بالقيمة أو الكمّية أو يدوياً.
model LandedCostDistribution {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// الشراءُ الخدميّ (فاتورةُ الناقل/المخلّص) — للقراءة بمساره؛ وسطرُه الموزَّع أدناه.
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("LandedCostDistribution_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// سطرُ الشراء الخدميّ الموزَّع (بلا `productId`) — واحدٌ فعّال لكلِّ سطر (فهرسٌ جزئيّ في الهجرة).
  purchaseLineId String
  purchaseLine   PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseLineTenant PurchaseLine @relation("LandedCostDistribution_purchaseLineId_tenant", fields: [companyId, purchaseLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  method LandedCostMethod

  /// تاريخُ التوزيع — تاريخُ قيده، ويخضع لقفل الفترات كأيّ قيد.
  date DateTime @db.Date

  /// ما وُزِّع بالعملة الأساسية = قيمةُ السطر الأساسية (Σ سطور التوزيع).
  baseAmount Decimal @db.Decimal(18, 2)
  /// Σ حصّة الرفوف — طبقاتُ الاستلام **وطبقاتُ المقصِد التي تبعها الرفع** (مدين `1300` · `ق-١٣٦٤`).
  baseInventory Decimal @db.Decimal(18, 2)
  /// Σ حصّة ما خرج قبل الوصول — **مقسومةً على مخارجها** (البيعُ `5100` · الشطبُ `5800` · اليدويُّ `5810`) في `layer_cost_shares` (`ق-١٣٦٤`).
  baseCogs Decimal @db.Decimal(18, 2)

  /// قيدُ إعادة التصنيف — `null` حين تعذّر الترحيل (دليلٌ ناقص) كسائر المستندات.
  journalEntryId String?
  journalEntry   JournalEntry? @relation("LandedCostEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("LandedCostDistribution_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ الإلغاءُ عكسٌ لا محو: الصفُّ يبقى، وتكلفةُ الطبقات تُعاد، والقيدُ يُعكس بقيدٍ مسجَّلٍ هنا.
  voidedAt           DateTime?
  voidJournalEntryId String?
  voidJournalEntry   JournalEntry? @relation("LandedCostVoidEntry", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  voidJournalEntryTenant JournalEntry? @relation("LandedCostDistribution_voidJournalEntryId_tenant", fields: [companyId, voidJournalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines LandedCostLine[]
  /// ⚖️ `ق-١٣٦٤` حصصُ التوزيع على الطبقات ومخارجها — ومنها ما تبع الوحدةَ إلى طبقة المقصِد (يُعكس معه).
  costShares LayerCostShare[]

  @@index([companyId, purchaseId])
  @@index([purchaseLineId])
  @@map("landed_cost_distributions")
  landedCostLine_distributionId_tenant LandedCostLine[] @relation("LandedCostLine_distributionId_tenant")
  layerCostShare_landedCostDistributionId_tenant LayerCostShare[] @relation("LayerCostShare_landedCostDistributionId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// سطرُ التوزيع — نصيبُ طبقةٍ بعينها، مع ما يلزم لإلغائه بلا تخمين: متبقّي الطبقة وتكلفتُها قبل التوزيع وبعده.
model LandedCostLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  distributionId String
  distribution   LandedCostDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  distributionTenant LandedCostDistribution @relation("LandedCostLine_distributionId_tenant", fields: [companyId, distributionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  layerId String
  layer   InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  layerTenant InventoryLayer @relation("LandedCostLine_layerId_tenant", fields: [companyId, layerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// نصيبُ الطبقة بالعملة الأساسية — غيرُ سالب (قيدُ `CHECK`).
  baseAmount Decimal @db.Decimal(18, 2)
  /// حصّةُ ما على الرفّ منه (تُضاف إلى تكلفة الطبقة).
  baseInventory Decimal @db.Decimal(18, 2)
  /// حصّةُ ما خرج من هذه الطبقة قبل الوصول — مقسومةً على مخارجه في `layer_cost_shares` (`ق-١٣٦٤`).
  baseCogs Decimal @db.Decimal(18, 2)

  /// المتبقّي في الطبقة لحظةَ التوزيع — الإلغاءُ يشترط ألّا يتغيّر (استهلاكٌ لاحق يمنعه مسمّىً).
  qtyRemainingAt Decimal @db.Decimal(18, 3)
  unitCostBefore Decimal @db.Decimal(18, 6)
  unitCostAfter  Decimal @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@index([distributionId])
  @@index([layerId])
  @@map("landed_cost_lines")
}

/// `ق-١٣٤٢` ما أطلق حدثَ الضريبة غيرِ القابلة للخصم — لكلِّ مسارٍ اسمُه، فيُقرأ السجلُّ بلا تخمين.
enum NonDeductibleVatTrigger {
  PURCHASE
  PURCHASE_EDIT
  PURCHASE_VOID
  RECEIPT
  RECEIPT_VOID
  SUPPLIER_NOTE
  /// ⚖️ `ق-١٣٦٠` إقفالُ فترة إقرار: المشتركُ يُرحَّل بنسبة الفترة.
  VAT_RETURN_CLOSING
  /// ⚖️ `ق-١٣٦٠` عكسُ إقفالٍ أو تسوية — حدثٌ عاكسٌ بتاريخه.
  VAT_RETURN_CLOSING_REVERSAL
  /// ⚖️ `ق-١٣٦٠` التسويةُ السنوية (م٥١/٧): المشتركُ بنسبة السنة الفعلية.
  VAT_ANNUAL_ADJUSTMENT
}

/// `ق-١٣٤٢` أين تقع حصّةُ السطر: طبقةٌ على الرفّ (ما عليه يرفع تكلفتَها وما استُهلك منها إلى `5100`) ·
/// وسيطُ الاستلام (مفوتَرٌ لم يُستلم — ينتظر طبقتَه) · حسابُ الفئة (بندٌ خدميّ) · تكلفةُ المبيعات (بضاعةٌ أُعيدت).
enum NonDeductibleVatPlacement {
  LAYER
  CLEARING
  EXPENSE
  COGS
}

/// ⚖️ **غيرُ القابل للخصم من ضريبة المدخلات يدخل تكلفةَ ما اشتُري** (`ق-١٣٣٠` · `ق-١٣٤٢`).
///
/// بنصّ المالك: «وهو حكمُ المعايير نصّاً: الضرائبُ غيرُ المستردّة جزءٌ من تكلفة الشراء» — و«يرث قاعدةَ الانتشار
/// القائمة بعينها، ولا منطقَ جديد». فكلُّ حدثٍ **قيدُ إعادة تصنيفٍ مستقلّ** يُخرج الحصّةَ من `1250` إلى موضعها
/// (أو يُعيدها) — وقيدُ المستند نفسُه لا يُمسّ، كالتكلفة المحمَّلة (`ق-١١٤٦`).
///
/// **والحدثُ فرقٌ لا مطلق**: ما يجب أن يكون في كلِّ موضعٍ الآن ناقصَ ما وُضع فيه قبلُ — فتعديلٌ أو استلامٌ أو
/// إلغاءٌ يُرحّل الفرقَ وحدَه، ويبقى السجلُّ راوياً ما وقع حدثاً حدثاً. ⛔ **والمشتركُ (`MIXED`) لا يُرحَّل هنا** —
/// محبوسٌ على قرارٍ لم يُحسم (متى يُقفل الإقرار وبأيّ تاريخ).
model NonDeductibleVatEvent {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// المستندُ الذي تُحسب حصصُه — شراءٌ أو إشعارُ مورّد.
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("NonDeductibleVatEvent_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  trigger NonDeductibleVatTrigger
  /// تاريخُ الحدث — تاريخُ قيده، وهو تاريخُ ما أطلقه (الشراءُ · الاستلامُ · الإلغاءُ · الإشعار)، ويخضع لقفل الفترات.
  date DateTime @db.Date

  /// ما خرج من `1250` في هذا الحدث (سالبٌ حين يعود إليه) = Σ المواضع الأربعة.
  baseAmount    Decimal @db.Decimal(18, 2)
  baseInventory Decimal @db.Decimal(18, 2)
  baseCogs      Decimal @db.Decimal(18, 2)
  baseExpense   Decimal @db.Decimal(18, 2)
  baseClearing  Decimal @db.Decimal(18, 2)

  /// قيدُ إعادة التصنيف — `null` حين تعذّر الترحيل (دليلٌ ناقص) كسائر المستندات.
  journalEntryId String?
  journalEntry   JournalEntry? @relation("NonDeductibleVatEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("NonDeductibleVatEvent_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ `ق-١٣٦٠` حدثُ الإقفال (أو عكسُه أو التسويةُ السنوية) الذي أطلق هذا الحدث — للمشترك وحدَه.
  vatReturnClosingId String?
  vatReturnClosing   VatReturnClosing? @relation(fields: [vatReturnClosingId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  vatReturnClosingTenant VatReturnClosing? @relation("NonDeductibleVatEvent_vatReturnClosingId_tenant", fields: [companyId, vatReturnClosingId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  lines NonDeductibleVatEventLine[]
  /// ⚖️ `ق-١٣٦٤` حصصُ الحدث على الطبقات ومخارجها.
  costShares LayerCostShare[]

  @@index([companyId, purchaseId])
  @@index([vatReturnClosingId])
  @@map("non_deductible_vat_events")
  nonDeductibleVatEventLine_eventId_tenant NonDeductibleVatEventLine[] @relation("NonDeductibleVatEventLine_eventId_tenant")
  layerCostShare_nonDeductibleVatEventId_tenant LayerCostShare[] @relation("LayerCostShare_nonDeductibleVatEventId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// `ق-١٣٤٢` حصّةُ سطرٍ في حدث — موضعُها ومقدارُها بإشارته، وما وقع على الرفّ منها وما ذهب إلى `5100`.
/// «ما وُضع في الموضع حتى الآن» = Σ هذه الصفوف لسطرٍ وموضعٍ وطبقة — ومنه يُحسب فرقُ الحدث التالي.
model NonDeductibleVatEventLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  eventId String
  event   NonDeductibleVatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  eventTenant NonDeductibleVatEvent @relation("NonDeductibleVatEventLine_eventId_tenant", fields: [companyId, eventId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// سطرُ المستند صاحبُ الحصّة (سطرُ الإشعار للإشعار، ولو وقعت حصّتُه على طبقة سطر الأصل). وفارغٌ لمستندٍ بلا
  /// بنود — ضريبتُه كلُّها حصّةٌ واحدة على حساب فئته (`EXPENSE` وحدَه — قيدُ `CHECK`).
  purchaseLineId String?
  purchaseLine   PurchaseLine? @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseLineTenant PurchaseLine? @relation("NonDeductibleVatEventLine_purchaseLineId_tenant", fields: [companyId, purchaseLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  placement NonDeductibleVatPlacement
  /// الطبقةُ حين يكون الموضعُ `LAYER` — وإلا فارغة (قيدُ `CHECK`).
  layerId String?
  layer   InventoryLayer? @relation(fields: [layerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  layerTenant InventoryLayer? @relation("NonDeductibleVatEventLine_layerId_tenant", fields: [companyId, layerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الحصّةُ بإشارتها (موجبٌ: خرجت من `1250` إلى الموضع · سالبٌ: عادت).
  baseAmount    Decimal @db.Decimal(18, 2)
  /// لـ`LAYER`: ما وقع منها على رفّ الطبقة (تكلفتُها) وما وقع على ما خرج منها (مقسوماً على مخارجه في `layer_cost_shares` —
  /// `ق-١٣٦٤`) — `baseInventory + baseCogs = baseAmount`.
  baseInventory Decimal @db.Decimal(18, 2)
  baseCogs      Decimal @db.Decimal(18, 2)

  qtyRemainingAt Decimal? @db.Decimal(18, 3)
  unitCostBefore Decimal? @db.Decimal(18, 6)
  unitCostAfter  Decimal? @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([purchaseLineId])
  @@index([layerId])
  @@map("non_deductible_vat_event_lines")
}

/// ⭐ **`٣٠` إعلانُ الأرصدة الافتتاحية للمخزون** (`ق-١١٧٧` · `ق-١١٧٩`) — رأسٌ لكلِّ إعلان.
///
/// ## ما يحلّه
/// التاجرُ الذي يدخل ببضاعةٍ على رفّه كان يُدخلها **حركةً يدوية**: طبقةُ `ADJUSTMENT` بتاريخ الحركة لا تاريخ
/// الاقتناء (فيبدأ `FIFO` عنده مقلوباً)، وبتكلفةٍ بلا ختمِ مُعلِن، **وبلا قيدٍ على `1300`**. الإعلانُ هنا:
/// سطورٌ حركاتُها `IN` بمصدر `OPENING` وطبقاتُها `OPENING` **بتاريخ اقتناءٍ لكلِّ سطرٍ `≤` تاريخ الافتتاح**،
/// وقيدٌ واحد للإعلان مدين `1300` / دائن `3900` (حسابُ `3.8` نفسُه) مربوطٌ به، خاضعٌ لقفل الفترات.
///
/// ## تاريخٌ واحد للمنشأة (`ق-١١٧٧/④`)
/// `openingDate` هو تاريخُ القيد — كما `3.8`: بدايةُ السنة المالية التي تغطّي اليوم أو تاريخٌ يُعلنه المالك
/// مرّةً؛ **وكلُّ إعلاناتِ المنشأة تحمل التاريخَ نفسَه** (الخدمةُ تردّ `409` على تاريخٍ ثانٍ)، ولا حركةَ مخزونٍ
/// على صنفٍ يُعلَن **قبله** (نظيرُ `assertNoMovementBeforeOpening` في الحسابات).
///
/// ## مختومٌ بمن أعلن ومتى (`ق-١١٧٧/①`)
/// يُقبل بلا سند — فالسندُ شرطُ خصم ضريبة المدخلات لا شرطُ الرصيد (اللائحةُ التنفيذية، مادّةُ الخصم ف٣ وف٧) —
/// ويُختم بالمُعلِن وزمنه، ويُعلَن «بلا سند» في تقرير الافتتاح لكلِّ سطرٍ بلا `evidenceRef`.
///
/// ## مصدرٌ واحد لرصيد `1300` (`ق-١١٧٧/②`)
/// `openingBalance` على حساب المخزون من شاشة الحسابات **مرفوضٌ** — فالرصيدُ الافتتاحيُّ للمخزون يُشتقّ من
/// طبقات الافتتاح وحدَها، وإلا ازدوج المصدران بصمت.
model StockOpening {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// `SO-YYYY-NNNN` من العدّاد الذرّيّ (`ق-٣٢٨`).
  no String

  /// تاريخُ الافتتاح — تاريخُ القيد، واحدٌ لكلِّ إعلانات المنشأة.
  openingDate DateTime @db.Date

  /// الختم: من أعلن (ملفُّه ونوعُه واسمُه لحظةَ الإعلان) — يُخزَّن وقتَ الفعل لا يُحلّ لاحقاً.
  declaredById   String
  declaredByType String
  declaredByName String?

  notes String?

  /// قيدُ الإعلان — مدين `1300` / دائن `3900` — `null` حين تعذّر الترحيل (دليلٌ ناقص) كسائر المستندات.
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("StockOpeningEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("StockOpening_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  lines StockOpeningLine[]

  @@unique([companyId, no])
  @@index([companyId, openingDate])
  @@map("stock_openings")
  stockOpeningLine_openingId_tenant StockOpeningLine[] @relation("StockOpeningLine_openingId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// سطرُ الإعلان — يملك ما أُعلن (الكمّيةُ بوحدة الصنف · تكلفةُ الوحدة الصريحة · تاريخُ الاقتناء · السند)
/// ويشير إلى حركته وطبقته؛ والإلغاءُ عكسٌ لا محو (`voidedAt` وحركةُ عكسٍ وقيدُ عكس)، ويُرفض بعد استهلاك.
model StockOpeningLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  openingId String
  opening   StockOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  openingTenant StockOpening @relation("StockOpeningLine_openingId_tenant", fields: [companyId, openingId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// حركةُ `IN` بمصدر `OPENING` — واحدةٌ لكلِّ سطر.
  movementId String        @unique
  movement   StockMovement @relation("OpeningLineMovement", fields: [movementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  movementTenant StockMovement @relation("StockOpeningLine_movementId_tenant", fields: [companyId, movementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// طبقةُ `OPENING` التي أنشأتها الحركة — واحدةٌ لكلِّ سطر.
  layerId String         @unique
  layer   InventoryLayer @relation("OpeningLineLayer", fields: [layerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  layerTenant InventoryLayer @relation("StockOpeningLine_layerId_tenant", fields: [companyId, layerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  productId   String
  warehouseId String

  qty        Decimal @db.Decimal(18, 3)
  unitCost   Decimal @db.Decimal(18, 6)
  /// `round2(qty × unitCost)` — ما دخل به السطرُ في قيد الإعلان.
  baseAmount Decimal @db.Decimal(18, 2)

  /// تاريخُ الاقتناء المُعلَن — `≤` تاريخ الافتتاح (قيدُ `CHECK` في الهجرة)؛ به يُرتَّب `FIFO`.
  acquiredAt DateTime @db.Date

  /// سندُ التكلفة إن وُجد (رقمُ فاتورةٍ أو مرجع) — وغيابُه يُعلَن «بلا سند» ولا يمنع الإعلان.
  evidenceRef String?

  /// ⚖️ الإلغاءُ عكسٌ لا محو: حركةُ إخراجٍ تُقفل الطبقةَ بعينها، وقيدٌ يعكس نصيبَ السطر من قيد الإعلان.
  voidedAt           DateTime?
  voidMovementId     String?       @unique
  voidMovement       StockMovement? @relation("OpeningLineVoidMovement", fields: [voidMovementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  voidMovementTenant StockMovement? @relation("StockOpeningLine_voidMovementId_tenant", fields: [companyId, voidMovementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  voidJournalEntryId String?       @unique
  voidJournalEntry   JournalEntry? @relation("StockOpeningLineVoidEntry", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  voidJournalEntryTenant JournalEntry? @relation("StockOpeningLine_voidJournalEntryId_tenant", fields: [companyId, voidJournalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([companyId, openingId])
  @@index([productId, warehouseId])
  @@map("stock_opening_lines")
}

/// Catalog item (product or service) used as a reference list when writing
/// invoice line items. Deliberately not a hard FK from InvoiceLine — invoice
/// lines stay free-text (matching the original mockup), this is just the
/// picklist source, not an enforced relationship.
model Product {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Scopes the catalog to one line of business — a restaurant's menu items
  /// shouldn't appear in a pharmacy's product list. Null = shared across all
  /// of the company's activities.
  activityId String?
  activity   BusinessActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  activityTenant BusinessActivity? @relation("Product_activityId_tenant", fields: [companyId, activityId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  name     String
  sku      String?
  category String?
  /// نصٌّ حرٌّ قديم لا يقرؤه أحد — بقي كما هو ولا يُخمَّن منه رمز؛ الوحدةُ الحقيقية `unitCode`.
  unit     String?
  /// ① وحدةُ القياس الأساس مرمَّزةً (UN/ECE Rec 20 من القائمة المغلقة في `common/units/units.ts`).
  /// تُعلَن عند الإنشاء ولا تُفترض؛ والقائمُ بلا وحدةٍ يبقى `null` حتى يُعلنها التاجرُ — لا تخمين (ق-١٠٦٩).
  unitCode String?
  /// ⑧ فئةُ ضريبة القيمة المضافة — **تُعلَن عند الإنشاء ولا تُخمَّن** (كالوحدة)؛ والقائمُ خُتم
  /// `LEGACY_STANDARD` بالهجرة وقيدُ `CHECK` يحبسه على ما سبق لحظتَها. الكاشيرُ والفاتورةُ ينسخانها
  /// إلى السطر لحظةَ البيع ولا يقرآنها من الصنف بعدها (إعادةُ التصنيف لا تغيّر مستنداً صادراً).
  taxCategory TaxCategory
  /// رمزُ سبب الإعفاء من القائمة المغلقة (`common/vat/exemption-reasons.ts`): إلزاميٌّ لـ`Z`/`E`،
  /// `VATEX-SA-OOS` لـ`O`، وممنوعٌ على `S` — والاقترانُ قيدُ `CHECK` في القاعدة لا في العادة.
  taxExemptionReasonCode String?
  /// نصُّ سبب «خارج النطاق» لـ`O` وحدَه (يخرج للهيئة في `cbc:TaxExemptionReason`) — ٣ إلى ٢٥٠ حرفاً بعد
  /// قصّ الأطراف ولا فراغَ (`ق-١٢٢٢`)؛ ولغير `O` يُشتقّ النصُّ العربي للرمز من القائمة عند الإصدار.
  taxExemptionReason String?
  /// ٥+٦ **يُتتبَّع بالدفعة والانتهاء؟** — علَمٌ ثنائيٌّ واحد (`ق-١٠٨١`): لا فصلَ بين الدفعة والانتهاء.
  /// يُعلَن عند الإنشاء ولا يُخمَّن (`ق-١٠٧٦`/١ — كالوحدة)؛ والقائمُ يبقى `null` ويُعدّ حتى يُعلنه التاجرُ عند لمس
  /// الصنف (`ق-١٠٨٣`). المعلَنُ `true` يُصرَف بالأقرب انتهاءً (`FEFO`) ولا يُباع منه المنتهي؛ وغيرُه `FIFO` كما كان.
  expiryTracked Boolean?
  /// Unit price and unit cost, not amounts — see the scale table in
  /// `common/money/rounding.ts`. `cost` is a single static figure today and is
  /// **not** a costing method: it holds no acquisition date and no remaining
  /// quantity, so nothing can be consumed from it. Layered costing replaces
  /// its role later; the column keeps its meaning as "last known unit cost".
  price    Decimal @default(0) @db.Decimal(18, 6)
  cost     Decimal @default(0) @db.Decimal(18, 6)
  minStock Decimal @default(0) @db.Decimal(18, 3)
  barcode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]

  /// Document lines that name this item. All three are `Restrict` on delete:
  /// an item referenced by a posted document is history, and history does not
  /// lose its subject. Archiving stays the way to retire an item.
  invoiceLines  InvoiceLine[]
  quoteLines    QuoteLine[]
  purchaseLines PurchaseLine[]
  inventoryLayers InventoryLayer[]
  stockBatches    StockBatch[]
  writeOffs       InventoryWriteOff[]

  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  @@map("products")
  inventoryWriteOff_productId_tenant InventoryWriteOff[] @relation("InventoryWriteOff_productId_tenant")
  stockBatch_productId_tenant StockBatch[] @relation("StockBatch_productId_tenant")
  inventoryLayer_productId_tenant InventoryLayer[] @relation("InventoryLayer_productId_tenant")
  stockMovement_productId_tenant StockMovement[] @relation("StockMovement_productId_tenant")
  quoteLine_productId_tenant QuoteLine[] @relation("QuoteLine_productId_tenant")
  purchaseLine_productId_tenant PurchaseLine[] @relation("PurchaseLine_productId_tenant")
  invoiceLine_productId_tenant InvoiceLine[] @relation("InvoiceLine_productId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// Basic HR record — deliberately just the employee roster (no GOSI payroll
/// calculator, no job-role/permission linking; both are separate features
/// not built yet).
model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("Employee_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ `ق-١٤٤٥` — **حسابُ الدخول المربوط**: فريدٌ اختياريٌّ **يضبطه المالكُ صراحةً** (`PATCH /employees/:id/login-account`)،
  /// والقائمُ بلا ربطٍ حتى يُربط — **ولا ربطَ بالاسم**. الموظّفُ وحسابُه منفصلان ولا يتغيّر أحدُهما بالآخر صامتاً (`ق-١٤٣٤`).
  companyUserId     String?      @unique
  companyUser       CompanyUser? @relation("EmployeeLoginAccount", fields: [companyUserId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  companyUserTenant CompanyUser? @relation("Employee_companyUserId_tenant", fields: [companyId, companyUserId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  fullName   String
  jobTitle   String?
  department String?
  hireDate   DateTime       @db.Date
  baseSalary Decimal        @default(0) @db.Decimal(18, 2)
  phone      String?
  status     EmployeeStatus @default(ACTIVE)

  /// ⚖️ `ق-١٣٤٥` (الحزمة م①) — **الحقولُ الحسّاسة مشفَّرةٌ في التطبيق من أوّل حقل**: لا عمودَ نصٍّ صريحٍ لها قطّ.
  /// كلُّ قيمةٍ `f1:<معرّفُ المفتاح>:…` يكتبها التطبيقُ مربوطةً بمنشأتها وحقلها وصفّها (`common/crypto/field-cipher.util`)،
  /// والمفاتيحُ خارج القاعدة. **والأسماءُ عامّة** (`ق-١٣٥٠`): التأميناتُ الاجتماعية (`GOSI`) مثالُها السعوديّ.
  nationalIdCipher        String?
  /// بصمةُ البحث برقم الهويّة بمفتاحٍ منفصل (`b1:<معرّفُ المفتاح>:…`) — تكشف التساويَ داخل المنشأة وحدَها ولا تُفكّ.
  nationalIdIndex         String?
  /// رقمُ الحساب الذي يُصرف إليه الراتب (آيبان) — مشفَّراً.
  salaryIbanCipher        String?
  /// رقمُ الاشتراك في التأمينات الاجتماعية — مشفَّراً.
  socialInsuranceNoCipher String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]
  attendance    AttendanceRecord[]


  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  @@map("employees")
  @@index([companyId, nationalIdIndex])
  attendanceRecord_employeeId_tenant AttendanceRecord[] @relation("AttendanceRecord_employeeId_tenant")
  leaveRequest_employeeId_tenant LeaveRequest[] @relation("LeaveRequest_employeeId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// An immutable record of who changed what, and when.
///
/// Written automatically by `AuditInterceptor` on every successful mutating
/// request — not sprinkled through services by hand, which is the only way it
/// can be trusted to be complete. There is deliberately **no update or delete**
/// path anywhere in the app: a tamperable audit trail is worse than none,
/// because it looks like evidence.
/// **بلا أبٍ** — سجلُّ واقعةٍ لا يُحذف بحال (`ق-١١٠`): **ولا مفتاحَ أجنبيّ
/// عمداً** كي لا يُبطله حذفُ ما يشير إليه.
/// ⚠️ **ولا مفتاحَ أجنبيّ إلى المنشأة عمداً** (`ق-٨٠` · `ق-٥٣٥`): حذفُ المنشأة
/// صلبٌ (`Cascade` عبر هويّة الدخول)، **وأثرُ آخر عمليةٍ قبل الحذف كان يُمحى مع
/// الحذف نفسه — أسوأ توقيتٍ ممكن**. وقد بُني بقاءُ سجلّ الدعم (`ق-٥٣١`) قبل
/// هذا، **فكانت قاعدتين حيث أردنا واحدة** (`ق-٢٧٨`). العمودُ `companyId` قائمٌ
/// بلا رابط، والسياسةُ عليه كما هي — **فالسجلُّ يبقى مقروءاً تحت سياق منشأةٍ زالت**.
model AuditLog {
  id        String @id @default(uuid())
  companyId String

  /// COMPANY (owner) or COMPANY_USER (employee).
  actorType String
  actorId   String
  /// Denormalized on purpose: the display name **at the time of the action**.
  /// Resolving it live would rewrite history when an employee is renamed or
  /// deleted, and "who did this" must stay answerable afterwards.
  actorName String

  /// Screen the action belonged to (contracts, invoices, …) and the concrete
  /// action (add/edit/delete/record/review) as enforced by @RequiresAction.
  screen String
  action String

  /// The affected record, when the route identifies one.
  entity   String
  entityId String?

  /// A human-readable Arabic sentence — SPEC 12.2 explicitly wants a readable
  /// change, not raw JSON dumped on the reader.
  summary String
  /// Structured detail for the curious, with secrets stripped. Never the whole
  /// request body verbatim.
  details Json?

  ip        String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// نوعُ الطلب (`ق-٥٤٨` · `ق-٥٥٩`): حذفٌ — أو **إعادةُ فتحٍ** لمنشأةٍ مغلقة — أو **إتلافٌ صريحٌ** لغير
/// الملزِم (حقٌّ منصوص: م٤/٥) — بالمسار نفسِه والأثر نفسِه.
enum AccountRequestKind {
  DELETION
  REOPENING
  ERASURE
}

/// ما وقع بالموافقة (`ق-٥٤٢`): حُذفت (بلا حركة) · أُغلقت (لها حركة) · أُعيد فتحُها · مُحي غيرُ الملزِم.
enum AccountRequestOutcome {
  DELETED
  CLOSED
  REOPENED
  ERASED
}

/// A merchant asking for its account (and all its data) to be deleted.
/// SaaS rule: the merchant never wipes its own database — it files a request,
/// and the platform (support) reviews and executes it. The request itself is
/// the audit trail of that decision, so it survives on the platform side.
/// **بلا أبٍ** — كيانٌ جذريّ يُنشئه التاجر: طلبٌ تراجعه المنصّة وتنفّذه.
/// ⚠️ **ولا مفتاحَ أجنبيّ إلى المنشأة عمداً** (`ق-٥٣٧`): الحذفُ صلبٌ (`Cascade`
/// عبر هويّة الدخول)، **وكان الطلبُ وقرارُه يزولان مع المنشأة نفسِها — فلا أثرَ
/// لمن أذن بإتلاف بياناتها إلا سطرُ تحذيرٍ في سجلّ خادم**. وهو أثقلُ من بقاء
/// سجلّ الدعم (`ق-٥٣١`) والتدقيق (`ق-٥٣٥`): ذانك يشهدان على ما جرى داخل
/// المنشأة، **وهذا يشهد على قرار إعدامها**. فالعمودُ `companyId` قائمٌ بلا رابط،
/// والاسمُ محفوظٌ على الطلب، **ومن قرّر — باسمه ومعرّفه — مكتوبٌ على القرار**.
model AccountDeletionRequest {
  id        String @id @default(uuid())
  companyId String
  /// اسمُ المنشأة وقتَ الطلب — فالصفُّ الذي كان يُقرأ منه يزول مع الحذف.
  companyName String @default("")

  /// Why the merchant is leaving — worth reading before executing.
  reason String?

  kind AccountRequestKind @default(DELETION)

  status DeletionRequestStatus @default(PENDING)
  /// ما وقع بالموافقة — **والحركةُ التي أوجبت الإغلاقَ مكتوبةٌ على القرار** بأسمائها.
  outcome  AccountRequestOutcome?
  movement String[]              @default([])

  /// النسخةُ الكاملة (`ق-٥٥٤`): **تُنتَج قبل أيّ إغلاقٍ أو محو — ولا يُمحى شيءٌ قبل أن ينال
  /// صاحبُه نسختَه**. البيانُ يحمل الملفّاتِ (سنويةً + الأساسية + المختومُ كما هو) بمفاتيحها
  /// وأحجامها وبصماتها، والأجلُ آخرُ يومٍ يُتاح فيه التنزيل.
  archiveManifest   Json?
  archiveProducedAt DateTime?
  archiveExpiresAt  DateTime?

  /// Set when support decides; the note is what gets communicated back.
  decidedAt   DateTime?
  decidedNote String?
  /// من قرّر (مديرُ المنصّة): معرّفُه واسمُه وقتَ القرار — **فجوابُ «من أذن؟» على الصفّ نفسه**.
  decidedById   String?
  decidedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("account_deletion_requests")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A kind of leave a company grants — "سنوية", "مرضية", "بدون راتب". The
/// entitlement is **configurable per company**, never a hardcoded number:
/// statutory day counts differ by contract and change over time, so the owner
/// sets them rather than the code guessing (and guessing wrong is a compliance
/// risk). `annualDays = 0` means "no fixed entitlement" (e.g. unpaid leave),
/// which the balance treats as unlimited rather than zero.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: نوعُ إجازةٍ يضبطه بنفسه.
model LeaveType {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  annualDays Int     @default(0)
  paid       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([companyId, name])
  @@map("leave_types")
  leaveRequest_leaveTypeId_tenant LeaveRequest[] @relation("LeaveRequest_leaveTypeId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// One leave request and its approval state. `days` is stored (inclusive
/// calendar days between start and end) so a report never has to recompute it,
/// and an approver decides on the number they saw. Balance is derived, never
/// stored — same "compute, don't store" rule as unit status and stock.
model LeaveRequest {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  employeeTenant Employee @relation("LeaveRequest_employeeId_tenant", fields: [companyId, employeeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  leaveTypeTenant LeaveType @relation("LeaveRequest_leaveTypeId_tenant", fields: [companyId, leaveTypeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  days      Int
  reason    String?

  /// ⭐ **من قدّم الطلب — بهويّة الفاعل لا بهويّة الموظَّف** (`ق-٦٢١`).
  ///
  /// `employeeId` أعلاه **هو صاحبُ الإجازة، ولا هويّةَ دخولٍ له**: `Employee`
  /// لا يرتبط بـ`LoginIdentity` ولا بـ`CompanyUser` بأيّ حقل. ⇒ **فمقارنةُ
  /// المقرِّر بـ`employeeId` مقارنةُ فضاءَي هويّةٍ مختلفَين ولا تعني شيئاً**،
  /// وهذا الحقلُ هو نظيرُ `recordedById` في الشطب: **الفاعلُ الذي قدّم**.
  ///
  /// ⚠️ **والفارغُ غيرُ مقصود**: صفوفٌ سُجّلت قبل هذا الحقل لا تحمل قائلاً —
  /// **وفراغُها يُقرأ «غيرَ معلوم» فلا يُقارَن**، لا «لا أحد».
  requestedById   String?
  requestedByName String?

  status      LeaveRequestStatus @default(PENDING)
  decidedAt   DateTime?
  decidedNote String?
  /// **ومن قرّر — على الصفّ لا في السجلّ وحده** (`ق-٦٢١`).
  ///
  /// `AuditInterceptor` يكتب المعتمِدَ في كلّ حال، **لكنّ السجلّ لا يُقارَن به
  /// داخل معاملة ولا يُعرَض في شاشة**: «اعتمده فلان» كان يحتاج نبشَ السجلّ
  /// بالمعرّف. ⇒ **فالناقصُ لم يكن الأثر بل الفصل** — وهذان الحقلان هما ما
  /// يُقارِنه الحارس.
  decidedById   String?
  decidedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("leave_requests")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// One employee, one day. Check-in/out are wall-clock strings ("08:05") —
/// the mockup records what the clock on the wall said, and payroll math over
/// minutes is a later feature that can parse them when it exists.
model AttendanceRecord {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  employeeTenant Employee @relation("AttendanceRecord_employeeId_tenant", fields: [companyId, employeeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  date     DateTime         @db.Date
  status   AttendanceStatus @default(PRESENT)
  checkIn  String?
  checkOut String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per employee per day — a second check-in edits, never duplicates.
  @@unique([employeeId, date])
  @@map("attendance_records")
}

/// Bank account for the company. `balance` is the current balance and
/// `openingBalance` the balance it started at. Each `BankTransaction`
/// shifts `balance` by its `amount` (see TransactionsService); editing
/// `openingBalance` later preserves any such drift by shifting `balance` by
/// the same delta instead of overwriting it (see BanksService.update).
model Bank {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Per CLAUDE.md 6.8 each branch has its own cash box — that's modelled by
  /// pointing the Bank/cash account at a branch, not by a separate table.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("Bank_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ ق-١٤٣١ — نوعُ الصفّ عمودٌ صريح: «صندوقٌ نقديّ» (فرعُه مكانُ النقد — النقلُ إغلاقٌ وفتح، ق-١٤١٣) أو «حسابٌ
  /// بنكيّ» (فرعُه بُعدٌ ورؤية — النقلُ للقادم، ق-١٤١٤). **لا يُستنبط** — لا من الفرع ولا من الآيبان. والقائمُ قبل
  /// الهجرة `LEGACY_UNDECLARED` لا يُنقل حتى يُعلَن، **وقيدُ `CHECK` على `createdAt` يحبسها على ما سبق الهجرة**.
  kind BankKind

  name           String
  iban           String?
  balance        Decimal  @default(0) @db.Decimal(18, 2)
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  openingDate    DateTime @db.Date

  currency           String  @default("SAR")
  exchangeRate       Decimal @default(1) @db.Decimal(18, 6)
  baseBalance        Decimal @default(0) @db.Decimal(18, 2)
  baseOpeningBalance Decimal @default(0) @db.Decimal(18, 2)

  /// حسابُ البنك في الدليل — **واحدٌ لواحد** (`ق-٢٥٣` · `ق-٢٧٧`)، يُنشأ مع البنك
  /// برمزٍ في نطاق `1100`–`1199` (`MAX+1` تحت قيدٍ فريد). وبه يُقفل `ق-١٦`:
  /// قبلَه كان نقدُ البنوك يُرحَّل إلى `1000` فيُعدّ صندوقاً، ورصيدُ البنك يعيش
  /// في عمودٍ خارج الأستاذ.
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])

  /// التسويةُ البنكية (ق-١٢٦١ ج): كشفُ البنك مُسوّى حتى هذا التاريخ — لا قيدَ على حسابه بتاريخٍ ≤ له (حارسٌ في createJournalEntry).
  reconciledUntil DateTime? @db.Date
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  accountTenant Account @relation("Bank_accountId_tenant", fields: [companyId, accountId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions BankTransaction[]
  cashDeposits CashDeposit[]
  networkSettlements NetworkSettlement[]
  rentPayments RentPayment[]


  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  /// ⚖️ **خلفُ الصندوق حين نُقل بين الفروع** (`ق-١٤١٣` · `ق-١٤٣١`): الصندوقُ النقديّ فرعُه مكانُ نقده، فالنقلُ إغلاقٌ وفتح —
  /// يُعدّ ويُغلق (يُؤرشف) في فرعه ويُفتح خلفُه صندوقاً جديداً بحسابٍ جديد في الهدف، **وتاريخُه لا ينتقل**. والحسابُ البنكيّ
  /// ينتقل للقادم وحدَه (`ق-١٤١٤`) فلا خلفَ له. `NoAction` لا `Restrict` — كرابط الدرج: حذفُ المنشأة يحذف الاثنين معاً.
  transferredToId String? @unique
  transferredTo   Bank?   @relation("BankTransfer", fields: [transferredToId], references: [id], onDelete: NoAction)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  transferredToTenant Bank? @relation("Bank_transferredToId_tenant", fields: [companyId, transferredToId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// السلفُ الذي أُغلق وفُتح هذا بدلاً منه — إن وُجد.
  transferredFrom Bank?  @relation("BankTransfer")
  bank_transferredToId_tenant Bank[] @relation("Bank_transferredToId_tenant")

  payments         Payment[]
  supplierPayments SupplierPayment[]

  @@map("banks")
  rentPayment_bankId_tenant RentPayment[] @relation("RentPayment_bankId_tenant")
  supplierPayment_bankId_tenant SupplierPayment[] @relation("SupplierPayment_bankId_tenant")
  payment_bankId_tenant Payment[] @relation("Payment_bankId_tenant")
  bankTransaction_bankId_tenant BankTransaction[] @relation("BankTransaction_bankId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
  cashDeposit_bankId_tenant CashDeposit[] @relation("CashDeposit_bankId_tenant")
  networkSettlement_bankId_tenant NetworkSettlement[] @relation("NetworkSettlement_bankId_tenant")
}

/// A manual bank transaction (deposit/withdrawal). `matched`/`entryNo` mirror
/// the mockup's journal-reconciliation fields — a manually-created transaction
/// is always unmatched, but RentPayment sets both when a rent payment is
/// collected via bank transfer (see ContractsService), since that's a real
/// cash movement that's also posted to the Journal.
model BankTransaction {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank @relation("BankTransaction_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("BankTransaction_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  date        DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(18, 2)
  source      String?
  matched     Boolean  @default(false)
  entryNo     String?
  /// المطابقةُ (ق-١٢٦١ ج): سطرُ الدفتر الذي يقابل سطرَ الكشف — واحدٌ لواحد؛ وعمودان لا يُكتبان إلا من التسوية.
  matchedLineId String?      @unique
  matchedLine   JournalLine? @relation("StatementMatch", fields: [matchedLineId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  matchedLineTenant JournalLine? @relation("BankTransaction_matchedLineId_tenant", fields: [companyId, matchedLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  matchedAt     DateTime?
  cashDepositConfirmed CashDeposit? @relation("CashDepositConfirmation")

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_transactions")
  cashDeposit_confirmedTransactionId_tenant CashDeposit[] @relation("CashDeposit_confirmedTransactionId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A posted double-entry journal entry — `no` numbering, balance
/// (totalDebit === totalCredit) and account-balance effects follow the
/// original mockup exactly (see JournalPostingService). `auto` distinguishes
/// system-generated entries (from issuing/editing an invoice or purchase)
/// from ones a user built by hand in the Journal screen; both are deleted
/// the same way (reverse the balance effect, then delete), but an entry
/// still referenced by an Invoice/Purchase can't be deleted directly (see
/// Invoice.journalEntryId) — un-link it by deleting/re-editing that invoice
/// or purchase instead.
///
/// There is no "edit a posted entry" — matches the mockup (delete + repost
/// is how a correction is made) and avoids a whole class of balance-drift
/// bugs from partial edits.
model JournalEntry {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("JournalEntry_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  no          String
  date        DateTime @db.Date
  memo        String
  totalDebit  Decimal  @db.Decimal(18, 2)
  totalCredit Decimal  @db.Decimal(18, 2)
  auto        Boolean  @default(false)

  currency        String  @default("SAR")
  exchangeRate    Decimal @default(1) @db.Decimal(18, 6)
  baseTotalDebit  Decimal @db.Decimal(18, 2)
  baseTotalCredit Decimal @db.Decimal(18, 2)

  /// Set when this entry *is* an account's opening entry (or a delta entry
  /// from editing that account's opening balance): the قيد افتتاحي posted
  /// against the 3900 opening-balances equity account. Identifies opening
  /// entries precisely — for delta computation, for reversal when the account
  /// is deleted, and for the idempotent backfill — instead of matching memos.
  /// Restrict (not SetNull): the marker must never silently detach; the
  /// account-delete path explicitly reverses these entries first.
  openingForAccountId String?
  openingForAccount   Account? @relation("OpeningEntries", fields: [openingForAccountId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  openingForAccountTenant Account? @relation("JournalEntry_openingForAccountId_tenant", fields: [companyId, openingForAccountId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ **القيدُ المرحَّل يُعكس ولا يُحذف** (`ق-١٢٥٣`/①): القيدُ العكسيُّ يحمل معرّفَ
  /// أصله، والأصلُ يبقى برقمه وسطوره — فلا محوَ ولا فجوةَ ترقيم. **واحدٌ لكلِّ أصل**
  /// (`@unique`)، والعكسُ لا يُعكس (يُعاد الأصلُ قيداً جديداً). `Restrict`: لا يُحذف
  /// أصلٌ عُكس — والحذفُ أصلاً ممنوعٌ من الواجهة.
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  reversalOfTenant JournalEntry? @relation("JournalEntry_reversalOfId_tenant", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy   JournalEntry? @relation("EntryReversal")

  /// ⚖️ **قيدُ إقفال سنةٍ مالية** (`ق-١٢٨٣` · د/③): يسِم القيدَ بالسنة التي يُقفلها،
  /// فمنه يُعرف «أمقفلةٌ هي؟» — قيدُ إقفالٍ لم يُعكس بعد. **وبه وحدَه يُسمح بالترحيل
  /// داخل فترةٍ مقفلة**: الإقفالُ يقع **لأنها أُقفلت** لا رغم ذلك. والعكسُ يحمله كذلك
  /// كي يمرّ من الباب نفسِه، ويُميَّز عن الأصل بأنه يحمل `reversalOfId`.
  /// `Restrict`: لا تُحذف سنةٌ لها قيدُ إقفال.
  closingForFiscalYearId String?
  closingForFiscalYear   FiscalYear? @relation("YearClosingEntries", fields: [closingForFiscalYearId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  closingForFiscalYearTenant FiscalYear? @relation("JournalEntry_closingForFiscalYearId_tenant", fields: [companyId, closingForFiscalYearId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  lines        JournalLine[]
  invoices     Invoice[]
  /// المردوداتُ التي يعكس هذا القيدُ قيودَها عند الإغلاق (`ق-٩٦٥`).
  reversedInvoices Invoice[] @relation("InvoiceReversal")
  purchases    Purchase[]
  rentPayments RentPayment[]
  rentAccruals RentAccrual[] @relation("RentAccrualEntry")
  /// A deposit posts twice over its life — once on receipt, once on
  /// settlement — so it needs two named relations, not one.
  depositReceipts     ContractDeposit[] @relation("DepositReceipt")
  depositSettlements  ContractDeposit[] @relation("DepositSettlement")
  contractSettlements Contract[]        @relation("ContractSettlement")
  claimIssues         ContractClaim[]   @relation("ClaimIssue")
  claimSettlements    ContractClaim[]   @relation("ClaimSettlement")
  keyMoneyEntries     ContractKeyMoney[] @relation("KeyMoney")
  maintenanceCosts    MaintenanceRequest[] @relation("MaintenanceCost")
  inventoryWriteOffs  InventoryWriteOff[]  @relation("InventoryWriteOffEntry")
  /// ق-١٣٦٣ — قيودُ الحركات اليدوية (فروقاتُ المخزون ⇄ 1300).
  manualStockMovements StockMovement[]     @relation("ManualStockEntry")
  goodsReceipts       GoodsReceipt[]       @relation("GoodsReceiptEntry")
  landedCosts         LandedCostDistribution[] @relation("LandedCostEntry")
  landedCostVoids     LandedCostDistribution[] @relation("LandedCostVoidEntry")
  nonDeductibleVatEvents NonDeductibleVatEvent[] @relation("NonDeductibleVatEntry")
  cashDeposits        CashDeposit[]            @relation("CashDepositEntry")
  cashDepositVoids    CashDeposit[]            @relation("CashDepositVoidEntry")
  networkSettlements  NetworkSettlement[]      @relation("NetworkSettlementEntry")
  networkSettlementVoids NetworkSettlement[]   @relation("NetworkSettlementVoidEntry")
  stockOpening        StockOpening?            @relation("StockOpeningEntry")
  stockOpeningLineVoid StockOpeningLine?       @relation("StockOpeningLineVoidEntry")

  payments         Payment[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, no])
  @@index([openingForAccountId])
  @@map("journal_entries")
  inventoryWriteOff_journalEntryId_tenant InventoryWriteOff[] @relation("InventoryWriteOff_journalEntryId_tenant")
  stockMovement_journalEntryId_tenant StockMovement[] @relation("StockMovement_journalEntryId_tenant")
  rentAccrual_journalEntryId_tenant RentAccrual[] @relation("RentAccrual_journalEntryId_tenant")
  rentPayment_journalEntryId_tenant RentPayment[] @relation("RentPayment_journalEntryId_tenant")
  supplierPayment_journalEntryId_tenant SupplierPayment[] @relation("SupplierPayment_journalEntryId_tenant")
  payment_journalEntryId_tenant Payment[] @relation("Payment_journalEntryId_tenant")
  contract_settlementEntryId_tenant Contract[] @relation("Contract_settlementEntryId_tenant")
  contractDeposit_settlementEntryId_tenant ContractDeposit[] @relation("ContractDeposit_settlementEntryId_tenant")
  contractDeposit_journalEntryId_tenant ContractDeposit[] @relation("ContractDeposit_journalEntryId_tenant")
  contractClaim_settlementEntryId_tenant ContractClaim[] @relation("ContractClaim_settlementEntryId_tenant")
  contractClaim_journalEntryId_tenant ContractClaim[] @relation("ContractClaim_journalEntryId_tenant")
  contractKeyMoney_journalEntryId_tenant ContractKeyMoney[] @relation("ContractKeyMoney_journalEntryId_tenant")
  maintenanceRequest_journalEntryId_tenant MaintenanceRequest[] @relation("MaintenanceRequest_journalEntryId_tenant")
  journalLine_journalEntryId_tenant JournalLine[] @relation("JournalLine_journalEntryId_tenant")
  journalEntry_reversalOfId_tenant JournalEntry[] @relation("JournalEntry_reversalOfId_tenant")
  stockOpeningLine_voidJournalEntryId_tenant StockOpeningLine[] @relation("StockOpeningLine_voidJournalEntryId_tenant")
  stockOpening_journalEntryId_tenant StockOpening[] @relation("StockOpening_journalEntryId_tenant")
  landedCostDistribution_voidJournalEntryId_tenant LandedCostDistribution[] @relation("LandedCostDistribution_voidJournalEntryId_tenant")
  landedCostDistribution_journalEntryId_tenant LandedCostDistribution[] @relation("LandedCostDistribution_journalEntryId_tenant")
  nonDeductibleVatEvent_journalEntryId_tenant NonDeductibleVatEvent[] @relation("NonDeductibleVatEvent_journalEntryId_tenant")
  goodsReceipt_journalEntryId_tenant GoodsReceipt[] @relation("GoodsReceipt_journalEntryId_tenant")
  purchase_journalEntryId_tenant Purchase[] @relation("Purchase_journalEntryId_tenant")
  invoice_journalEntryId_tenant Invoice[] @relation("Invoice_journalEntryId_tenant")
  invoice_reversalJournalEntryId_tenant Invoice[] @relation("Invoice_reversalJournalEntryId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
  cashDeposit_voidJournalEntryId_tenant CashDeposit[] @relation("CashDeposit_voidJournalEntryId_tenant")
  cashDeposit_journalEntryId_tenant CashDeposit[] @relation("CashDeposit_journalEntryId_tenant")
  networkSettlement_voidJournalEntryId_tenant NetworkSettlement[] @relation("NetworkSettlement_voidJournalEntryId_tenant")
  networkSettlement_journalEntryId_tenant NetworkSettlement[] @relation("NetworkSettlement_journalEntryId_tenant")
}

/// One debit-or-credit line of a JournalEntry. `onDelete: Restrict` on
/// `account` means an Account that has ever been posted to can't be deleted
/// — same FK-restrict pattern used everywhere else in this codebase.
model JournalLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry @relation("JournalLine_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  accountTenant Account @relation("JournalLine_accountId_tenant", fields: [companyId, accountId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  /// ── الأبعاد التحليلية ────────────────────────────────────────────────
  /// **تُشتقّ في `createJournalEntry` وحدها، ولا مدخل يدوي لها إطلاقاً.**
  /// الغرض أن يُقرأ الدفتر بالعقار والوحدة والفرع لا بالحساب وحده — فتُعرف
  /// ربحية وحدةٍ بعينها دون أن يعتمد ذلك على انضباطٍ يُتذكَّر عند كل ترحيل.
  ///
  /// ⚠️ **وكلّها اختيارية بلا قيمة افتراضية** — والفراغ يقول «لا انتماء».
  /// أي افتراضيٍّ هنا (فرعٌ أول، عقارٌ أول) **يكذب**: ينسب قيداً عامّاً إلى
  /// وحدةٍ لم تنشئه، فيلوّث كل تقرير ربحيةٍ بعده بلا أثرٍ يُقتفى.
  ///
  /// ومقيسٌ أن ٧٢٢ سطراً من ٢٢٤٦ (٣٢٪) تشتقّ بُعداً اليوم — وهي **١٠٠٪ من
  /// قيود العقارات**. والباقي (فاتورة · شراء · مقبوض) **لا مصدر لاشتقاقه**:
  /// `Invoice` لا تعرف عقداً ولا وحدة إطلاقاً. وحقلٌ هنا لا يصنع معلومةً
  /// غائبةً في مصدرها — رفعُها بندٌ مسجَّل على `Invoice` نفسها.
  ///
  /// و`Restrict` لا `SetNull`: الدفتر سجلُّ واقعةٍ لا يُعدَّل. و`SetNull` كان
  /// سيحوّل انتماءً حقيقياً إلى «بلا انتماء» صامتاً عند حذف وحدة — وهو
  /// الكذب نفسه الذي يمنعه غيابُ الافتراضي أعلاه. (والحساب على هذا السطر
  /// `Restrict` للسبب عينه.)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("JournalLine_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  propertyTenant Property? @relation("JournalLine_propertyId_tenant", fields: [companyId, propertyId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  unitId String?
  unit   Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  unitTenant Unit? @relation("JournalLine_unitId_tenant", fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ── بُعدُ الطرف (`ق-٨٧٣`) — بحدّه الأدنى ────────────────────────────────
  /// **يُملأ من `resolveDimensions()` لا بيد**: الفاتورةُ والإشعارُ وسندُ القبض ⇒ عميلُها،
  /// الشراءُ وسندُ الصرف ⇒ مورّدُه، وما يتبع عقداً له عميلٌ مسجَّل ⇒ عميلُ العقد — ويُختم على
  /// كل سطر كسائر الأبعاد. لأن `1200`/`2100` مجمَّعان ولا يُعرف لمن ندين، وحصّةُ مالك
  /// العقار تُقيَّد بلا مستندِ شراءٍ تُخصَّص عليه — فسطرُ القيد وحدَه يعرفها.
  /// والفراغُ يقول «لا طرف» (قيدٌ يدويّ · افتتاحيّ · عقدٌ بلا عميل) ولا يُلفَّق افتراضيّ.
  /// `Restrict` كالوحدة: طرفٌ له سطور لا يُحذف.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  customerTenant Customer? @relation("JournalLine_customerId_tenant", fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  statementMatch BankTransaction? @relation("StatementMatch")
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  supplierTenant Supplier? @relation("JournalLine_supplierId_tenant", fields: [companyId, supplierId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, propertyId])
  @@index([companyId, unitId])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
  @@map("journal_lines")
  bankTransaction_matchedLineId_tenant BankTransaction[] @relation("BankTransaction_matchedLineId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A managed real-estate property. Trimmed from the original mockup's
/// richer model: no file attachments (no storage service built yet), no
/// per-floor category overrides (only the property-wide `activityType`/
/// `activitySubtype` lock is enforced — see ContractsService), no shared-area
/// inventory editor, no map screen yet (`lat`/`lng` are captured for when
/// one is built). Deleting a property with units is blocked (`onDelete:
/// Restrict` on Unit.propertyId) — simpler and safer than the mockup, which
/// allows it and leaves the units dangling.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: تشير إليه الوحداتُ ولا يشير إلى أحد.
model Property {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  address String?
  floors  Int     @default(1)

  /// Free string, one of: residential/shop/showroom/office/warehouse/mixed,
  /// or null for "no restriction" — validated in CreatePropertyDto.
  activityType    String?
  /// Only meaningful when activityType === 'residential' — e.g. families-only,
  /// singles-only, students — matches the mockup's residential sub-category.
  activitySubtype String?

  /// 'owned' | 'leased' | 'managed' — validated in CreatePropertyDto.
  ownership String

  /// Only set when ownership === 'leased': the company's own head-lease terms.
  /// Sub-contracts for units in this property must fall within this window.
  leaseValue Decimal?  @db.Decimal(18, 2)
  leaseCycle String?
  leaseStart DateTime? @db.Date
  leaseEnd   DateTime? @db.Date

  /// Only set when ownership === 'managed': the company's commission rate.
  opRate Decimal? @db.Decimal(5, 2)

  deedNo String?
  lat    Float?
  lng    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units       Unit[]
  branches    Branch[]
  maintenance MaintenanceRequest[]
  warranties  Warranty[]


  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  /// أسطر القيود المنسوبة إلى هذا العقار — بُعدٌ تحليلي، انظر JournalLine.
  journalLines JournalLine[]

  @@map("properties")
  warranty_propertyId_tenant Warranty[] @relation("Warranty_propertyId_tenant")
  maintenanceRequest_propertyId_tenant MaintenanceRequest[] @relation("MaintenanceRequest_propertyId_tenant")
  unit_propertyId_tenant Unit[] @relation("Unit_propertyId_tenant")
  journalLine_propertyId_tenant JournalLine[] @relation("JournalLine_propertyId_tenant")
  branch_propertyId_tenant Branch[] @relation("Branch_propertyId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A leasable unit within a Property. `type`/`subtype` mirror the mockup's
/// UNIT_TYPE_CONFIG (residential has a fixed category select; commercial
/// types take a free-text allowed-activity description) but are both plain
/// strings here, validated client-side only — same trim as Account.type.
/// Status (vacant/rented/reserved/under maintenance) is never stored; it's
/// always derived live from `underMaintenance` + whether an active Contract
/// currently covers today (see UnitsService.withStatus).
model Unit {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  propertyTenant Property @relation("Unit_propertyId_tenant", fields: [companyId, propertyId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  unitNo           String
  floor            String?
  type             String
  subtype          String?
  rentMonthly      Decimal @db.Decimal(18, 2)
  underMaintenance Boolean @default(false)
  /// وصف تفصيلي للغرف والمحتويات (نص حر) — يظهر في بطاقة الوحدة والنماذج.
  roomDetails      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts    Contract[]
  reservations Reservation[]
  maintenance  MaintenanceRequest[]
  warranties   Warranty[]

  @@unique([companyId, propertyId, unitNo])

  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  /// أسطر القيود المنسوبة إلى هذه الوحدة — بُعدٌ تحليلي، انظر JournalLine.
  journalLines JournalLine[]

  @@map("units")
  contract_unitId_tenant Contract[] @relation("Contract_unitId_tenant")
  warranty_unitId_tenant Warranty[] @relation("Warranty_unitId_tenant")
  maintenanceRequest_unitId_tenant MaintenanceRequest[] @relation("MaintenanceRequest_unitId_tenant")
  reservation_unitId_tenant Reservation[] @relation("Reservation_unitId_tenant")
  journalLine_unitId_tenant JournalLine[] @relation("JournalLine_unitId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
}

/// A pre-contract holding on a Unit — matches the mockup's lightweight
/// reservation mechanism exactly: no financial posting for the deposit
/// (purely a record, same gap as the mockup), no due-date reminders.
/// `expiryDate` lazily flips ACTIVE -> EXPIRED on read (`ReservationsService`),
/// never via a background job. Converting to a contract (same unit, matching
/// tenant name) flips it to CONVERTED instead — see ContractsService.create.
model Reservation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  unitTenant Unit @relation("Reservation_unitId_tenant", fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  name       String
  phone      String?
  deposit    Decimal           @default(0) @db.Decimal(18, 2)
  expiryDate DateTime          @db.Date
  status     ReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservations")
}

enum ContractStatus {
  DRAFT
  /// Signed and confirmed, but its term hasn't started yet — the state a
  /// renewal sits in between agreement and the old lease expiring. Distinct
  /// from DRAFT: a draft may never happen, an upcoming contract will.
  UPCOMING
  DUE
  LATE
  CANCELLED
}

/// ⭐ **تصنيفُ العقد للضريبة — على العقد لا العقار ولا الوحدة** (`ق-٨٩١`):
/// العقارُ المختلط يحمل الاثنين، والوحدةُ نصٌّ حرٌّ قبل الخادمُ فيه أيَّ كلمة،
/// **والعقدُ هو الواقعةُ الخاضعة — فالضريبةُ على التوريد لا على المبنى**.
///
/// **ولا يُستنبَط من نصّ**: كانت هنا خريطةُ كلماتٍ خمس تحوّل `Unit.type` إلى
/// تصنيفٍ **وتتخطّى ما لا تعرفه صامتةً** — فحُذفت (`ق-٨٩٨`)، وحارسٌ يُسقط
/// الحزمة على عودتها.
///
/// `LEGACY_UNCLASSIFIED` **للصفوف التي سبقت الهجرة وحدَها** — حالٌ معلَنة تُعدّ
/// لا افتراضٌ صامت؛ والقاعدةُ تحبسها على ما سبق لحظةَ الهجرة بقيد `CHECK`
/// على `createdAt`، والخادمُ لا يقبلها لعقدٍ جديد.
enum ContractClassification {
  /// سكنيٌّ — توريدٌ معفىً من ضريبة القيمة المضافة (اللائحة م٣٠/١/ب).
  RESIDENTIAL
  /// تجاريٌّ — توريدٌ خاضع بالنسبة الأساسية.
  COMMERCIAL
  LEGACY_UNCLASSIFIED
  /// ⚖️ إيواءٌ مخدومٌ أو مؤقّت — خاضعٌ كالتجاريّ (السؤال ٥٩ · `ق-١٦٠٠`): الإعفاءُ للمسكن الرئيس الدائم وحدَه، والمعيارُ
  /// طبيعةُ السكن لا التأثيثُ ولا عددُ الأيام (دليلُ العقارات §6.1 ومثال 7).
  SERVICED_LODGING
  /// ⚖️ مختلطٌ — عقدٌ واحدٌ يجمع جزءاً سكنيّاً معفى وجزءاً خاضعاً (السؤال ٤١٢ · `ق-١٦٠٠`): نسبةُ المعفى يعلنها المؤجّرُ بأساسه
  /// (`exemptSharePercent` · `exemptShareBasis`)، ولا مساحةَ إلزامية (دليلُ العقارات §6.2 و§6.3 ومثال 9).
  MIXED
}

/// ⑧ فئةُ ضريبة القيمة المضافة على الصنف وعلى سطر المستند (`ق-١٢١١` · `ق-١٢١٢` · `ق-١٢٢٣`) —
/// رموزُ الهيئة الأربعة من قائمة UN/CEFACT 5305 كما يقيّدها معيارُ XML §11.2.4 (`S` · `Z` · `E` · `O`)،
/// **وقيمتان قديمتان صريحتان** لا افتراضَ صامتاً فيهما:
/// · `LEGACY_STANDARD` — صنفٌ كان يُرَنّ بالنسبة الأساسية قبل أن يوجد الحقل ولم يُعلن التاجرُ فئتَه بعد؛
///   قيدُ `CHECK` على `createdAt` يحبسه على ما سبق لحظةَ الهجرة، وسطرٌ يُباع منه يرثه كما هو
///   (استمرارٌ لا تصحيح) ويُعدّ في الإقرار «بيعٌ بقيمةٍ قديمة».
/// · `LEGACY_ZERO` — سطرٌ قائم كُتب بصفرٍ ولا يُعرف أزيروٌ هو أم معفىً أم خارج النطاق: يُعدّ ويُعلَن
///   في الإقرار ولا يُنسب إلى خانة (أوّلُ صفٍّ يقول «لا أعرف» بدل أن يختار)؛ محبوسٌ على ما سبق الهجرة.
/// النسبةُ **مشتقّةٌ** من الفئة (`common/vat/standard-rate.ts` مصدراً واحداً)، والسببُ من القائمة المغلقة
/// (`common/vat/exemption-reasons.ts`) إلزاميٌّ لـ`Z`/`E`، و`VATEX-SA-OOS` بنصٍّ حرٍّ مقيَّدٍ لـ`O`.
enum TaxCategory {
  S
  Z
  E
  O
  LEGACY_STANDARD
  LEGACY_ZERO
}

/// هل `Contract.value` شاملٌ لضريبة القيمة المضافة أم غيرُ شامل (`ق-٨٩٢`) —
/// **يُعلَن ولا يُفترض في الحالين**؛ و`LEGACY_UNDECLARED` لما سبق الهجرة وحدَه،
/// محبوسٌ بالقيد نفسِه.
enum ContractVatInclusion {
  INCLUSIVE
  EXCLUSIVE
  LEGACY_UNDECLARED
}

/// ⚖️ **من المؤجّرُ في عقد الإيجار** (السؤال ٥٧٧ · `ق-١٦٠٠` · `ق-١٦٠٩`/أ) — الفيصلُ عند الهيئة في من يورّد الإيجار.
/// يُعلَن ولا يُفترض على عقار التشغيل؛ وعلى المملوك والمستأجَر رئيساً المؤجّرُ المنشأةُ واقعةً لا افتراضاً.
enum ContractLessor {
  /// المنشأةُ نفسُها (مالكةٌ أو مستأجرةٌ رئيساً أو مشغّلٌ وقّع مؤجّراً): الإيجارُ إيرادُها وضريبةُ التجاريّ عليها.
  COMPANY
  /// مالكُ العقار، والمنشأةُ وكيلٌ معلَن يحصّل عنه بعمولة: الإيجارُ أمانةٌ له (`2500`) لا إيراد، ويخرج من
  /// إقرار المنشأة، والعمولةُ إيرادُها (`4250`) بضريبة ١٥٪ دائماً.
  OWNER
  /// عقدٌ على عقار تشغيلٍ سبق الحقل: لا معاملةَ له حتى يُعلَن من بطاقة العقد، ويُعدّ. محبوسٌ بقيد `CHECK`
  /// على `createdAt` كقيد التصنيف (`ق-٨٩٨`).
  LEGACY_UNDECLARED
}

enum InstallmentStatus {
  DUE
  LATE
  /// سُدِّد بعضُه — تُشتقّ من المقبوض مقابل الإجماليّ بالضريبة (كما الفاتورة)، ويكتبها مسارُ القبض وحده (ق-١٠٤٠).
  PARTIAL
  PAID
  CANCELLED
}

/// **أساسُ القسط في الدفتر** (`ق-٩٢٧/٢`): `ACCRUAL` = يُستحقّ ذمّةً عند نقطة ضريبته
/// (`1200` ⇄ `2400`/`4200` + `2200`) والقبضُ يسدّدها؛ `LEGACY_COLLECTED` = سبقت نقطةُ
/// ضريبته لحظةَ البناء فيبقى على مسار القبض القائم (نقدٌ ⇄ `4200`/`2400`) **ويُحسب في
/// الإقرار ولا يُرحَّل رجعياً** — «ما سبق اللحظةَ: في الإقرار لا في الدفتر» (`ق-٩٢٦`).
/// القيمةُ القديمة محبوسةٌ بقيد `CHECK` على `createdAt` كقيد التصنيف (`ق-٨٩٨`).
enum InstallmentAccrualBasis {
  ACCRUAL
  LEGACY_COLLECTED
}

/// نوعُ صفّ الاستحقاق — **ما الذي أنشأ نقطةَ الضريبة** (`ق-٩٢٤` · `ق-٩٢٧/١`).
enum RentAccrualKind {
  /// حلّ الاستحقاقُ (`dueDate`) — الباقي غيرُ المستحقّ من القسط.
  DUE
  /// دفعةٌ قبل الاستحقاق — بقدرها بتاريخها (م٢٠/٢).
  PREPAYMENT
  /// دفعةٌ بلا قسطٍ مرتبط — بقدرها بتاريخها؛ لا فترةَ خدمةٍ لها فتُعترَف فوراً. **ما قبل `ق-١٦٢٤` وحدَه**: لا يُكتب بعده.
  UNLINKED
  /// عكسُ استحقاقٍ أُسقط عند الإلغاء — نظيرُ الإشعار الدائن (مبالغُه سالبة).
  REVERSAL
  /// خصمٌ عند القبض — تعديلُ مقابلٍ يُنقص الذمّةَ والصافيَ والضريبة (مبالغُه سالبة).
  DISCOUNT
  /// ⚖️ ما زاد على أقساط العقد كلِّها (توجيه ٢٧٧ · `ق-١٦٢٤`، بحكم صاحب المشروع: «ليس إيراداً، بل رصيدٌ للمستأجر يُخصم من القادم أو
  /// يُردّ إليه، كما في `ق-١٢٦٤`»): مقدَّمٌ بقدره بتاريخه، أصلُه في `2450` لا إيراد، وضريبتُه بفئة العقد يومَ القبض (م٢٠).
  TENANT_CREDIT
  /// ⚖️ **نقلُ رصيد المستأجر إلى أوّل قسطٍ في التجديد** (توجيه ٢٧٨ · `ق-١٦٢٩`): صفّان بتاريخٍ واحد، سالبٌ على العقد الأصل بلا قسط وموجبٌ
  /// على القسط، فيتعادلان في الإقرار (الضريبةُ استُحقّت يومَ القبض، م٢٠)، ويحمل الموجبُ ضريبتَه كي لا تُستحقّ ثانيةً عند حلول القسط.
  CREDIT_TRANSFER
}

enum PaymentMethod {
  CASH
  BANK

  /// ⭐ **الشبكة** (`ق-٣٢٠`) — لا «بطاقة»: هي ما يقوله التاجرُ السعوديّ.
  ///
  /// **وحسابُها `1251` «مدينو شبكة المدفوعات»** — لا `1000` ولا حسابُ بنك:
  /// المبلغُ **ذمّةٌ على البنك المستحوذ** حتى يُحوَّل، لا نقدٌ في يد التاجر.
  ///
  /// ⚠️ **ولا نوعَ ثالثاً لم يطلبه أحد**: التقسيطُ والتأمينُ والمنصّاتُ
  /// **تنتظر قياس `ق-٣١٩`** — فقد تحتاج حساباتٍ لا أنواعاً.
  CARD
}

/// A lease contract for a Unit. Trimmed from the mockup: no occupants list,
/// no business-registration sub-fields, no file attachment, no key-money/
/// deposit-settlement/tenant-rating records yet (planned as a follow-up
/// increment). `customerId` is set automatically on create — mirrors the
/// mockup's `syncTenantToCustomer`, but as a real FK to the existing Customer
/// model instead of a loose name match.
/// How the reminder actually reached the tenant. Recorded because "we told
/// them" is the first thing disputed when rent goes unpaid — and because no
/// messaging provider is wired up yet, so the channel is whatever the user
/// really used after copying the text.
enum ReminderChannel {
  WHATSAPP
  SMS
  CALL
  EMAIL
  OTHER
}

/// When the company wants tenants chased. One row per company.
///
/// ⚠️ Nothing here sends anything by itself: the platform computes *who is due
/// a reminder today* and renders the message, and a human sends it. Claiming
/// automatic delivery without a provider behind it would be a lie the tenant
/// pays for.
model ReminderPolicy {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)
  /// Days before the due date to send the courtesy reminder. 0 = on the day.
  daysBefore Int @default(3)
  /// How often to chase again once an instalment is overdue. Stops the same
  /// tenant being messaged daily.
  repeatEveryDays Int @default(7)

  /// Arrears older than this many days stop being the collector's problem and
  /// become the manager's. Null = escalation off; a company that never wants a
  /// second pair of eyes shouldn't be forced into one.
  escalateAfterDays Int?
  /// Who the escalation lands on. Null = the account owner, which is the only
  /// recipient guaranteed to exist.
  escalateToUserId String?
  escalateTo       CompanyUser? @relation("EscalationRecipient", fields: [escalateToUserId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  escalateToTenant CompanyUser? @relation("ReminderPolicy_escalateToUserId_tenant", fields: [companyId, escalateToUserId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reminder_policies")
}

/// One reminder, actually sent. Also what stops the queue re-offering the same
/// instalment tomorrow.
model RentReminder {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  installmentTenant Installment @relation("RentReminder_installmentId_tenant", fields: [companyId, installmentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  channel ReminderChannel
  /// The text as it went out — templates change, and a record of what was
  /// actually said is what matters later.
  message String
  sentAt  DateTime @default(now())

  @@map("rent_reminders")
}

/// What the notification is about. The kind — not a free-text title — is what
/// lets the UI route the user to the right screen and what makes a dedupe key
/// meaningful.
enum NotificationKind {
  /// Arrears older than the company's threshold, raised to the manager.
  RENT_ESCALATION
  /// Cover about to lapse on something still installed and still failing.
  WARRANTY_EXPIRING
  /// إشعارٌ صدر بعد مهلته النظامية (١٥ يوماً من نهاية شهر الواقعة، م٥٤).
  /// **تنبيهٌ لا حجز**: المستند يوجبه النظام، فمنعُه يزيد المخالفة لا يمنعها —
  /// فيُصدَر ويُسجَّل التأخّر ليراه المالك، لا ليُمنع التاجر.
  NOTE_ISSUED_LATE
  /// الدعمُ الفنيّ يطلب الدخولَ — القرارُ للمالك (`ق-٥٣٠`): **من لا يعلم لا
  /// يتحقّق** (النظام م٨: على جهة التحكم التحقّقُ من التزام جهة المعالجة).
  SUPPORT_REQUESTED
  /// الدعمُ دخل فعلاً أوّلَ مرّةٍ تحت إذنٍ فعّال — مرّةً لكل إذن.
  SUPPORT_ENTERED
  /// قائمةُ المعالجين الفرعيين تغيّرت وتلزم موافقةُ التاجر (`ق-٥٨٩`) — **تذكيرٌ متكرّرٌ
  /// لا إشعارٌ واحد**: عند النشر، وقبل السريان بأربعةَ عشرَ يوماً وبسبعةٍ وبيوم، ثم أسبوعياً.
  SUBPROCESSOR_CONSENT
  /// شهادةُ الفوترة الإلكترونية تقترب من انتهائها — وبعدها تُرفض كلُّ الفواتير (ز/⑤A1).
  ZATCA_CERT_EXPIRING
  /// دفعُ بطاقةٍ لم يمرّ بالمزوّد (رقمُ مرجع الجهاز · حسمٌ يدويّ) ولم تطالب به تسويةُ الشبكة بعد مهلتها —
  /// **يُرفع للمراجعة باسم الكاشير** (`ق-١٣٩٧`/٣ · `ق-١٣٩٩`).
  POS_CARD_UNMATCHED
}

/// An in-system notification. Deliberately a *stored* row rather than something
/// computed on read like the reminder queue: a notification has to survive
/// being ignored, carry who has seen it, and still be there tomorrow. The
/// collection queue answers "who do I chase today"; this answers "what did the
/// system need to tell someone, and did they look".
///
/// ⚠️ Still no email or SMS behind it — this is delivery *inside* the platform
/// only. A manager who never opens the app never sees it.
model Notification {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// Null = the account owner. Company users see only what is addressed to
  /// them; the owner sees everything in the company.
  targetUserId String?
  targetUser   CompanyUser? @relation("NotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  targetUserTenant CompanyUser? @relation("Notification_targetUserId_tenant", fields: [companyId, targetUserId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  title String
  body  String

  /// Where the notification points. Kept as screen + id rather than a URL so a
  /// route rename doesn't strand every old notification.
  linkScreen String?
  linkId     String?

  /// What makes the daily job safe to run twice — and safe to run on several
  /// instances at once. The unique index is the guarantee, not the code that
  /// checks before inserting.
  dedupeKey String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, dedupeKey])
  @@index([companyId, readAt])
  @@map("notifications")
}

/// How fast the request needs attention. Urgent is not a mood — a burst pipe
/// or a failed lift is a habitability and liability issue, so it is ranked
/// separately rather than left to a free-text note.
enum MaintenancePriority {
  URGENT
  HIGH
  NORMAL
}

/// The life of a maintenance request, from the tenant's phone call to the
/// landlord signing it off.
///
/// `DONE` and `CLOSED` are deliberately distinct: the contractor says the work
/// is finished, and the landlord (or tenant) confirms it actually is. Collapsing
/// them would lose exactly the step where disputes surface.
enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  DONE
  CLOSED
  CANCELLED
}

/// A maintenance request against a property, and optionally one unit of it.
///
/// Not tied to a contract: a fault in a vacant unit, or in the building's
/// shared areas, still has to be tracked — and tying it to a tenancy would make
/// those invisible.
model MaintenanceRequest {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  propertyTenant Property @relation("MaintenanceRequest_propertyId_tenant", fields: [companyId, propertyId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  unitTenant Unit? @relation("MaintenanceRequest_unitId_tenant", fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  title       String
  description String?
  priority    MaintenancePriority @default(NORMAL)
  status      MaintenanceStatus   @default(REPORTED)

  /// Free text: often the tenant, sometimes a passer-by or a caretaker.
  reportedBy String?
  reportedAt DateTime @db.Date

  /// Who is doing the work — an employee or an outside contractor, so free text
  /// rather than a foreign key.
  assignedTo String?

  startedAt   DateTime? @db.Date
  completedAt DateTime? @db.Date
  closedAt    DateTime? @db.Date
  /// Why it was dropped, when it was — a cancelled request with no reason is
  /// indistinguishable from one that was forgotten.
  cancelReason String?

  /// What the work cost the landlord. Recorded at completion and posted then,
  /// because that is when the obligation is known.
  cost         Decimal? @db.Decimal(18, 2)
  currency     String   @default("SAR")
  exchangeRate Decimal  @default(1) @db.Decimal(18, 6)
  baseCost     Decimal? @db.Decimal(18, 2)

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("MaintenanceCost", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("MaintenanceRequest_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// The warranty this job was claimed under, if any.
  ///
  /// Recorded on the request rather than inferred from dates at read time: a
  /// job *could have been* covered and a job that *was* claimed are different
  /// facts, and only the second is a defence when the provider argues later.
  warrantyId String?
  warranty   Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  warrantyTenant Warranty? @relation("MaintenanceRequest_warrantyId_tenant", fields: [companyId, warrantyId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_requests")
}

/// A warranty on something installed in a property — a lift, a chiller, the
/// waterproofing a contractor did last spring.
///
/// The reason this exists is not record-keeping. It is that the landlord pays
/// for repairs they were already owed: a warranty nobody remembers at the
/// moment the fault is reported is money handed to a contractor twice. So the
/// coverage window and the location are structured columns — they have to be
/// queryable *when a maintenance request is opened*, not filed in a notes
/// field somebody reads afterwards.
model Warranty {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// What is covered — "مصعد المبنى الرئيسي", "مكيّفات الدور الثاني".
  subject String

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  propertyTenant Property @relation("Warranty_propertyId_tenant", fields: [companyId, propertyId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Null = covers the whole property. A building's lift belongs to the
  /// building; a flat's air conditioner belongs to the flat.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  unitTenant Unit? @relation("Warranty_unitId_tenant", fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Who honours it. Free text as well as an optional supplier link: the
  /// manufacturer behind a warranty is often not the supplier who invoiced it.
  provider   String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  supplierTenant Supplier? @relation("Warranty_supplierId_tenant", fields: [companyId, supplierId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  startDate DateTime @db.Date
  /// When cover ends. Required — a warranty with no end date is a claim nobody
  /// can check, and it is precisely the end date that makes this useful.
  endDate DateTime @db.Date

  /// Invoice or contract number the cover derives from — the first thing a
  /// provider asks for.
  reference String?
  /// What is actually covered and what is excluded, in the company's words.
  terms String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Jobs claimed against this warranty — the evidence it was used.
  claims MaintenanceRequest[]

  @@index([companyId, endDate])
  @@map("warranties")
  maintenanceRequest_warrantyId_tenant MaintenanceRequest[] @relation("MaintenanceRequest_warrantyId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

enum HandoverType {
  /// تسليم — handing the unit over to the tenant at the start.
  DELIVERY
  /// استلام — taking it back at the end.
  RECEIPT
}

enum HandoverStatus {
  /// Still being filled in; items and readings can change.
  DRAFT
  /// Signed by both parties. Frozen: the whole point of the form is that its
  /// state at handover cannot be revised after the fact.
  SIGNED
}

enum ItemCondition {
  GOOD
  FAIR
  DAMAGED
  MISSING
}

/// The condition-of-unit form exchanged at the start and end of a tenancy.
///
/// Its entire value is being **unarguable later**: when a deposit deduction is
/// disputed, this is the document that decides it. So a signed form is
/// immutable, and the signing time comes from the server clock — a
/// client-supplied timestamp on a document meant to settle disputes is worth
/// nothing.
model ContractHandover {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractHandover_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  type   HandoverType
  status HandoverStatus @default(DRAFT)
  date   DateTime       @db.Date

  /// Meter readings are the most commonly disputed numbers of all, so they get
  /// their own fields rather than living in the notes.
  electricityMeter String?
  waterMeter       String?
  notes            String?

  /// Set together, by the server, at the moment of signing.
  signedAt DateTime?
  signedBy String?

  /// ⚖️ إعلامُ المستأجر بحفظ الصور (`ق-١٦٠٠` · السؤال ٢٤٣): نموذجٌ عليه صورٌ لا يُوقَّع إلا بإقرار الموقِّع أن المستأجرَ
  /// أُعلم بمدّة حفظها، فتُختم المدّةُ المعلنة يومَها ووقتُ الإعلام مع التوقيع بساعة الخادم. والمدّةُ من مدد الحفظ
  /// (`RETENTION_YEARS.realEstate`) لا رقمٌ يُكتب، وما خُتم يُقرأ لاحقاً كما قيل يومَها ولو تغيّرت المدّة.
  photoNoticeYears Int?
  photoNoticeAt    DateTime?

  items HandoverItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos HandoverPhoto[]

  @@map("contract_handovers")
  handoverPhoto_handoverId_tenant HandoverPhoto[] @relation("HandoverPhoto_handoverId_tenant")
  handoverItem_handoverId_tenant HandoverItem[] @relation("HandoverItem_handoverId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

model HandoverItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  handoverId String
  handover   ContractHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  handoverTenant ContractHandover @relation("HandoverItem_handoverId_tenant", fields: [companyId, handoverId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  label     String
  condition ItemCondition
  note      String?

  createdAt DateTime @default(now())

  photos HandoverPhoto[]

  @@map("handover_items")
  handoverPhoto_itemId_tenant HandoverPhoto[] @relation("HandoverPhoto_itemId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// Which way the key money went. It decides the accounting entirely: received
/// is income, paid is an asset the company bought.
enum KeyMoneyDirection {
  /// The tenant paid the company for the right to the location.
  RECEIVED
  /// The company paid to take over a leased location — goodwill attached to
  /// the site, not rent.
  PAID
}

/// التقبيل — a lump sum for the *right to occupy a commercial location*,
/// separate from both rent and deposit: it is not refundable like a deposit and
/// not periodic like rent.
model ContractKeyMoney {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractKeyMoney_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  direction KeyMoneyDirection
  amount    Decimal           @db.Decimal(18, 2)
  note      String?

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  paidAt DateTime @db.Date

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("KeyMoney", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("ContractKeyMoney_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_key_money")
}

/// What a claim is for. Unlike a deposit deduction's kind, this does not steer
/// the accounting — every claim is other income — but it is what makes a list
/// of claims readable and reportable.
enum ClaimKind {
  MAINTENANCE
  UTILITIES
  LATE_FEE
  DAMAGE
  OTHER
  /// ⚖️ رسمُ خدمةٍ من بنود العقد يُطالَب مع قسطه (السؤالان ٤٩ و٤١٣ · `ق-١٦٠٠`) — يُنشئه الكنسُ لا اليد.
  FEE
}

/// ⚖️ **معاملةُ ضريبة القيمة المضافة لمطالبةٍ أو خصمٍ من التأمين** (الأسئلة ٤٩ و٥١ و٤١٣ و٤١٤ · `ق-١٦٠٠` · `ق-١٦٠٩`/د،
/// بحكم صاحب المشروع: «خانةٌ عند كلِّ مطالبة، والافتراضُ خاضع — فالنيابةُ استثناءٌ يُثبت»).
enum ChargeTaxTreatment {
  /// رسمٌ مقابل خدمة — خاضعٌ ١٥٪ ولو كان العقدُ سكنيّاً (دليلُ العقارات §6.1 ومثال 8). الافتراض.
  TAXABLE_SERVICE
  /// مبلغٌ دفعه المؤجّرُ نيابةً عن المستأجر بشروطه الخمسة (دليلُ الوكلاء §8.1) — حسابٌ وسيطٌ لا إيراد، ويُكتب ما يثبتها.
  ON_BEHALF
  /// تعويضٌ عن ضررٍ فعليّ — خارج نطاق الضريبة.
  COMPENSATION
  /// مطالبةٌ سبقت هذا الحقل — رُحّلت إيراداً بلا ضريبة وتبقى كذلك (يُعلَن ولا يُصحَّح رجعيّاً).
  LEGACY_UNTAXED
}

enum ClaimStatus {
  /// Issued and owed.
  OPEN
  PAID
  /// Written off by the landlord. The income is reversed, not deleted — the
  /// claim was really raised, and the audit trail has to say so.
  WAIVED
}

/// A monetary demand on the tenant outside the rent schedule: a repair they
/// caused, a utility bill they left, a late-payment fee.
///
/// Deliberately a receivable rather than a cash event: raising the claim and
/// collecting it are separate, and once it sits in 1200 it can be settled by
/// payment, waived, or taken out of a held deposit through the existing
/// deduction flow — with no special case for any of the three.
model ContractClaim {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractClaim_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  kind   ClaimKind
  amount Decimal   @db.Decimal(18, 2)
  /// Required: a claim the tenant can't see a reason for is a dispute waiting
  /// to happen — the same rule as a deposit deduction.
  description String

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  /// ⚖️ معاملتُها الضريبية (الأسئلة ٥١ و٤١٣) — بلا `@default`: الخادمُ يكتبها في كلِّ إنشاء (والافتراضُ «خاضع» فيه)، والقديمُ
  /// `LEGACY_UNTAXED` محبوسٌ بقيد `contract_claims_legacy_treatment_before_cutover` على ما سبق الهجرة.
  taxTreatment ChargeTaxTreatment
  /// ضريبتُها فوق `amount` للخاضعة (١٥٪) بعملة المطالبة، وصفرٌ لغيرها — فما يدين به المستأجرُ `amount + taxAmount`.
  taxAmount    Decimal @default(0) @db.Decimal(18, 2)
  baseTax      Decimal @default(0) @db.Decimal(18, 2)
  /// ما يثبت شروطَ النيابة (عدّادٌ باسم المستأجر · فاتورةٌ مفصولة …) — إلزاميٌّ لـ`ON_BEHALF` بقيد `contract_claims_on_behalf_evidence`.
  onBehalfEvidence String?

  /// ⚖️ مطالبةُ رسمٍ من بنود العقد (`FEE`): البندُ والقسطُ الذي حلّت معه — والزوجُ فريدٌ فلا يُطالَب رسمٌ مرّتين عن قسطٍ واحد.
  feeId String?
  fee   ContractFee? @relation(fields: [feeId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  feeTenant ContractFee? @relation("ContractClaim_feeId_tenant", fields: [companyId, feeId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  installmentTenant Installment? @relation("ContractClaim_installmentId_tenant", fields: [companyId, installmentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  issuedAt DateTime    @db.Date
  status   ClaimStatus @default(OPEN)
  settledAt DateTime?  @db.Date
  /// Why it was written off, when it was.
  waiveReason String?

  /// Null when the chart of accounts lacks 1200/4300 — the claim is still
  /// recorded, just not posted, matching how invoices behave.
  journalEntryId    String?       @unique
  journalEntry      JournalEntry? @relation("ClaimIssue", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("ContractClaim_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  settlementEntryId String?       @unique
  settlementEntry   JournalEntry? @relation("ClaimSettlement", fields: [settlementEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  settlementEntryTenant JournalEntry? @relation("ContractClaim_settlementEntryId_tenant", fields: [companyId, settlementEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ClaimAttachment[]

  @@unique([feeId, installmentId])
  @@map("contract_claims")
  claimAttachment_claimId_tenant ClaimAttachment[] @relation("ClaimAttachment_claimId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⚖️ **بندُ رسمٍ على العقد** (السؤالان ٤٩ و٤١٣ · `ق-١٦٠٠` · `ق-١٦٠٩`/د، بحكم صاحب المشروع: «بنودٌ على العقد تُفوتر مع القسط»).
///
/// رسمٌ مسمّى فوق الإيجار (موقف · نظافة · خدمات) **توريدٌ منفصل خاضعٌ ١٥٪ ولو كان الإيجارُ سكنيّاً معفى** (دليلُ العقارات §6.1
/// ومثال 8). مبلغُه لكلِّ قسطٍ صافياً بعملة العقد، وكلُّ قسطٍ يحلّ بين `effectiveFrom` و`endedAt` تُطالَب معه مطالبةً خاضعة
/// (`ContractClaim` نوعُها `FEE`) بتاريخ استحقاقه — فتدخل الذمّةَ والإقرارَ وتُحصَّل وتُسقَط كأيّ مطالبة. يُنهى ولا يُحذف.
model ContractFee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractFee_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  label  String
  /// لكلِّ قسط، صافياً بعملة العقد — والضريبةُ فوقه على مطالبته.
  amount Decimal @db.Decimal(18, 2)
  /// أوّلُ يومٍ يُطالَب فيه — قسطٌ يحلّ قبله لا رسمَ معه.
  effectiveFrom DateTime  @db.Date
  /// آخرُ يومٍ يُطالَب فيه (يُنهى ولا يُحذف) — وفارغٌ ما دام سارياً.
  endedAt       DateTime? @db.Date

  createdAt DateTime @default(now())

  claims ContractClaim[]

  @@index([contractId])
  @@map("contract_fees")
  contractClaim_feeId_tenant ContractClaim[] @relation("ContractClaim_feeId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// The two deposits a Saudi lease commonly carries. They are settled
/// separately — a tenant can lose the facility deposit to unpaid utilities
/// while the rent deposit is refunded in full.
enum DepositType {
  /// تأمين الإيجار
  RENT
  /// تأمين المنشأة/الخدمات
  FACILITY
}

/// **Who is actually holding the money.** This is not a label — it decides
/// whether anything is posted at all.
///
/// A deposit blocked on the Ejar platform never reaches the landlord's till:
/// the platform is the custodian and refunds the tenant directly at the end.
/// Debiting cash and raising a liability for money that was never received
/// would overstate both sides of the balance sheet.
enum DepositHolder {
  /// Received by the company — cash in hand, liability owed to the tenant.
  COMPANY
  /// Blocked on the Ejar platform, which is responsible for it.
  EJAR
}

enum DepositStatus {
  /// Received and owed back to the tenant.
  HELD
  /// Broken down into deductions and a refund; nothing further is owed.
  SETTLED
}

/// What a deduction was taken for. This drives the accounting, not just the
/// label: unpaid rent settles an existing receivable, while the rest are
/// income the landlord keeps.
enum DeductionKind {
  UNPAID_RENT
  DAMAGE
  UTILITIES
  CLEANING
  OTHER
}

/// Money held on behalf of the tenant — a liability, not revenue, until it is
/// settled. `Contract.deposit` records the agreed figure; this records the cash
/// actually received, which is what the ledger cares about.
model ContractDeposit {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractDeposit_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  type   DepositType
  holder DepositHolder @default(COMPANY)
  amount Decimal       @db.Decimal(18, 2)

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  receivedAt DateTime      @db.Date
  status     DepositStatus @default(HELD)
  settledAt  DateTime?     @db.Date
  /// What went back to the tenant — set once at settlement so it survives even
  /// if a deduction row is later corrected.
  refundAmount Decimal?    @db.Decimal(18, 2)
  note         String?

  /// Null when the chart of accounts lacks 1000/2300 — the deposit is still
  /// recorded, just not posted, matching how invoices behave.
  journalEntryId    String?       @unique
  journalEntry      JournalEntry? @relation("DepositReceipt", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("ContractDeposit_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  settlementEntryId String?       @unique
  settlementEntry   JournalEntry? @relation("DepositSettlement", fields: [settlementEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  settlementEntryTenant JournalEntry? @relation("ContractDeposit_settlementEntryId_tenant", fields: [companyId, settlementEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  deductions DepositDeduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_deposits")
  depositDeduction_depositId_tenant DepositDeduction[] @relation("DepositDeduction_depositId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// One line of "what we kept and why" at settlement. Itemized rather than a
/// single number because a tenant disputing a deduction needs the reason, and
/// the landlord needs it split across the right accounts.
model DepositDeduction {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  depositId String
  deposit   ContractDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  depositTenant ContractDeposit @relation("DepositDeduction_depositId_tenant", fields: [companyId, depositId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  kind   DeductionKind
  amount Decimal       @db.Decimal(18, 2)
  reason String

  /// ⚖️ معاملتُه الضريبية (السؤال ٤١٤): الضررُ والإيجارُ غيرُ المسدَّد بلا معاملة (فارغ) · النظافةُ خاضعة (٤٩) · المرافقُ خاضعةٌ
  /// أو نيابةً (٥١) · «أخرى» خاضعةٌ أو تعويض يُسأل عنه. والقديمُ فارغٌ وما بعد الهجرة يُعلَن بقيد `deposit_deductions_treatment_declared`.
  taxTreatment ChargeTaxTreatment?
  /// للخاضع: المبلغُ المأخوذُ من التأمين إجماليٌّ، وهذا صافيه وضريبتُه بعملة الدفتر بسعر الوديعة — يقرؤهما الإقرارُ بتاريخ التسوية.
  baseNet      Decimal? @db.Decimal(18, 2)
  baseTax      Decimal  @default(0) @db.Decimal(18, 2)
  /// ما يثبت شروطَ النيابة — إلزاميٌّ لـ`ON_BEHALF` بقيد `deposit_deductions_on_behalf_evidence`.
  onBehalfEvidence String?

  createdAt DateTime @default(now())

  @@map("deposit_deductions")
}

model Contract {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  unitTenant Unit @relation("Contract_unitId_tenant", fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  customerTenant Customer? @relation("Contract_customerId_tenant", fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// `EJ-<year>-<seq>`, server-generated — see ContractsService.nextContractNumber.
  no     String
  /// Optional official Ejar-platform registry number, free text — display only.
  ejarNo String?

  tenant String
  phone  String?

  value  Decimal        @db.Decimal(18, 2)
  /// 'monthly' | 'quarterly' | 'semiannual' | 'annual' — drives installment generation.
  cycle  String
  start  DateTime       @db.Date
  end    DateTime       @db.Date
  deposit Decimal       @default(0) @db.Decimal(18, 2)

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseValue    Decimal @db.Decimal(18, 2)

  services  String?
  /// 'unfurnished' | 'furnished' | 'partial'.
  furnished String?

  /// إلزاميٌّ بلا افتراضٍ صامت — لا `@default`: عقدٌ بلا تصنيفٍ يُرفض (`ق-٨٩١`).
  classification ContractClassification
  /// إلزاميٌّ كذلك — أشاملٌ `value` للضريبة أم لا (`ق-٨٩٢`).
  vatInclusion   ContractVatInclusion
  /// ⚖️ من المؤجّر (السؤال ٥٧٧ · `ق-١٦٠٠`) — إلزاميٌّ بلا `@default`: على عقار التشغيل يُعلَن، وعلى غيره المنشأة.
  lessor         ContractLessor
  /// اسمُ المالك حين يكون المؤجّرَ — قيدُ `contracts_owner_lessor_named` يُلزمه.
  ownerName      String?
  /// رقمُه الضريبيّ (`^3\d{13}3$`) — إلزاميٌّ للتجاريّ، فتوريدُه الخاضعُ يحتاج مورّداً مسجَّلاً.
  ownerVatNumber String?
  /// ⚖️ المختلطُ وحدَه (السؤال ٤١٢): نصيبُ الجزء المعفى من قيمة الإيجار بالمئة (بين 0 و100 لا يشملهما) — والضريبةُ على الباقي.
  /// قيدُ `contracts_mixed_share_declared` يُلزمه للمختلط ويمنعه لغيره.
  exemptSharePercent Decimal? @db.Decimal(5, 2)
  /// أساسُ النسبة كما يعلنه المؤجّر (المساحة · القيمةُ السوقية · …) — فالمؤجّرُ مسؤولٌ عن التقسيم بنصّ الهيئة.
  exemptShareBasis   String?

  status       ContractStatus @default(DUE)
  cancelDate   DateTime?      @db.Date
  cancelReason String?

  /// Early-termination settlement: what the tenant owes for breaking the lease.
  /// Compensation, not rent — the property isn't let for that period — so it is
  /// posted to other income, never to 4200.
  settlementAmount    Decimal?      @db.Decimal(18, 2)
  settlementEntryId   String?       @unique
  settlementEntry     JournalEntry? @relation("ContractSettlement", fields: [settlementEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  settlementEntryTenant JournalEntry? @relation("Contract_settlementEntryId_tenant", fields: [companyId, settlementEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// The contract this one renews. One-to-one in both directions: a contract
  /// is renewed at most once, and the unique constraint is what enforces it —
  /// two renewals of the same lease would fork the tenancy history.
  renewedFromId String?    @unique
  renewedFrom   Contract?  @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  renewedFromTenant Contract? @relation("Contract_renewedFromId_tenant", fields: [companyId, renewedFromId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  renewedTo     Contract?  @relation("ContractRenewal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments Installment[]
  payments     RentPayment[]
  accruals     RentAccrual[]
  attachments  ContractAttachment[]
  deposits     ContractDeposit[]
  claims       ContractClaim[]
  /// ⚖️ بنودُ الرسوم فوق الإيجار (السؤالان ٤٩ و٤١٣ · ق-١٦٠٠).
  fees         ContractFee[]
  keyMoney     ContractKeyMoney[]
  handovers    ContractHandover[]

  settlementLines ContractSettlementLine[]

  @@unique([companyId, no])
  /// The paginated list orders by start desc within the tenant.
  @@index([companyId, start])
  @@map("contracts")
  rentAccrual_contractId_tenant RentAccrual[] @relation("RentAccrual_contractId_tenant")
  rentPayment_contractId_tenant RentPayment[] @relation("RentPayment_contractId_tenant")
  /// ⚖️ ما نُقل من رصيد مستأجر هذا العقد إلى أقساط تجديده (توجيه ٢٧٨ · `ق-١٦٢٩`).
  creditTransfersOut RentPayment[] @relation("RentPaymentCreditFrom")
  rentPayment_creditFromContractId_tenant RentPayment[] @relation("RentPayment_creditFromContractId_tenant")
  installment_contractId_tenant Installment[] @relation("Installment_contractId_tenant")
  contractSettlementLine_contractId_tenant ContractSettlementLine[] @relation("ContractSettlementLine_contractId_tenant")
  contractAttachment_contractId_tenant ContractAttachment[] @relation("ContractAttachment_contractId_tenant")
  contract_renewedFromId_tenant Contract[] @relation("Contract_renewedFromId_tenant")
  contractDeposit_contractId_tenant ContractDeposit[] @relation("ContractDeposit_contractId_tenant")
  contractClaim_contractId_tenant ContractClaim[] @relation("ContractClaim_contractId_tenant")
  contractFee_contractId_tenant ContractFee[] @relation("ContractFee_contractId_tenant")
  contractKeyMoney_contractId_tenant ContractKeyMoney[] @relation("ContractKeyMoney_contractId_tenant")
  contractHandover_contractId_tenant ContractHandover[] @relation("ContractHandover_contractId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A file stored against a contract — a signed lease PDF, an annex, a
/// clearance letter. The bytes live in object storage (MinIO); this row is
/// the metadata and the tenant-scoped handle the app lists and authorizes
/// against. The storage key is re-verified under the company prefix on every
/// download, the same way logo keys are — object storage has no RLS.
///
/// ⚠️ This example list used to read "an ID scan". It no longer does, and it
/// must not again: لائحة مرفق الضيافة السياحي (2289) م.٢٨/١٤ obliges the
/// licensed operator to verify identity from the original and record its data
/// **«دون طلب أو أخذ نسخة منها»** — no copy taken. The obligation binds our
/// customer, not us; but a schema that names an ID scan as a use case pushes
/// that customer into the breach. The upload UI carries the matching warning.
model ContractAttachment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractAttachment_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Object-storage key: companies/{companyId}/{uuid}-{filename}.
  fileKey  String
  filename String
  size     Int
  mimeType String

  uploadedAt DateTime @default(now())

  @@index([contractId])
  @@map("contract_attachments")
}

/// مرفق مطالبة (§16 — احتياجات §11): فاتورة إصلاح، صور ضرر، مراسلات.
/// Mirror of ContractAttachment — bytes in MinIO, tenant-scoped metadata here.
model ClaimAttachment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  claimId String
  claim   ContractClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  claimTenant ContractClaim @relation("ClaimAttachment_claimId_tenant", fields: [companyId, claimId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  fileKey  String
  filename String
  size     Int
  mimeType String

  uploadedAt DateTime @default(now())

  @@index([claimId])
  @@map("claim_attachments")
}

/// صورة على نموذج استلام/تسليم (16.15) — على النموذج كله أو على بندٍ بعينه
/// (خدش الباب ← صورة على بند الباب). تُقفل مع النموذج: لا إضافة ولا حذف
/// بعد التوقيع — الصور جزء مما وُقِّع عليه.
model HandoverPhoto {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  handoverId String
  handover   ContractHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  handoverTenant ContractHandover @relation("HandoverPhoto_handoverId_tenant", fields: [companyId, handoverId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  itemId String?
  item   HandoverItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  itemTenant HandoverItem? @relation("HandoverPhoto_itemId_tenant", fields: [companyId, itemId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  fileKey  String
  filename String
  size     Int
  mimeType String
  note     String?

  uploadedAt DateTime @default(now())

  @@index([handoverId])
  @@map("handover_photos")
}

/// بند من تسوية إلغاء العقد (§16): «شهر إشعار: 3000» · «صيانة: -450»…
/// المجموع يجب أن يساوي مبلغ التسوية المرحَّل — يُدقَّق على الخادم.
model ContractSettlementLine {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("ContractSettlementLine_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  label  String
  /// موجب = على المستأجر، سالب = له (استرداد).
  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([contractId])
  @@map("contract_settlement_lines")
}

/// فاتورة مصروف تأسيسي ومستندها (صورة/PDF) — مستند §5: same bytes-in-object-
/// storage pattern as ContractAttachment; the row is the tenant-scoped
/// authorization record.
model PurchaseAttachment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("PurchaseAttachment_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Object-storage key: companies/{companyId}/{uuid}-{filename}.
  fileKey  String
  filename String
  size     Int
  mimeType String

  uploadedAt DateTime @default(now())

  @@index([purchaseId])
  @@map("purchase_attachments")
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

/// مناوبة كاشير (مستند §6): تُفتح بعهدة نقدية، تُختم بجردٍ معلَن، والفرق
/// (العجز/الزيادة) يُحسب من مبيعات النقد المسجّلة عليها — لا يُدخل يدوياً.
model PosShift {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("PosShift_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// The login identity that opened the shift — a cashier closes their own.
  openedById   String
  openedByName String

  status       PosShiftStatus @default(OPEN)
  openedAt     DateTime       @default(now())
  closedAt     DateTime?

  /// العهدة الافتتاحية (cash float) — what the drawer starts with.
  openingFloat    Decimal  @db.Decimal(18, 2)
  /// What the cashier counted at close; variance = declared − expected.
  declaredClosing Decimal? @db.Decimal(18, 2)

  /// ⭐ **فرقُ الجرد — يُخزَّن عند الإقفال ولا يُعاد حسابه** (`ق-٣٠٠`).
  ///
  /// موجبٌ = زيادةٌ في الدرج · سالبٌ = عجز · و`null` = مناوبةٌ لم تُقفل بعد
  /// **أو أُقفلت قبل هذه الموجة** (تُعلَن ولا تُرحَّل رجعياً — `ق-٣٠٨`).
  ///
  /// ⚠️ **ولا يُعاد حسابُه في التقرير**: رقمٌ يُعاد حسابه بعد شهور **يتبع
  /// الشيفرةَ الحالية لا الحالةَ وقت الإقفال** — فتغييرٌ في معادلة الحساب
  /// يُعيد كتابة تاريخٍ بلا قيد. **والتقريرُ يقرأ ولا يحسب.**
  ///
  /// ⚠️ **ويُكتب مع قيده في المعاملة نفسها** (`ق-٣٠٨`): تخزينُه بلا ترحيله
  /// يُعيد إنتاج «رقمٍ يتحرك بلا قيدٍ يسنده» — وهو العطلُ الذي أُغلق.
  variance        Decimal? @db.Decimal(18, 2)

  notes           String?

  invoices Invoice[]

  /// الدرج الذي فُتحت عليه المناوبة (`ق-٢١٨` · `ق-٢٦١`). يقبل الفراغ **للمناوبات
  /// التي سبقت الكيان وحدها** — والمناوبات القائمة تُنسب في الترحيل إلى الدرج
  /// الافتراضي لفرعها، فالزوجُ (فرع، كاشير) مجسٌّ لا هويّة: الكاشير ليس درجاً.
  drawerId String?
  drawer   CashDrawer? @relation(fields: [drawerId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  drawerTenant CashDrawer? @relation("PosShift_drawerId_tenant", fields: [companyId, drawerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// محاولاتُ دفع البطاقة على المناوبة (`ق-١٤٠١`) — والمناوبةُ لا تُقفل ومالُها في الطريق.
  paymentAttempts PosPaymentAttempt[]

  @@index([companyId, status])
  @@index([drawerId])
  @@map("pos_shifts")
  invoice_posShiftId_tenant Invoice[] @relation("Invoice_posShiftId_tenant")
  posPaymentAttempt_shiftId_tenant PosPaymentAttempt[] @relation("PosPaymentAttempt_shiftId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// **درجُ الكاشير كياناً وحساباً** (`ق-٢١٨` بحكم صاحب المشروع: «المفصَّل يُجمَّع
/// دائماً والمجمَّع لا يُفصَّل أبداً» · والرموز في `ق-٢٥٣`).
///
/// كان الدرج **ضمنياً** حتى 2026-09-07: زوجُ (فرع، كاشير) على المناوبة، بلا كيانٍ
/// ولا حساب — وكلُّ نقدٍ يُرحَّل إلى `1000` وحده، فسؤالُ «أيُّ درجٍ عجز؟» بلا جوابٍ
/// رجعيّ.
///
/// **وحسابُه يُنشأ معه تلقائياً** في نطاق `1010`–`1099` بـ`MAX+1` **تحت قيدٍ فريد**
/// (`ق-١٩٨`: لا `count()`؛ والتصادمُ يظهر `P2002` فيُعاد الترقيم لا يُخمَّن) —
/// فلا يُدخِل التاجرُ رمزاً بيده ولا يُترك الدرجُ بلا مقابلٍ في الأستاذ.
model CashDrawer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// الفرع الذي يقف فيه الدرج — يقبل الفراغ لمنشأةٍ بلا فروع.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("CashDrawer_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  name     String
  isActive Boolean @default(true)

  /// **درجُ الفرع الافتراضي** — يُنشأ في الترحيل لكل فرعٍ له مناوبات، وتُنسب إليه
  /// المناوباتُ السابقة على الكيان. والتفصيل يبدأ من أول درجٍ يُنشئه التاجر.
  isDefault Boolean @default(false)

  /// ⚖️ **خلفُه حين نُقل بين الفروع** (`ق-١٤١٣`): النقلُ إغلاقٌ وفتح — فهذا الدرجُ أُغلق في فرعه بعد عدِّ نقده ونقلِ
  /// رصيده، والخلفُ درجٌ جديدٌ في الفرع الهدف بحسابٍ جديد. **وتاريخُ هذا الدرج لا ينتقل** — مناوباتُه وإيداعاتُه
  /// وقيودُه بفرعه؛ والرابطُ هو ما يقول لمن يقرأ بعد سنة أين ذهب نقدُه. `NoAction` لا `Restrict`: الخلفُ لا يُحذف
  /// وسلفُه يشير إليه — **والفحصُ آخرَ العبارة** فحذفُ المنشأة يحذف الاثنين معاً (`Restrict` يفحص صفّاً صفّاً فيسقط الحذفُ المتسلسل).
  transferredToId String? @unique
  transferredTo   CashDrawer? @relation("CashDrawerTransfer", fields: [transferredToId], references: [id], onDelete: NoAction)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  transferredToTenant CashDrawer? @relation("CashDrawer_transferredToId_tenant", fields: [companyId, transferredToId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// السلفُ الذي أُغلق وفُتح هذا بدلاً منه — إن وُجد.
  transferredFrom CashDrawer? @relation("CashDrawerTransfer")
  cashDrawer_transferredToId_tenant CashDrawer[] @relation("CashDrawer_transferredToId_tenant")

  /// حسابُ الدرج في الدليل — واحدٌ لواحد، ولا يُشارَك.
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  accountTenant Account @relation("CashDrawer_accountId_tenant", fields: [companyId, accountId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts PosShift[]

  @@unique([companyId, branchId, name])
  @@index([companyId, isActive])
  @@map("cash_drawers")
  cashDeposits CashDeposit[]
  posShift_drawerId_tenant PosShift[] @relation("PosShift_drawerId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
  cashDeposit_drawerId_tenant CashDeposit[] @relation("CashDeposit_drawerId_tenant")
}

/// ق-١٤٣١ — نوعُ صفّ البنك معلَنٌ لا مستنبَط. `LEGACY_UNDECLARED` لما سبق الهجرة وحدَه (قيدُ `CHECK` على `createdAt`).
enum BankKind {
  CASH_BOX
  BANK_ACCOUNT
  LEGACY_UNDECLARED
}

/// حالُ إيداع الدرج (ق-١٢٦١ ج — ⑦A3): في الطريق حتى يؤكّده كشفُ البنك من التسوية؛ أو مُلغى بقيدِ عكس.
enum CashDepositStatus {
  IN_TRANSIT
  CONFIRMED
  VOID
}

/// إيداعُ نقدِ درجٍ في بنك عبر «نقدٍ في الطريق» 1190 (ق-١٢٦١ ج — ⑦A3): مدين 1190 / دائن الدرج عند الإيداع،
/// ثم يؤكّده سطرُ كشف البنك من التسوية (مدين البنك / دائن 1190) — فلا يدخل البنكَ بالدفتر قبل أن يُرى في كشفه.
model CashDeposit {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("CashDeposit_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  no     String
  date   DateTime @db.Date
  amount Decimal  @db.Decimal(18, 2)
  memo   String?
  status CashDepositStatus @default(IN_TRANSIT)

  drawerId String
  drawer   CashDrawer @relation(fields: [drawerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  drawerTenant CashDrawer @relation("CashDeposit_drawerId_tenant", fields: [companyId, drawerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  bankId   String
  bank     Bank       @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank @relation("CashDeposit_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  journalEntryId String?
  journalEntry   JournalEntry? @relation("CashDepositEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("CashDeposit_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  voidJournalEntryId String?
  voidJournalEntry   JournalEntry? @relation("CashDepositVoidEntry", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  voidJournalEntryTenant JournalEntry? @relation("CashDeposit_voidJournalEntryId_tenant", fields: [companyId, voidJournalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// سطرُ الكشف الذي أكّد الوصول (من التسوية) — واحدٌ لواحد.
  confirmedTransactionId String?          @unique
  confirmedTransaction   BankTransaction? @relation("CashDepositConfirmation", fields: [confirmedTransactionId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  confirmedTransactionTenant BankTransaction? @relation("CashDeposit_confirmedTransactionId_tenant", fields: [companyId, confirmedTransactionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, no])
  @@index([companyId, status])
  @@map("cash_deposits")
}

/// حالُ تسوية الشبكة (ق-١٢٦١ ج — ⑦A2): مرحَّلةٌ، أو مُلغاةٌ بعكس.
enum NetworkSettlementStatus {
  POSTED
  VOID
}

/// تسويةُ الشبكة 1251 (ق-١٢٦١ ج — ⑦A2): تحصيلُ المستحوذ يدخل البنكَ صافياً وتُثبَت العمولةُ وضريبتُها في
/// شهرهما وتُقفل ذمّةُ الشبكة بإجماليّ سندات القبض التي طالبت بها التسوية (`Payment.networkSettlementId`):
/// مدين البنك (الصافي) · مدين 5910 (العمولة) · مدين 1250 (ضريبتها) · دائن 1251 (الإجمالي).
/// الإجماليُّ من الدفتر لا من اليد، والإلغاءُ عكسٌ يُطلق السنداتِ إلى المفتوح.
model NetworkSettlement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("NetworkSettlement_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  no         String
  /// يومُ دخول التحصيل إلى البنك.
  date       DateTime @db.Date
  /// مدى سندات القبض المطالَب بها — بتاريخ السند.
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  /// ما رحّلته السنداتُ المطالَبُ بها على 1251 (موجباً للقبض، سالباً للعكس والردّ).
  grossAmount  Decimal @db.Decimal(18, 2)
  feeAmount    Decimal @db.Decimal(18, 2)
  /// ضريبةُ القيمة المضافة على العمولة — تُدخَل من إشعار المستحوذ لا تُفترض.
  feeVatAmount Decimal @db.Decimal(18, 2)
  /// الإجمالي − العمولة − ضريبتها = ما دخل البنك.
  netAmount    Decimal @db.Decimal(18, 2)
  memo         String?
  status       NetworkSettlementStatus @default(POSTED)

  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank @relation("NetworkSettlement_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  journalEntryId String?
  journalEntry   JournalEntry? @relation("NetworkSettlementEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("NetworkSettlement_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  voidJournalEntryId String?
  voidJournalEntry   JournalEntry? @relation("NetworkSettlementVoidEntry", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  voidJournalEntryTenant JournalEntry? @relation("NetworkSettlement_voidJournalEntryId_tenant", fields: [companyId, voidJournalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// سنداتُ القبض التي طالبت بها هذه التسوية — بالمعرّف (§6.3)، والسندُ لتسويةٍ واحدة.
  receipts Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, no])
  @@index([companyId, status])
  @@index([companyId, bankId])
  @@map("network_settlements")
  payment_networkSettlementId_tenant Payment[] @relation("Payment_networkSettlementId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// دفعة واحدة من فاتورة كاشير (مستند §4): الفاتورة الواحدة قد تُدفع نقداً
/// وبطاقةً معاً — صفٌّ لكل طريقة بمبلغها، ودرجُ المناوبة يجمع النقد فقط.
/// Extensible by design: a BNPL or terminal-mediated method lands here as
/// another method string without touching the drawer math.
model PosPayment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  invoiceTenant Invoice @relation("PosPayment_invoiceId_tenant", fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  method String
  amount Decimal @db.Decimal(18, 2)
  /// مرجع عملية المزوّد (رقم موافقة الجهاز/البوابة) إن مرّت عبر adapter.
  providerRef String?

  /// ⚖️ **بمَ ثبت دفعُ صفِّ البطاقة** (`ق-١٣٩٧` · `ق-١٣٩٩`) — و`null` لصفِّ النقد وحدَه (قيدُ `CHECK` في القاعدة).
  verification    PosCardVerification?
  /// **رقمُ مرجع الجهاز من إيصاله** — إلزاميٌّ لبيعٍ ببطاقةٍ دون اتصالٍ والربطُ فعّال (`ق-١٣٩٧`/١) وللحسم اليدويّ (`ق-١٣٩٩`).
  deviceReference String?
  /// رمزُ الموافقة — من المزوّد أو من إيصال الجهاز.
  approvalCode    String?
  /// محاولةُ الدفع التي أنتجت صفَّ البطاقة — لما مرّ بالمزوّد أو حُسم يدوياً.
  attemptId       String?
  attempt         PosPaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: NoAction)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  attemptTenant PosPaymentAttempt? @relation("PosPayment_attemptId_tenant", fields: [companyId, attemptId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([companyId, invoiceId])
  @@map("pos_payments")
}

/// ⭐ **حالُ محاولة دفع البطاقة** (`ق-١٤٠١` · الموجز `موجز-مسار-دفع-الكاشير.md` ٢.٢).
///
/// كلُّ انتقالٍ كتابةٌ مشروطةٌ بالحالة السابقة — فنقرتان لا تشحنان مرّتين، والإتمامُ لا يقع مرّتين.
enum PosPaymentAttemptStatus {
  /// تحقّقنا من البيع ولم نُرسل شيئاً.
  CREATED
  /// أُرسل الطلبُ للمزوّد وننتظر — بمهلة محوّله (`ق-١٣٩٨`).
  CHARGING
  /// قبل المزوّد (أو حُسم بدليلٍ مسجَّل) — ولم تُنشأ الفاتورةُ بعد.
  APPROVED
  /// الفاتورةُ أُنشئت في معاملة الإتمام.
  COMPLETED
  /// رفض المزوّد — لا فاتورة ولا رقم.
  DECLINED
  /// انقطع الجوابُ — المالُ قد يكون قُبض: لا يخرج إلا بجواب المزوّد أو بدليلٍ مسجَّل (`ق-١٣٩٩`).
  UNKNOWN
  /// أُلغيت قبل الإرسال — بيد الكاشير أو بإقفال المناوبة عليها.
  CANCELLED
}

/// ⚖️ **بمَ ثبت دفعُ البطاقة** (`ق-١٣٩٧` · `ق-١٣٩٩`).
enum PosCardVerification {
  /// قبله المزوّد عبر محاولة الدفع — الربطُ فعّال والاتصالُ قائم.
  PROVIDER_APPROVED
  /// بيعٌ دون اتصالٍ والربطُ فعّال: رقمُ مرجع الجهاز من إيصاله — **غيرُ متحقَّقٍ حتى تطالب به تسويةُ الشبكة** (`ق-١٣٩٧`).
  DEVICE_REFERENCE
  /// معلّقٌ لم يُجب عنه المزوّد فحسمه صاحبُ المراجعة بإيصال الجهاز ورمز الموافقة — **غيرُ نهائيٍّ حتى تطابقه التسوية** (`ق-١٣٩٩`).
  MANUAL_EVIDENCE
  /// بلا ربطٍ فعّال: جهازٌ مستقلّ أكّده الكاشير — مسارُ ما قبل الربط (الموجز ٢.١)، وكلُّ صفِّ بطاقةٍ قائمٍ بلا مرجع مزوّد.
  CASHIER_CONFIRMED
}

/// مَن حسم محاولةَ الدفع.
enum PosPaymentResolution {
  /// جوابُ الشحن نفسِه — قُبل أو رُفض في مهلته.
  PROVIDER_CHARGE
  /// جوابُ المزوّد على الاستعلام بالمرجع (`ق-١٣٩٩`: «جوابُ المزوّد أوّلاً»).
  PROVIDER_STATUS
  /// صاحبُ المراجعة بدليلٍ مسجَّل — والمزوّدُ لم يُجب (`ق-١٣٩٩`).
  MANUAL_EVIDENCE
  /// أُلغيت قبل الإرسال.
  CANCELLED
}

/// ⭐ **محاولةُ دفع البطاقة — الشحنُ خارج المعاملة، والفاتورةُ بعد القبول** (`ق-١٤٠١` · `ق-١٣٩٧` … `ق-١٣٩٩`).
///
/// البيعُ ببطاقةٍ والربطُ فعّال لا يُنشئ فاتورةً قبل جواب المزوّد: يُتحقَّق منه ويُحفظ لقطةً (`CREATED`)، ثم يُشحن
/// **خارج كلِّ معاملة** بمهلة المحوّل (`CHARGING`)، ثم تُنشأ الفاتورةُ ورقمُها وقيدُها وسندُها **في معاملة الإتمام
/// وحدَها** (`COMPLETED`). فالرفضُ لا يترك فاتورةً ولا يستهلك رقماً، والانقطاعُ حالٌ مسمّاةٌ (`UNKNOWN`) تُحسم ولا تُخمَّن.
model PosPaymentAttempt {
  /// **معرّفُ المحاولة هو مرجعُها عند المزوّد** — مفتاحُ عدم التكرار: الاستعلامُ والإعادةُ بالمرجع نفسِه.
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  shiftId     String
  shift       PosShift @relation(fields: [shiftId], references: [id], onDelete: NoAction)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  shiftTenant PosShift @relation("PosPaymentAttempt_shiftId_tenant", fields: [companyId, shiftId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// البيعُ من الجهاز — فريدٌ في المنشأة: إعادةُ الطلب بالمعرّف نفسِه تعيد المحاولةَ نفسَها.
  clientSaleId String
  status       PosPaymentAttemptStatus @default(CREATED)

  /// **لقطةُ البيع المتحقَّق منها** — المستندُ بسطوره وأسعاره وفئاته لحظةَ البيع وأجزاءُ دفعه: منها وحدَها تُنشأ الفاتورةُ
  /// عند الإتمام، فلا يفترق ما يُفوتَر عمّا شُحن ولو تغيّر سعرُ الصنف بين الشحن والإتمام.
  sale Json

  cardAmount Decimal @db.Decimal(18, 2)
  /// عملةُ المستند — من المنشأة لا حرفاً (`§3.8`).
  currency   String
  /// المحوّلُ الذي شُحنت عليه — وبه يُستعلم عن الحال.
  provider   String

  providerRef   String?
  approvalCode  String?
  declineReason String?
  /// آخرُ ما قيل عن الحال وهي لم تُحسم — سببُ التعليق (مهلةٌ انقضت · انقطاع) أو جوابٌ غيرُ قاطع.
  detail        String?

  invoiceId     String?  @unique
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: NoAction)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  invoiceTenant Invoice? @relation("PosPaymentAttempt_invoiceId_tenant", fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  chargeStartedAt DateTime?
  resolvedAt      DateTime?
  resolution      PosPaymentResolution?
  /// مَن حسم يدوياً — هويّتُه واسمُه لحظةَ الحسم (`ق-١٣٩٩`: «ويُسجَّل»).
  resolvedById    String?
  resolvedByName  String?
  /// دليلُ الحسم اليدويّ من إيصال الجهاز: مرجعُه ورمزُ الموافقة — وملاحظة.
  evidenceDeviceReference String?
  evidenceApprovalCode    String?
  evidenceNote            String?

  /// الكاشيرُ الذي أنشأها — هويّتُه (مفتاحُ مناوبته).
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posPayments                 PosPayment[]
  posPayment_attemptId_tenant PosPayment[] @relation("PosPayment_attemptId_tenant")

  @@unique([companyId, clientSaleId])
  @@index([companyId, status])
  @@index([companyId, shiftId])
  @@map("pos_payment_attempts")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

enum IntegrationKind {
  PAYMENT_GATEWAY
  BNPL
  ECOMMERCE
}

/// ربط منشأة بمزوّد خارجي (مستند: «كل تكامل خارجي طبقة قابلة للاستبدال»).
/// المفاتيح ملك التاجر وتُخزَّن مشفّرة AES-256-GCM (انظر credentials.crypto.ts)
/// ولا تُقرأ مفكوكة إلا لحظة استدعاء المزوّد — القراءات تُرجع قناعاً فقط.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: ربطُ منشأةٍ بمزوّدٍ خارجيّ.
model IntegrationConnection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind     IntegrationKind
  /// "MOCK" | "GEIDEA" | "TAMARA" | "SALLA" ... — مفتاح سجل الـadapters.
  provider String
  label    String?

  /// JSON مشفّر: iv.tag.ciphertext (base64) — أبداً ليس نصاً صريحاً.
  credentials String

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_connections")
}

enum SupportGrantStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

/// وضع الدعم الفني (احتياجات §1.10): دخول مدير المنصة لبيانات منشأة
/// **بموافقتها الصريحة فقط**، لمدة محددة، للقراءة فقط، وبسجل كامل تراه
/// المنشأة. الإنفاذ تقني في TenantGuard — لا سياسةً على الورق.
/// **بلا أبٍ** — كيانٌ جذريّ تمنحه المنشأة: نافذةُ دعمٍ محدودةُ المدة.
///
/// ⚠️ **ولا مفتاحَ أجنبيّ إلى المنشأة عمداً** (`ق-٥٣١`): حذفُ المنشأة صلبٌ
/// (`companiesService.remove` عبر هويّة الدخول ← `Cascade` على ٦٩ علاقة)،
/// **وأثرُ دخول الدعم إلى بياناتها هو سجلُّ المعالج نفسِه** — يلزمه النظام
/// (م٨: تحقّقُ جهة التحكم · م٣١: سجلّاتُ المعالجة) **ويُمحى مع المنشأة في أسوأ
/// وقت** (`ق-٨٠`). فالعمودُ `companyId` قائمٌ بلا رابط، **والاسمُ يُحفظ هنا**
/// لأن الصفَّ الذي كان يُقرأ منه يزول.
model SupportAccessGrant {
  id        String @id @default(uuid())
  companyId String
  /// اسمُ المنشأة لحظةَ الطلب — يبقى بعد حذفها.
  companyName String @default("")

  requestedById   String
  requestedByName String
  /// لماذا يطلب الدعم الدخول — يظهر للمالك قبل موافقته.
  reason          String
  durationMinutes Int
  /// **نطاقُ ما يُرى** (`ق-٥٢٧`): شاشاتٌ من `ALLOWED_SCREENS` يختارها الطالب،
  /// **ويراها المالكُ في شاشة القرار قبل موافقته** — فتعليمةٌ يوافق عليها بلا
  /// أن يراها ليست تعليمة. **والحارسُ يُنفذها**: ما ليس فيها `403`.
  ///
  /// 🔴 وهي **«فئاتُ البيانات الشخصية المعالجة»** التي توجب اللائحةُ التنفيذية
  /// (م١٧/١/ب) أن يتضمّنها اتفاقُ المعالجة — **فالإذنُ كان يحمل الغرضَ والمدةَ
  /// ولا يحمل الفئات**. وفارغةٌ = لا شاشة (أذونٌ سبقت هذا الحقل تُغلق لا تُفتح).
  screens         String[]           @default([])

  status      SupportGrantStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  /// **ومن قرّر — على الصفّ لا استدلالاً** (`ق-٦٤٦`): كان الصفُّ يحمل من طلب ومتى
  /// قُرّر **ولا يحمل من قرّر**؛ والمالكُ واحدٌ فيُستدلّ عليه — **والاستدلالُ ليس
  /// تسجيلاً**. بالشكل نفسِه الذي في الإجازات والشطب — ثالثُها، ولا نمطان.
  /// والفارغُ في صفوفٍ سبقت الحقل «غيرُ معلوم» لا «لا أحد» — ولا يُملأ بالظنّ.
  decidedById   String?
  decidedByName String?
  /// نهاية النافذة — انقضاؤها يميت الجلسة ولو بقي status=APPROVED.
  expiresAt   DateTime?
  /// أوّلُ دخولٍ فعليّ تحت الإذن (`ق-٥٣٠`) — يُكتب مرّةً، وعليه يُخطَر المالك.
  firstEntryAt DateTime?

  logs SupportAccessLog[]

  @@index([companyId, status])
  @@map("support_access_grants")
}

/// كل طلب HTTP نفّذه الدعم أثناء نافذته — سطرٌ لا يُمحى يراه المالك.
/// **ولا مفتاحَ أجنبيّ إلى المنشأة عمداً** (`ق-٥٣١`) — يبقى بعد حذفها مع إذنه.
model SupportAccessLog {
  id        String @id @default(uuid())
  companyId String

  grantId String
  grant   SupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  /// **من دخل — لا من طلب** (`ق-٥٢٨`): كان الاسمُ يُقرأ من الإذن (`requestedByName`)،
  /// **فأيُّ مدير منصّةٍ يدخل بإذن غيره يُنسب إلى الطالب**. والحارسُ يردّ غيرَ
  /// الطالب بـ`403` — وهذا السطرُ يسمّي الداخلَ نفسَه في كل حال.
  actorId   String
  actorName String

  method String
  path   String
  at     DateTime @default(now())

  @@index([companyId, at])
  @@map("support_access_logs")
}

enum QuoteStatus {
  DRAFT
  SENT
  CONVERTED
}

/// عرض سعر (4.9): وثيقة تفاوض لا التزام — لا ترحيل ولا ضريبة مستحقة حتى
/// يتحوّل فاتورةً. «منتهي الصلاحية» يُشتق قراءةً من validUntil (نمط
/// الحجوزات — لا cron): DRAFT/SENT بعد تاريخه يُقرأ EXPIRED ويُرفض تحويله.
/// بنوده بشكل بنود الفاتورة حرفياً — فالتحويل نقلٌ لا إعادة إدخال.
model Quote {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// تسلسل مستقل تماماً عن INV/CN: يُشتق من جدول العروض نفسه (Q-YYYY-0001)
  /// — لكل نوع مستند عدّاده الخاص لكل منشأة (شرط صاحب المشروع).
  no         String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  customerTenant Customer @relation("Quote_customerId_tenant", fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("Quote_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  issueDate  DateTime @db.Date
  /// آخر يوم يصلح فيه التحويل — بعده يُعرض ويُرفض تحويله باسم تاريخه.
  validUntil DateTime @db.Date

  status QuoteStatus @default(DRAFT)
  notes  String?

  subtotal Decimal @db.Decimal(18, 2)
  taxTotal Decimal @db.Decimal(18, 2)
  total    Decimal @db.Decimal(18, 2)

  /// See Company.baseCurrency for the scheme these columns belong to.
  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseSubtotal Decimal @db.Decimal(18, 2)
  baseTaxTotal Decimal @db.Decimal(18, 2)
  baseTotal    Decimal @db.Decimal(18, 2)

  /// التحويل أحادي للأبد: فهرس فريد يمنع فاتورتين لعرضٍ واحد حتى تحت سباق
  /// نقرتين — الخاسر يقرأ الفائز ويعيد 409 باسم فاتورته (قرار 6.12).
  convertedInvoiceId String?  @unique
  convertedInvoice   Invoice? @relation(fields: [convertedInvoiceId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  convertedInvoiceTenant Invoice? @relation("Quote_convertedInvoiceId_tenant", fields: [companyId, convertedInvoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  convertedAt        DateTime?

  lines QuoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, no])
  @@index([companyId, status])
  @@map("quotes")
  quoteLine_quoteId_tenant QuoteLine[] @relation("QuoteLine_quoteId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

model QuoteLine {
  id        String @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  quoteTenant Quote @relation("QuoteLine_quoteId_tenant", fields: [companyId, quoteId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ رقمُ السطر في العرض — كـ`InvoiceLine.lineNo` (`ق-١٤١٢`): **فالعرضُ مصدرُ ترتيب فاتورته المحوَّلة**،
  /// وتحويلٌ يقرأ سطورَ العرض بلا ترتيب يكتب فاتورةً بترتيبٍ مصادَف.
  lineNo Int

  description String

  /// Carried for the same reason as `InvoiceLine.productId`: a quote that
  /// converts into an invoice must hand over *what* it quoted, not just its
  /// wording. Without it the item is re-picked by hand at conversion — and a
  /// mis-pick there is a wrong cost, not a wrong label.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product? @relation("QuoteLine_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Same scale as `InvoiceLine` deliberately: a quote that cannot express the
  /// quantity its invoice will carry turns every conversion into a rounding
  /// dispute with the customer.
  quantity    Decimal @db.Decimal(18, 3)
  /// وحدةُ الكمّية منسوخةً من الصنف لحظةَ الكتابة (كما في `InvoiceLine.unitCode`).
  unitCode    String?
  unitPrice   Decimal @db.Decimal(18, 6)
  /// ④B1 — خصمُ السطر مبلغاً (BT-136): صافي السطر = الكمية × السعر − الخصم (BT-131)؛ صفرٌ للقائم — صادقٌ لا افتراض.
  discount    Decimal @default(0) @db.Decimal(18, 2)
  /// ⑧ مشتقّةٌ من الفئة — كما `InvoiceLine.taxRate`.
  taxRate     Decimal @db.Decimal(5, 2)
  /// ⑧ الفئةُ والسبب منسوخَين لحظةَ كتابة العرض؛ والتحويلُ ينقلهما إلى الفاتورة كما نُقل الصنف.
  taxCategory TaxCategory
  taxExemptionReasonCode String?
  taxExemptionReason     String?
  /// أُضيف مع ⑧ ليحبس قيدُ `CHECK` القيمةَ القديمة `LEGACY_ZERO` على ما سبق الهجرة — كما `InvoiceLine`.
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([companyId, productId])
  @@unique([quoteId, lineNo])
  @@map("quote_lines")
}

/// One scheduled rent payment for a Contract, generated evenly across the
/// contract's cycle at creation time (see ContractsService.generateInstallments)
/// and re-derivable on demand. `status` auto-flips DUE -> LATE lazily (on
/// read, not via a background job — matches the mockup's `refreshInstallmentStatuses`).
model Installment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("Installment_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  dueDate DateTime          @db.Date
  amount  Decimal           @db.Decimal(18, 2)
  status  InstallmentStatus @default(DUE)
  notes   String?

  /// ⭐ **فترةُ الخدمة التي يغطّيها القسط — مخزَّنةٌ لا مشتقّة** (`ق-٤٧٥/②`).
  ///
  /// القسطُ يستحقّ في **أوّلِ** فترته (`generateInstallmentSchedule` يضع أولَه
  /// في `start` نفسِه)، **فكلُّ قبضٍ قبضٌ عن خدمةٍ لم تُقدَّم بعد** — وعليها
  /// وحدَها يُقسَم الإيرادُ على أشهره، لا على اسم الدورة (`ق-٤٧٤`).
  ///
  /// **ولماذا تُخزَّن**: اشتقاقُها من `dueDate` والدورة ممكنٌ اليوم، **لكنه
  /// يكذب متى عُدِّلت الدورةُ أو المدّةُ بعد التوليد** — فيعيد كتابة تاريخِ
  /// خدمةٍ لقيدٍ مُرحَّل (`ق-١٢٧`).
  ///
  /// ⚠️ **واختيارِيّتُها ليست تهاوناً**: صفوفُ ما قبل الترحيل عُبّئت باشتقاقٍ
  /// **من الجدول نفسِه** (بدايةُ التالي، أو نهايةُ العقد للأخير) — لا بتخمين.
  /// والفراغُ يبقى ممكناً لصفٍّ لا عقدَ له فيُقرأ «لا فترةَ معلومة» صراحةً.
  serviceStart DateTime? @db.Date
  serviceEnd   DateTime? @db.Date

  /// ما **خرج من الالتزام** من مقبوض هذا القسط، بعملة الدفتر (`ق-٤٦٨`).
  ///
  /// **والالتزامُ القائم = المقبوضُ − هذا.** فالتحوّلُ الشهريّ يقارن هدفَه
  /// التراكميّ بهذا الرقم ويُرحّل الفرق — **فتشغيلٌ مكرَّرٌ يُرحّل صفراً،
  /// وشهرٌ فائتٌ يُعوَّض في التشغيل التالي بتاريخه**.
  ///
  /// ⚠️ **والخارجُ ثلاثُ وجهاتٍ لا واحدة**: إيرادُ إيجارٍ شهراً بشهر (`4200`)،
  /// **أو ردٌّ للمستأجر، أو دخلٌ آخر عند الإلغاء** (`ق-٤٧٢`). **فالعدّادُ يقول
  /// «لم يعد التزاماً» لا «صار إيراداً»** — وحقلٌ يُقرأ في غير ما وُضع له
  /// يُنتج رقماً صحيحَ الشكل كاذبَ المعنى (`ق-٤٦١`).
  baseRecognized Decimal @default(0) @db.Decimal(18, 2)

  /// أساسُ القسط في الدفتر — انظر التعداد. الافتراضُ `ACCRUAL` لكلِّ صفٍّ يُنشأ بعد البناء،
  /// و`LEGACY_COLLECTED` لا يُكتب إلا من الهجرة (والقيدُ يحبسه على ما سبق لحظتها).
  accrualBasis InstallmentAccrualBasis @default(ACCRUAL)

  /// **ما استُحقّ من هذا القسط حتى الآن** بعملة الدفتر — مجموعُ صفوف `accruals` موقَّعاً
  /// (الإجماليُّ على `1200` · الصافي على `2400`/`4200` · الضريبةُ على `2200`). تُخزَّن
  /// تراكمياً كي يبقى الكنسُ اليوميّ انتقائياً (`baseAccruedGross < gross`) لا مسحاً.
  /// **والالتزامُ القائم لقسطٍ `ACCRUAL` = `baseAccruedNet − baseRecognized`.**
  baseAccruedGross Decimal @default(0) @db.Decimal(18, 2)
  baseAccruedNet   Decimal @default(0) @db.Decimal(18, 2)
  baseAccruedTax   Decimal @default(0) @db.Decimal(18, 2)
  /// **لا نقطةَ ضريبةٍ بعدها**: حلّ الاستحقاقُ وكُتب باقيه، أو غطّت المقدَّماتُ الإجماليَّ كلَّه.
  /// يُختم كي يبقى الكنسُ اليوميُّ انتقائياً (`IS NULL`) لا مسحاً يعيد فحصَ ما اكتمل.
  accrualCompletedAt DateTime?

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  payments  RentPayment[]
  reminders RentReminder[]
  accruals  RentAccrual[]
  /// ⚖️ مطالباتُ رسوم العقد التي حلّت مع هذا القسط (السؤال ٤٩ · ق-١٦٠٠).
  feeClaims ContractClaim[]

  /// For loading one contract's schedule (findOne) — Postgres does not index
  /// FK columns on its own, so at ~30k installments each lookup was a scan.
  @@index([contractId])
  /// For the lazy DUE→LATE refresh that runs on every contracts read.
  @@index([companyId, status, dueDate])
  /// الكنسُ اليوميّ للاستحقاق: ما حلّ ولم يُستحقّ بعد (`ق-٩٢٧/٥`).
  @@index([companyId, accrualBasis, dueDate])
  @@map("contract_installments")
  rentAccrual_installmentId_tenant RentAccrual[] @relation("RentAccrual_installmentId_tenant")
  rentPayment_installmentId_tenant RentPayment[] @relation("RentPayment_installmentId_tenant")
  rentReminder_installmentId_tenant RentReminder[] @relation("RentReminder_installmentId_tenant")
  contractClaim_installmentId_tenant ContractClaim[] @relation("ContractClaim_installmentId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// An actual collected rent payment. Always posts a journal entry (debit
/// cash, credit rental-revenue — ⚖️ `ق-١٤٦٦`: a missing account refuses the payment, named, like
/// Invoice/Purchase auto-posting; it is no longer soft-skipped) and, when paid via
/// bank transfer, also creates a matching BankTransaction (see
/// ContractsService.recordPayment) so it shows up in the Bank Transactions
/// screen too, not just the ledger.
/// دفعة مقبوضة من عميل (4.5). المبلغ يعيش هنا وحده — لا حقل مبلغ مدفوع على
/// الفاتورة إطلاقاً: «المدفوع» و«المتبقي» يُحسبان من التخصيصات في كل مرة.
/// الدفعة الواحدة قد توزَّع على عدة فواتير، والفاتورة قد تستقبل عدة دفعات.
model Payment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  no String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  customerTenant Customer @relation("Payment_customerId_tenant", fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// فرع الدفعة: هو من يحدد الصندوق الذي يدخله النقد.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("Payment_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  date   DateTime      @db.Date
  amount Decimal       @db.Decimal(18, 2)
  method PaymentMethod

  /// حساب البنك، أو صندوق الفرع النقدي (صندوق = Bank مربوط بفرع).
  bankId String?
  bank   Bank?   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank? @relation("Payment_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// رقم الحوالة/الشيك/المرجع لدى المزوّد.
  reference String?
  notes     String?

  /// See Company.baseCurrency for the scheme these columns belong to.
  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  /// دفعة مرحَّلة لا تُعدَّل ولا تُحذف — التصحيح بدفعة عكسية تشير للأصل.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("Payment_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الدفعة العكسية تحمل مبلغاً سالباً وتشير إلى ما تصحّحه.
  reversesId String?  @unique
  reverses   Payment? @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  reversesTenant Payment? @relation("Payment_reversesId_tenant", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy Payment? @relation("PaymentReversal")
  /// ④A1 — فاتورةُ الدفعة المقدَّمة (386) التي أصدرها فائضُ هذا السند غيرُ المخصَّص.
  prepaymentInvoice Invoice? @relation("PrepaymentInvoiceOfPayment")

  /// نوع السند (`SPEC 30.8`، قرار المالك 2026-09-03): `RECEIPT` مقبوضٌ من عميل · `REFUND` ردُّ
  /// مرتجعٍ نقداً — **سندٌ مستقل** مربوطٌ بإشعاره الدائن، يحمل مبلغاً سالباً (كالعكس) وليس عكساً
  /// لسند القبض: العكس يمحو واقعة، والدفتر وقائع لا حالات.
  kind PaymentKind @default(RECEIPT)

  /// للردّ وحده: الإشعار الدائن الذي يُردّ نقداً. `Restrict` — إشعارٌ رُدّ لا يُحذف.
  refundsInvoiceId String?
  refundsInvoice   Invoice? @relation("PaymentRefunds", fields: [refundsInvoiceId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  refundsInvoiceTenant Invoice? @relation("Payment_refundsInvoiceId_tenant", fields: [companyId, refundsInvoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  allocations PaymentAllocation[]

  /// تسويةُ الشبكة التي طالبت بهذا السند (طريقةُ الشبكة وحدَها — ق-١٢٦١ ج ⑦A2): فارغٌ = مفتوحٌ على 1251.
  /// `Restrict` — تسويةٌ لها سندات لا تُحذف؛ والإلغاءُ يُفرغ الحقل لا يحذف الصفّ.
  networkSettlementId String?
  networkSettlement   NetworkSettlement? @relation(fields: [networkSettlementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  networkSettlementTenant NetworkSettlement? @relation("Payment_networkSettlementId_tenant", fields: [companyId, networkSettlementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ مفتاحُ الطلب من رأس `Idempotency-Key` (توجيه ٢٧٦ · `ق-١٦٠٩`/ب) — فريدٌ في المنشأة: الطلبُ المكرّر يعيد هذا السندَ ولا يكتب ثانياً.
  clientRequestId String?

  createdAt DateTime @default(now())

  @@unique([companyId, no])
  @@unique([companyId, clientRequestId])
  @@index([companyId, customerId])
  @@index([refundsInvoiceId])
  @@map("payments")
  paymentAllocation_paymentId_tenant PaymentAllocation[] @relation("PaymentAllocation_paymentId_tenant")
  payment_reversesId_tenant Payment[] @relation("Payment_reversesId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
  invoice_prepaymentPaymentId_tenant Invoice[] @relation("Invoice_prepaymentPaymentId_tenant")
}

/// انظر `Payment.kind`.
enum PaymentKind {
  RECEIPT
  REFUND
}

/// تخصيص جزء من دفعة لفاتورة بعينها — هو مصدر الحقيقة الوحيد لـ«المدفوع».
/// صفٌّ واحد لكل (دفعة، فاتورة): إعادة التخصيص تحدّث المبلغ لا تكرّر الصف.
model PaymentAllocation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  paymentTenant Payment @relation("PaymentAllocation_paymentId_tenant", fields: [companyId, paymentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  invoiceTenant Invoice @relation("PaymentAllocation_invoiceId_tenant", fields: [companyId, invoiceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// ⭐ **سندُ صرفٍ لمورّد — مستندٌ يُرحَّل لا علَمٌ على الصفّ** (`ق-٨٦٦` · `ق-٨٧١`).
///
/// **مرآةُ `Payment` في جدولٍ مستقلّ عمداً** — لا نوعٌ ثالثٌ فيه: `Payment.customerId`
/// إلزاميٌّ بـ`Restrict` وهو ما يحمي رياضياتِ ذمم العملاء (أعمارُ الذمم تقرأ جدولَ
/// الدفعات **بلا مرشّح نوع**)؛ فتوسيعُه يُنزع عنه `NOT NULL` ويُدخل سندَ مورّدٍ في
/// تقريرِ ذممِ عملاءَ بمفتاحٍ فارغ — خطأٌ صامتٌ في تقريرٍ يراه التاجر. **والفصلُ يجعله
/// مستحيلاً بنيةً.** والمسارُ واحد (تخصيصٌ بقفلِ صفّ · حالةٌ مشتقّة · عكسٌ لا حذف ·
/// ترقيمٌ ذرّيّ) **مستخرَجٌ في `common/settlement` لا منسوخ** — شرطُ القبول.
///
/// القيد: مدين `2100` (الذمّة المسوّاة بسعر **فاتورة الشراء**) · دائن نقد/بنك (بسعر
/// يوم السداد) · والفارقُ صرفٌ محقَّق على `5600`. **والفائضُ غيرُ المخصَّص «دفعةٌ على
/// الحساب»**: يمدين `2100` كاملاً فيصير رصيدُ المورّد فيه **مديناً** (رصيدٌ لنا عليه)
/// حتى يُخصَّص على شراءٍ لاحق — لا حسابَ أصلٍ ثانياً له.
model SupplierPayment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  no String

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  supplierTenant Supplier @relation("SupplierPayment_supplierId_tenant", fields: [companyId, supplierId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// فرع السند — والقيدُ يُختم به.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("SupplierPayment_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  date   DateTime      @db.Date
  amount Decimal       @db.Decimal(18, 2)
  method PaymentMethod

  /// حسابُ البنك المسدِّد، أو صندوقُ الفرع (صندوق = Bank مربوط بفرع). **ولا درج**:
  /// الدرجُ للكاشير لا للمورّد (`ق-٨٧٢`) — ومن يدفع نقداً بلا صندوقٍ مسمّى يدفع من `1000`.
  bankId String?
  bank   Bank?   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank? @relation("SupplierPayment_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// رقم الحوالة/الشيك/المرجع لدى البنك.
  reference String?
  notes     String?

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(18, 2)

  /// سندٌ مرحَّل لا يُعدَّل ولا يُحذف — التصحيحُ بسندٍ عاكس يشير إلى الأصل.
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("SupplierPayment_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// السندُ العاكس يحمل مبلغاً سالباً ويشير إلى ما يصحّحه.
  reversesId String?          @unique
  reverses   SupplierPayment? @relation("SupplierPaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  reversesTenant SupplierPayment? @relation("SupplierPayment_reversesId_tenant", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy SupplierPayment? @relation("SupplierPaymentReversal")

  allocations SupplierPaymentAllocation[]

  /// ⚖️ مفتاحُ الطلب من رأس `Idempotency-Key` (توجيه ٢٧٦ · `ق-١٦٠٩`/ب) — فريدٌ في المنشأة كسند القبض.
  clientRequestId String?

  createdAt DateTime @default(now())

  @@unique([companyId, no])
  @@unique([companyId, clientRequestId])
  @@index([companyId, supplierId])
  @@map("supplier_payments")
  supplierPaymentAllocation_paymentId_tenant SupplierPaymentAllocation[] @relation("SupplierPaymentAllocation_paymentId_tenant")
  supplierPayment_reversesId_tenant SupplierPayment[] @relation("SupplierPayment_reversesId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// تخصيصُ جزءٍ من سند صرفٍ لفاتورة شراءٍ بعينها — مصدرُ الحقيقة الوحيد لـ«المسدَّد»
/// (مرآةُ `PaymentAllocation`). صفٌّ واحد لكل (سند، فاتورة).
model SupplierPaymentAllocation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  paymentTenant SupplierPayment @relation("SupplierPaymentAllocation_paymentId_tenant", fields: [companyId, paymentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase @relation("SupplierPaymentAllocation_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, purchaseId])
  @@index([purchaseId])
  @@map("supplier_payment_allocations")
}

model RentPayment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("RentPayment_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  installmentTenant Installment? @relation("RentPayment_installmentId_tenant", fields: [companyId, installmentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ **خصمٌ من رصيد المستأجر لا قبضُ نقد** (توجيه ٢٧٨ · `ق-١٦٢٩`): العقدُ الأصل الذي نُقل منه رصيدُ المستأجر إلى أوّل قسطٍ في تجديده؛
  /// فارغٌ لكلِّ قبضٍ نقديّ. والصفُّ بلا بنكٍ ولا حركةِ صندوق، وطريقتُه طريقةُ القبض الذي أنشأ الرصيد.
  creditFromContractId String?
  creditFromContract   Contract? @relation("RentPaymentCreditFrom", fields: [creditFromContractId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  creditFromContractTenant Contract? @relation("RentPayment_creditFromContractId_tenant", fields: [companyId, creditFromContractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  date       DateTime      @db.Date
  amount     Decimal       @db.Decimal(18, 2)
  discount   Decimal       @default(0) @db.Decimal(18, 2)
  netAmount  Decimal       @db.Decimal(18, 2)
  method     PaymentMethod

  currency      String  @default("SAR")
  exchangeRate  Decimal @default(1) @db.Decimal(18, 6)
  baseAmount    Decimal @db.Decimal(18, 2)
  baseDiscount  Decimal @default(0) @db.Decimal(18, 2)
  baseNetAmount Decimal @db.Decimal(18, 2)

  /// ⚖️ **قبضٌ لعقدٍ مؤجّرُه المالك** (السؤال ٥٧٧ · `ق-١٦٠٠`) — فارغةٌ لغيره. بعملة الدفتر، من `baseNetAmount`:
  /// ضريبةُ المالك فيه (للتجاريّ) · العمولةُ على الباقي بنسبة العقار لحظةَ القبض · ضريبتُها · وحصّةُ المالك.
  /// **والإقرارُ يقرأ العمولةَ هنا توريداً خاضعاً بتاريخ القبض، ويعدّ المقبوضَ للمالك ولا يُدخله.**
  commissionRate    Decimal? @db.Decimal(5, 2)
  baseOwnerVat      Decimal? @db.Decimal(18, 2)
  baseCommission    Decimal? @db.Decimal(18, 2)
  baseCommissionTax Decimal? @db.Decimal(18, 2)
  baseOwnerShare    Decimal? @db.Decimal(18, 2)

  bankId String?
  bank   Bank?   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  bankTenant Bank? @relation("RentPayment_bankId_tenant", fields: [companyId, bankId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  notes String?

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("RentPayment_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  /// الاستحقاقاتُ التي أنشأتها هذه الدفعة (مقدَّمةٌ أو بلا قسط) أو خصمُها.
  accruals RentAccrual[]

  /// ⚖️ مفتاحُ الطلب من رأس `Idempotency-Key` (توجيه ٢٧٦ · `ق-١٦٠٩`/ب) — على الجزء الأوّل وحدَه حين يُوزَّع القبضُ أجزاءً،
  /// فريدٌ في المنشأة: القبضُ المكرّر يعيد هذا القبضَ ولا يكتب ثانياً.
  clientRequestId String?

  /// Same reasoning as Installment's contractId index.
  @@index([contractId])
  @@unique([companyId, clientRequestId])
  /// NOT for the property-KPIs aggregate — that subquery groups the whole
  /// company's payments with no predicate on installmentId, so Postgres
  /// hash-aggregates a seq scan and never touches this index, at any size
  /// (verified with EXPLAIN ANALYZE). It exists for the FK: installmentId is
  /// ON DELETE SET NULL, and the referential-integrity trigger fires once per
  /// deleted installment row — without an index each firing scans this whole
  /// table (measured: 60,000 scans for 60,000 deleted installments).
  @@index([installmentId])
  /// للمفتاح: `creditFromContractId` بـ`SET NULL`، فلا يمسح الحذفُ الجدولَ كلَّه لكلِّ عقد.
  @@index([creditFromContractId])
  @@map("rent_payments")
  rentAccrual_paymentId_tenant RentAccrual[] @relation("RentAccrual_paymentId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⭐ **صفُّ استحقاق الإيجار — ما يقرؤه الدفترُ والإقرارُ معاً** (`ق-٩١٧` · `ق-٩٢٧/١`).
///
/// **نقطةُ الضريبة** لكلِّ مبلغٍ (م٢٠): الأسبقُ من استحقاق القسط وسداده — وبقدر المقبوض
/// حين يسبق السدادُ الاستحقاقَ (`ق-٩٢٤`)، فالقسطُ الواحد قد يحمل أكثرَ من صفّ. **قيدٌ واحد
/// لكلِّ صفّ** (`1200` إجمالاً ⇄ `2400`/`4200` صافياً + `2200` ضريبةً) **والإقرارُ يجمع
/// الصفوفَ بتاريخها** — فيستوي الدفترُ والإقرارُ بالبناء لا بحارسٍ يعلن فرقَهما (`ق-٩١٥`).
///
/// **المبالغُ موقَّعة**: `REVERSAL` و`DISCOUNT` سالبة — فربعُ الإلغاء يُنقص كما يُنقص الإشعارُ
/// الدائن، ولا يُعدَّل صفٌّ رُحِّل. **والتصنيفُ وقابليةُ الضريبة لقطةٌ لحظةَ الاستحقاق**: عقارٌ
/// يتغيّر تشغيلُه لاحقاً لا يعيد كتابةَ إقرارٍ مضى.
model RentAccrual {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  contractTenant Contract @relation("RentAccrual_contractId_tenant", fields: [companyId, contractId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// فارغٌ لدفعةٍ بلا قسط (`UNLINKED`).
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  installmentTenant Installment? @relation("RentAccrual_installmentId_tenant", fields: [companyId, installmentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الدفعةُ التي أنشأت الصفّ — لمقدَّمةٍ أو بلا قسطٍ أو خصم.
  paymentId String?
  payment   RentPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  paymentTenant RentPayment? @relation("RentAccrual_paymentId_tenant", fields: [companyId, paymentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  kind RentAccrualKind
  /// نقطةُ الضريبة — تاريخُ القيد وتاريخُ الإقرار معاً.
  date DateTime @db.Date

  /// لقطةُ التصنيف: `RESIDENTIAL` معفى · `COMMERCIAL` و`SERVICED_LODGING` خاضع · `MIXED` بجزأيه (`baseExemptNet`) — ولا صفَّ
  /// لعقدٍ غيرِ مصنَّف.
  classification ContractClassification
  /// خاضعٌ فعلاً: تجاريٌّ **و**العقارُ `owned`/`leased`؛ و`managed` تجاريٌّ بلا ضريبة
  /// (توريدُ مالكه — `ق-٩١٨`) يُعدّ في الإقرار ولا يدخله.
  taxable Boolean
  /// عقارُ تشغيل — يُعدّ ويُعلَن.
  managed Boolean @default(false)

  /// بعملة العقد: الإجماليُّ (ما يدين به المستأجر) · الصافي (الإيراد) · الضريبة.
  amountGross Decimal @db.Decimal(18, 2)
  amountNet   Decimal @db.Decimal(18, 2)
  amountTax   Decimal @db.Decimal(18, 2)

  currency     String  @default("SAR")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  /// وبعملة الدفتر — وهي ما يُرحَّل ويُقرأ في الإقرار.
  baseGross Decimal @db.Decimal(18, 2)
  baseNet   Decimal @db.Decimal(18, 2)
  baseTax   Decimal @db.Decimal(18, 2)
  /// ⚖️ المختلطُ وحدَه (السؤال ٤١٢): الجزءُ المعفى من `baseNet` بعملة الدفتر — والخاضعُ ما بقي. فارغٌ لغير المختلط، وقيدُ
  /// `rent_accruals_exempt_part_mixed` يُلزم الاقترانَ. يقرؤه الإقرارُ من الصفّ الذي رُحّل منه القيد.
  baseExemptNet Decimal? @db.Decimal(18, 2)

  /// فارغٌ حين تخطّى الترحيلُ لنقص حسابٍ في الدليل — ويُعدّ في الإقرار «بلا قيد» لا يُخفى.
  journalEntryId String?
  journalEntry   JournalEntry? @relation("RentAccrualEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("RentAccrual_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  /// الإقرارُ يقرأ ربعَ سنةٍ بتاريخ نقطة الضريبة.
  @@index([companyId, date])
  @@index([installmentId])
  @@index([contractId])
  @@map("rent_accruals")
}

/// ⑥A2 (`ق-١٣٢٥`) — الفترةُ الضريبية: ربعيةٌ هي الأصل، وشهريةٌ فوق أربعين مليوناً.
enum VatPeriod {
  QUARTERLY
  MONTHLY
}

/// ⑥A1 (`ق-١٣٢٥` · `ق-٨٢٤`/①) — **إسنادُ ضريبة المدخلات إلى ما استُعملت فيه.**
///
/// م٥١/١–٣: ما نُسب **حصراً ومباشرةً** للتوريد الخاضع يُخصم كاملاً · وللمعفى **لا يُخصم** ·
/// وما استُعمل فيهما أو لا يُنسب مستقلاً **يُخصم نسبياً**. **ولا خصمَ كاملاً بلا إسناد.**
enum InputVatUse {
  /// منسوبٌ حصراً ومباشرةً لتوريدٍ خاضع — يُخصم كاملاً.
  TAXABLE_ONLY
  /// منسوبٌ حصراً ومباشرةً لتوريدٍ معفى — لا يُخصم منه شيء.
  EXEMPT_ONLY
  /// مشتركٌ بينهما أو لا يُنسب مستقلاً — يُخصم بنسبة الخصم النسبيّ.
  MIXED
  /// **ما سبق البناء**: شراءٌ سُجّل قبل وجود الإسناد. **يُعامَل معاملةَ المشترك**
  /// (فلا خصمَ كاملاً بلا إسناد) **ويُعدّ ويُعلَن** حتى يُصنَّف. وقيدُ `CHECK` على
  /// `createdAt` يمنع صفّاً جديداً أن يأخذها.
  LEGACY_UNASSIGNED
}

/// ⑥A1 — من أين جاءت نسبةُ السنة: محسوبةً من سنةٍ تقويميةٍ ماضيةٍ في النظام، أو مقدَّرةً يُعلنها التاجر.
enum VatRatioBasis {
  /// م٥١/٤ — الطريقةُ الافتراضية: خاضعُ السنة الماضية ÷ (خاضعٌ + معفى).
  COMPUTED
  /// م٥١/٦ — من لا سنةَ ماضيةَ له: **القيمُ المقدَّرة للسنة الحالية**، يُعلنها التاجر.
  ESTIMATED
}

/// ⑥A1 (`ق-١٣٢٥`) — **نسبةُ الخصم النسبيّ المطبَّقة في سنةٍ تقويمية** (م٥١/٤–٧).
///
/// ⚠️ **تُعلَن ولا تُكتب آلياً**: بياناتُنا قد لا تغطّي السنةَ الماضية كلَّها (منشأةٌ انتقلت
/// إلينا في منتصفها)، **ونسبةٌ من بياناتٍ ناقصة رقمٌ خاطئٌ بلا عَرَض**. فالخادمُ **يحسب
/// ويعرض** المقترَح بأرقامه، **والتاجرُ يُعلن** ما يطبّقه — وبلا إعلانٍ يُعلَن حدٌّ حاجب.
///
/// والتسويةُ (م٥١/٧) **تُحسب في الإقرار الأخير من السنة** من توريدات السنة نفسِها، فلا
/// تُخزَّن — **ويُخزَّن أنها أُقرّت**.
///
/// **بلا أبٍ** (`ق-٥٠١`) — إعلانٌ للمنشأة عن سنةٍ تقويمية، لا ابنَ لمستندٍ ولا لطرف:
/// مصدرُه قرارُ التاجر لا صفٌّ آخر، فلا سلسلةَ حذفٍ تجرّه غيرَ حذف المنشأة نفسِها.
model VatProportionalRatio {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// السنةُ التقويمية التي تُطبَّق فيها هذه النسبة.
  year  Int
  /// `0.000000`–`1.000000` — ستُّ خاناتٍ تكفي لنسبةٍ تُضرب في مبالغَ بخانتين.
  ratio Decimal @db.Decimal(9, 6)
  basis VatRatioBasis
  /// أرقامُ الحساب كما كانت لحظةَ الإعلان — فمن يقرأ بعد سنةٍ يعرف **ممّ** جاءت النسبة.
  note  String?

  /// إقرارُ التسوية السنوية (م٥١/٧): نسبةُ السنة الفعلية كما قُرئت لحظةَ الإقرار، ولحظتُه.
  settledRatio Decimal? @db.Decimal(9, 6)
  settledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year])
  @@map("vat_proportional_ratios")
}

/// **بلا أبٍ** (`ق-٥٠١`) — كيانٌ جذريّ يملكه التاجر: وسمٌ يضعه على فترةٍ (ربعٍ أو شهر — ⑥A2) **ويرفعه
/// بنفسه**، ولا مستندَ يحذفه معه؛ لا ابنَ لمستندٍ ولا لطرف.
///
/// ⭐ **علَمُ «قُدِّم» على الفترة** (`ق-٩١٩`): سطرٌ واحد يضعه التاجرُ بيده — فالنظامُ لا يعرف ما
/// قُدِّم للهيئة. بلاه تُعرض رسالةُ التصحيح لكلِّ فترةٍ تغيّر رقمُها فتصير ضجيجاً يُتجاهَل؛ وبه تُعرض
/// لمن قدّم وحدَه، مع صافي ما قُدِّم لتُقارَن به قراءةُ اليوم — **ونصُّها من `filedChangeNote`** (م٦٣: نقصٌ
/// يوجب الإشعارَ خلال عشرين يوماً إلا ما دون خمسة آلاف ريال فيُستدرك في التالي؛ وزيادةٌ تُصحَّح في أيّ لاحق).
///
/// ⚠️ **وانفصل هذا التوثيقُ عنه مرّةً**: أُدخل `enum VatPeriod` بينهما (`ق-١٣٢٥`) فأمسك الحارسُ غيابَ الإعلان،
/// **فكُتب له إعلانٌ بديل وبقي هذا النصُّ فوق التعداد يصفه خطأً** — حتى رُئي (2026-09-23) وأُعيد. **نقلُ
/// نموذجٍ يقطع توثيقَه عنه، والنصُّ لا يشكو.**
model VatReturnFiling {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year    Int
  /// ⑥A2 — **نوعُ الفترة ورقمُها معاً**: `QUARTERLY` بـ`1..4` أو `MONTHLY` بـ`1..12`.
  /// وكان المفتاحُ `(companyId, year, quarter)` ربعاً حتماً؛ والهجرةُ تنقل القائمَ
  /// `quarter ⟵ periodNo` بنوع `QUARTERLY` وتعدّ وتصرخ.
  periodType VatPeriod @default(QUARTERLY)
  periodNo   Int
  /// لحظةُ الوسم — التاجرُ يضعه بعد التقديم فعلاً.
  filedAt DateTime @default(now())
  /// صافي الضريبة كما قرأته الشاشةُ لحظةَ الوسم — المرجعُ الذي يُقاس عليه «تغيّر بعد التقديم».
  netVat  Decimal  @db.Decimal(18, 2)
  /// ⑥A3 (`ق-١٣٢٥`) — **أطُلب ردُّ الفائض أم يُرحَّل؟**
  ///
  /// النصّ: «The Taxable Person **may request** excess Tax to be refunded, **otherwise
  /// excess Tax will be carried forward** in the VAT account». ⇒ **فالترحيلُ هو الأصل**
  /// والردُّ طلبٌ يُعلنه التاجر. وتحتاجه الفترةُ التالية لتعرف: أبقي الفائضُ رصيداً أم خرج؟
  /// **ولا يُخمَّن** — فلو خُمِّن ترحيلاً وقد طُلب ردُّه لحُسب الفائضُ مرّتين.
  refundRequested Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, year, periodType, periodNo])
  @@map("vat_return_filings")
}

/// ⑥A3 (`ق-١٣٢٥`) — **تصحيحُ إقرارٍ سابق من خلال إقرارٍ لاحق** (م٦٣، وخانةُ م٦٢/٢/ي).
///
/// **النصّ بفقراته** (اللائحةُ التنفيذية · `CORRECTION OF RETURNS`):
///   ف١ · نقصٌ في الضريبة المستحقّة ⟵ **إشعارُ الهيئة خلال عشرين يوماً** بتقديم تصحيح،
///        إلّا ما تشمله ف٣ ويلتزم به المكلَّف.
///   ف٢ · زيادةٌ في الضريبة المستحقّة ⟵ **يجوز تصحيحُها في أيِّ إقرارٍ لاحق**.
///   ف٣ · نقصٌ **دون خمسة آلاف ريال** ⟵ **يجوز تعديلُه في الإقرار التالي**.
///   ف٤ · لا تصحيحَ لزيادةٍ **بعد خمس سنوات** من نهاية السنة التقويمية لتلك الفترة.
///
/// **والموجبُ زيادةٌ في الضريبة المستحقّة** (نقصٌ سابقٌ يُستدرك) **والسالبُ نقصٌ منها**
/// (زيادةٌ سابقةٌ تُردّ) — فإشارةُ الصفّ هي إشارتُه في الصافي.
///
/// **بلا أبٍ** (`ق-٥٠١`) — **سجلٌّ لا يُحذف**: إعلانٌ عن فترتَين بأرقامهما، لا ابنَ لمستندٍ
/// ولا لطرف. ويُسحب قبل التقديم وحدَه؛ وبعده يُصحَّح بتصحيحٍ جديد لا بمحوٍ.
model VatReturnCorrection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// الفترةُ التي يُعلَن فيها التصحيح — أي الإقرارُ الذي يحمله.
  year       Int
  periodType VatPeriod
  periodNo   Int

  /// الفترةُ المصحَّحة — سابقةٌ للتي تحمله.
  correctedYear       Int
  correctedPeriodType VatPeriod
  correctedPeriodNo   Int

  /// موجبٌ: نقصٌ سابقٌ يُستدرك (تزيد الضريبةُ المستحقّة) · سالب: زيادةٌ سابقةٌ تُردّ.
  amount Decimal @db.Decimal(18, 2)
  reason String

  declaredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // الفهرسُ على الفترة الحاملة — فقراءةُ الإقرار تقرأ تصحيحاتِه وحدَها.
  @@index([companyId, year, periodType, periodNo])
  @@map("vat_return_corrections")
}

/// ⚖️ `ق-١٣٦٠` — نوعُ حدث الإقفال.
enum VatClosingKind {
  /// إقفالُ فترة إقرار: المشتركُ يُرحَّل بنسبة الفترة المطبَّقة.
  CLOSING
  /// التسويةُ السنوية (م٥١/٧): المشتركُ يُعاد بنسبة السنة الفعلية — «حدثٌ مثلُه».
  ANNUAL_ADJUSTMENT
  /// عكسُ إقفالٍ أو تسوية — «ولا يُرفع إلا بحدثٍ عاكسٍ بتاريخه».
  REVERSAL
}

/// ⚖️ **`ق-١٣٦٠` — «إقفالُ الإقرار» حدثٌ مستقلٌّ بتاريخه** (الخيارُ (ب) بحكم المالك).
///
/// **بنصّ المالك**: «حدثٌ مستقلٌّ «إقفالُ الإقرار» بتاريخ الحدث نفسِه في أوّل فترةٍ مفتوحة. ⇒ فتغيّرُ التقدير يُثبَت في فترته
/// لا بأثرٍ رجعيّ، ولا يُعلَّق على علَمٍ يرفعه التاجرُ بيده. ⚠️ ولا يُرفع إلا بحدثٍ عاكسٍ بتاريخه، والتسويةُ السنويةُ حدثٌ مثلُه.»
///
/// ما يفعله: الضريبةُ **المشتركة** (`MIXED`) لمستندات الفترة يُرحَّل غيرُ القابل منها للخصم (`ضريبة × (1 − النسبة)`) إلى تكلفة ما
/// اشتُري **بقاعدة الانتشار** (`non-deductible-vat.util` — الحكمُ المبنيّ في `ق-١٣٤٢`) **بتاريخ الحدث** لا بتاريخ المستند. والنسبةُ
/// **نسبةُ الفترة كما يحسبها الإقرار** (واحدٌ لمن لا توريدَ معفى له فيها · المعلَنةُ لغيره). ⛔ **وليس علَمَ «قُدِّم»**
/// (`VatReturnFiling` — يرفعه التاجرُ بيده): هذا حدثٌ لا يُمحى، وعكسُه حدثٌ ثانٍ بتاريخه (`reversesId`).
///
/// **بلا أبٍ** (`ق-٥٠١`) — حدثٌ للمنشأة عن فترتها، لا ابنَ لمستندٍ ولا لطرف؛ وأحداثُ الضريبة التي أطلقها تشير إليه.
model VatReturnClosing {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind VatClosingKind
  year Int
  /// فترةُ الإقرار للإقفال — وفارغان للتسوية السنوية (سنتُها كلُّها)؛ والعكسُ يرث ما يعكسه.
  periodType VatPeriod?
  periodNo   Int?
  /// مدى ما يمسّه الحدث — أوّلُ يومٍ فيه وآخرُه (الفترةُ للإقفال · السنةُ للتسوية).
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date
  /// النسبةُ المطبَّقة (`0`–`1`): نسبةُ الفترة للإقفال · نسبةُ السنة الفعلية للتسوية · وللعكس نسبةُ ما يعكسه.
  ratio Decimal @db.Decimal(9, 6)
  /// تاريخُ الحدث — تاريخُ قيوده، يومَ وقوعه (فيقع في أوّل فترةٍ مفتوحة، ويخضع للقفل كأيّ قيد).
  date DateTime @db.Date

  /// ما يعكسه هذا الحدث — فريد: لا يُعكس حدثٌ مرّتين.
  reversesId String?           @unique
  reverses   VatReturnClosing? @relation("VatClosingReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  reversesTenant VatReturnClosing? @relation("VatReturnClosing_reversesId_tenant", fields: [companyId, reversesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy     VatReturnClosing? @relation("VatClosingReversal")

  /// مستنداتٌ مشتركةٌ في المدى رُحّل فرقُها بهذا الحدث · وما سبق تتبّعَ غير القابل للخصم منها (يُعدّ ولا يُحوَّل — `ق-١١٧٨`).
  documentsCount Int
  untrackedCount Int
  /// صافي ما خرج من `1250` بهذا الحدث — سالبٌ حين يعود إليه.
  baseAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  nonDeductibleVatEvents NonDeductibleVatEvent[]

  @@index([companyId, year])
  @@map("vat_return_closings")
  vatReturnClosing_reversesId_tenant VatReturnClosing[] @relation("VatReturnClosing_reversesId_tenant")
  nonDeductibleVatEvent_vatReturnClosingId_tenant NonDeductibleVatEvent[] @relation("NonDeductibleVatEvent_vatReturnClosingId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// A storage location. `manager` is a free-text name, not a real Employee FK
/// (matches the mockup — no dedicated warehouse-staff assignment feature).
/// Deleting a warehouse that still has any stock movement referencing it —
/// as either the source or the transfer destination — is blocked
/// (`onDelete: Restrict` on both `StockMovement.warehouse` and
/// `.toWarehouse`), unlike the mockup, which allows it and leaves movements
/// pointing at a warehouse id that no longer exists.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: تشير إليه الحركاتُ ولا يشير إلى أحد.
model Warehouse {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  location String?
  manager  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movementsFrom StockMovement[] @relation("MovementSourceWarehouse")
  movementsTo   StockMovement[] @relation("MovementDestinationWarehouse")
  branches      Branch[]


  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  inventoryLayers InventoryLayer[]
  writeOffs       InventoryWriteOff[]
  goodsReceipts   GoodsReceipt[]

  @@map("warehouses")
  inventoryWriteOff_warehouseId_tenant InventoryWriteOff[] @relation("InventoryWriteOff_warehouseId_tenant")
  inventoryLayer_warehouseId_tenant InventoryLayer[] @relation("InventoryLayer_warehouseId_tenant")
  stockMovement_toWarehouseId_tenant StockMovement[] @relation("StockMovement_toWarehouseId_tenant")
  stockMovement_warehouseId_tenant StockMovement[] @relation("StockMovement_warehouseId_tenant")
  goodsReceipt_warehouseId_tenant GoodsReceipt[] @relation("GoodsReceipt_warehouseId_tenant")
  branch_warehouseId_tenant Branch[] @relation("Branch_warehouseId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

/// A single stock-ledger entry — there is no separate materialized
/// stock-balance table (the mockup declares one, `stockLevels`, but never
/// actually writes to it — dead code). Current on-hand quantity for a
/// product/warehouse pair is always computed live by summing movements
/// (`InventoryService.stockQty`), the same "compute, don't store" pattern
/// already used for Unit status elsewhere in this app. `qty` is always
/// positive for IN/OUT/TRANSFER (the `type` implies the sign); for
/// ADJUSTMENT it's the signed net change itself (matches the mockup).
model StockMovement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product @relation("StockMovement_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation("MovementSourceWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  warehouseTenant Warehouse @relation("StockMovement_warehouseId_tenant", fields: [companyId, warehouseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Only set when type === TRANSFER (the destination warehouse); null otherwise.
  toWarehouseId String?
  toWarehouse   Warehouse? @relation("MovementDestinationWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  toWarehouseTenant Warehouse? @relation("StockMovement_toWarehouseId_tenant", fields: [companyId, toWarehouseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("StockMovement_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  type   StockMovementType
  /// The stock ledger's quantity — and the one that must never round, because
  /// every other quantity in the system is reconciled against it. Carries no
  /// cost column on purpose: a movement records *how much moved*, not what it
  /// was worth. Valuation belongs to layered costing, not here.
  qty    Decimal  @db.Decimal(18, 3)
  reason String?
  date   DateTime @db.Date

  /// Batch/lot number and expiry — set on receiving (IN) movements for
  /// perishables (medicines, food, cosmetics). Optional: non-perishable stock
  /// leaves them null. Kept on the movement, not the product, because the same
  /// product arrives in many batches with different expiry dates.
  batchNo    String?
  expiryDate DateTime? @db.Date

  /// ⭐ **سبب الحركة — والمستند الذي سبّبها، بمفتاحٍ حقيقي لا بمرجعٍ نصّي.**
  ///
  /// العطل الذي يمنعه: الكاشير كان يعرف الصنف ثم يحتفظ باسمه وحده، فتخرج
  /// البضاعة من الرفّ ولا يقول المستند ماذا خرج. أُصلح المسار في `م١` —
  /// **والمسار التالي كان سيكرّره** ما دام المنع انضباطاً يُتذكَّر.
  ///
  /// وعمودان منفصلان بمفتاحين أجنبيين، لا `sourceLineId` متعدّد الأشكال:
  /// عدد أنواع السطور المسبِّبة **اثنان** (مقيس — `productId` يرد على أربعة
  /// نماذج، و`QuoteLine` عرضٌ لا حركة، و`StockMovement` هو نفسه). ومفتاحٌ
  /// حقيقي **يجعل المرجع غير القابل للحلّ مستحيلاً**: لا سطرَ محذوف ولا نوعَ
  /// مجهول — بينما مرجعٌ نصّي يُكتب خطأً **فيصمت**.
  ///
  /// ⚠️ ولو صار الاستلام كياناً مستقلاً في `م٥` صار العدد ثلاثة — فيُضاف
  /// عمود ويُوسَّع الشرط، **وإضافة عمود لا تعيد كتابة الجدول** (مقيس في `م٢`).
  origin MovementOrigin @default(MANUAL)

  invoiceLineId String?
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  invoiceLineTenant InvoiceLine? @relation("StockMovement_invoiceLineId_tenant", fields: [companyId, invoiceLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  purchaseLineId String?
  purchaseLine   PurchaseLine? @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseLineTenant PurchaseLine? @relation("StockMovement_purchaseLineId_tenant", fields: [companyId, purchaseLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ٢٥ سطرُ الاستلام الذي أدخل هذه البضاعة (أو أخرجها عكساً) — **مع** `purchaseLineId` لا بدلَه (فالعدُّ
  /// «اثنان» أعلاه بقي: مصدرُ الحركة سطرُ الشراء، والاستلامُ مستندُ الوصول). قيدُ `CHECK`: لا يُملأ إلا على
  /// `RECEIPT`، والمُشغِّلُ يوجب أن يكون سطرُ الاستلام على سطر الشراء نفسِه. `null` لحركات ما قبل البناء
  /// التي لم تُكتب لها صفوفُ استلام (الحركاتُ الخارجة القديمة) ولحركات الإعادة إلى المورّد.
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  goodsReceiptLineTenant GoodsReceiptLine? @relation("StockMovement_goodsReceiptLineId_tenant", fields: [companyId, goodsReceiptLineId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())

  consumptions InventoryConsumption[]
  layers       InventoryLayer[]
  writeOff     InventoryWriteOff? @relation("WriteOffMovement")
  /// ٣٠ سطرُ الإعلان الافتتاحيّ الذي أدخل هذه الحركة — أو الذي عكسته.
  openingLine     StockOpeningLine? @relation("OpeningLineMovement")
  openingLineVoid StockOpeningLine? @relation("OpeningLineVoidMovement")

  /// ㉙ عكسُ حركةٍ سابقة (ق-١٠٦٣): حركةٌ مقابلة تشير إلى أصلها — لا حذف؛ فريدٌ فلا يُعكَس أصلٌ مرّتين، و`Restrict` فلا يُحذف.
  reversalOfId String?        @unique
  reversalOf   StockMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  reversalOfTenant StockMovement? @relation("StockMovement_reversalOfId_tenant", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy   StockMovement? @relation("MovementReversal")

  /// ⚖️ ق-١٣٦٣ — **قيدُ الحركة اليدوية** (فروقاتُ المخزون ⇄ `1300`) — نقضٌ لـ«ولا قيدَ في الدفتر — كما لم يكن للحركة اليدوية قيد».
  /// `null` لما سبق البناء (يُعدّ ولا يُحوَّل) · وللتحويل (لا قيمةَ تغادر المخزون) · ولحركات المستندات (قيدُها على مستندها).
  journalEntryId String?
  journalEntry   JournalEntry? @relation("ManualStockEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("StockMovement_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiryDate])
  @@index([companyId, productId, warehouseId])
  @@index([invoiceLineId])
  @@index([purchaseLineId])
  @@index([goodsReceiptLineId])
  @@index([journalEntryId])
  @@map("stock_movements")
  inventoryWriteOff_movementId_tenant InventoryWriteOff[] @relation("InventoryWriteOff_movementId_tenant")
  inventoryConsumption_movementId_tenant InventoryConsumption[] @relation("InventoryConsumption_movementId_tenant")
  inventoryLayer_sourceMovementId_tenant InventoryLayer[] @relation("InventoryLayer_sourceMovementId_tenant")
  stockMovement_reversalOfId_tenant StockMovement[] @relation("StockMovement_reversalOfId_tenant")
  stockOpeningLine_voidMovementId_tenant StockOpeningLine[] @relation("StockOpeningLine_voidMovementId_tenant")
  stockOpeningLine_movementId_tenant StockOpeningLine[] @relation("StockOpeningLine_movementId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// سبب الحركة — **يحدّده المسار الذي أنشأها، ويقيّده مُشغِّل القاعدة**.
///
/// ⚠️ وهو **ليس حصانةً كاملة**: من يكتب `MANUAL` على بيعٍ حقيقي يمرّ منه.
/// وتلك بعينها الحالة التي يمسكها **حارس المطابقة** — فالمنع يحمي المسار
/// المعروف، والكشف يمسك المسار الذي لم يُكتب بعد.
enum MovementOrigin {
  /// تسويةٌ أو إدخالٌ يدوي من شاشة المخزون — بلا مستند، وهو مشروع.
  MANUAL
  /// بيعٌ أو مرتجع — يلزمه سطر فاتورة (الإشعار الدائن يشارك جدول الفواتير).
  SALE
  /// استلام بضاعة — يلزمه سطر شراء (ق-١٩: الاستلام هو حدث التكلفة).
  RECEIPT
  /// نقلٌ بين مستودعين — طرفان بلا مستند بيعٍ ولا شراء.
  TRANSFER
  /// رصيدٌ افتتاحي من الهجرة — طبقته تحمل تاريخ اقتنائها لا تاريخ الهجرة.
  OPENING
  /// شطبُ تلفٍ أو فقد — **له مستندُه ([[InventoryWriteOff]]) فلا يُخلط بـ`MANUAL`**.
  /// و`MANUAL` معرّفةٌ أعلاه بأنها «بلا مستند»، فوسمُ الشطب بها **يجعل الدفتر
  /// يقول إن أحداً عدّل رصيداً** بينما الواقع أن بضاعةً أُعدمت باعتمادٍ موثَّق.
  WRITEOFF
}

/// طريقة التكلفة — **تُخزَّن على الطبقة نفسها لا على إعدادٍ عام**.
///
/// تقرير سنةٍ سابقة يُقرأ **بالطريقة السارية حينها**، لا بالطريقة الحالية.
/// و⛔ `LIFO` لا يُبنى: المعايير المعتمدة في المملكة تجيز الوارد-أولاً
/// والمتوسط المرجّح فقط.
enum CostingMethod {
  FIFO
  WEIGHTED_AVERAGE
  SPECIFIC
}

/// مصدر الطبقة.
enum LayerSource {
  GOODS_RECEIPT
  OPENING
  RETURN
  /// إدخالٌ يدويّ أو تسويةٌ موجبة — بتكلفةٍ مُدخَلة لا من البطاقة (ق-١٠٦٣/٣).
  ADJUSTMENT
  /// طبقةٌ وصلت بالتحويل من مستودعٍ آخر — بتكلفة أصلها وتاريخ اقتنائه، لا تاريخ النقل (ق-١٠٦٣/٢).
  TRANSFER
}

/// ⭐ **طبقة تكلفة — البنية الأساس، والمتوسط المرجّح دالةٌ فوقها لا مخطَّطٌ بديل.**
///
/// قرار المالك (ق-١): **الأدقّ يُبنى أولاً والأبسط دالةٌ فوقه، والعكس مستحيل**
/// — من بدأ بالمتوسط لا يملك بياناتٍ يبني منها الطبقات، فالدفعات ذابت في رقم
/// واحد.
///
/// والطبقة **لا تُحذف ولا يُعدَّل تاريخها**: `qtyRemaining` ينقص ويزيد،
/// والتاريخ هو ما يرتّب الاستهلاك.
model InventoryLayer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product @relation("InventoryLayer_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  warehouseTenant Warehouse @relation("InventoryLayer_warehouseId_tenant", fields: [companyId, warehouseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  qtyReceived  Decimal @db.Decimal(18, 3)
  /// المتبقّي في الطبقة — يُستهلك منه ويعود إليه المرتجع.
  qtyRemaining Decimal @db.Decimal(18, 3)
  unitCost     Decimal @db.Decimal(18, 6)

  /// ⚠️ **تاريخ الاقتناء لا تاريخ الإدخال.** طبقةٌ مستوردة بتاريخ الهجرة
  /// تنهار مع FIFO ومع FEFO ومع تقارير عمر المخزون — فيُحمل الأصلي ولو
  /// تقريبياً بإقرار موثَّق.
  acquiredAt DateTime

  sourceType LayerSource
  /// حركة الإدخال التي أنشأت الطبقة — إن وُجدت (الرصيد الافتتاحي بلا حركة).
  sourceMovementId String?
  sourceMovement   StockMovement? @relation(fields: [sourceMovementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  sourceMovementTenant StockMovement? @relation("InventoryLayer_sourceMovementId_tenant", fields: [companyId, sourceMovementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الطريقة السارية لحظة الإنشاء — لا تُقرأ من إعدادٍ متغيّر عند التقرير.
  costingMethod CostingMethod @default(FIFO)

  /// ٥+٦ الدفعةُ التي جاءت بها هذه الطبقة (`ق-١٠٨٦`) — كيانٌ لا نصّ؛ `null` للطبقات التي سبقت البناء
  /// (`218` على التطوير يومَه) ولما لم يُعلَن له دفعة: **تبقى وتُعدّ ولا تُخمَّن دفعتُها** (`ق-١٠٧٦`/٣).
  /// التحويلُ ينقلها مع الطبقة، والعكسُ يُقفل الطبقةَ بدفعتها. `Restrict`: دفعةٌ لها طبقة لا تُحذف.
  batchId String?
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  batchTenant StockBatch? @relation("InventoryLayer_batchId_tenant", fields: [companyId, batchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ `ق-١٣٦٤` — **طبقةٌ وُلدت بتحويل تعرف الاستهلاكَ الذي جاءت منه** (شريحةُ طبقة المصدر، أو مؤقّتُها):
  /// فما رُفع من تكلفة طبقة المصدر بعد التحويل **يتبع الوحدةَ إلى هنا ولا يُعدّ مستهلكاً** (بنصّ المالك). `null` لغير
  /// المحوَّل، ولطبقاتٍ وُلدت بتحويلٍ سبق البناء (تُعدّ ولا تُحوَّل). فريدٌ: شريحةٌ واحدة تُنشئ طبقةً واحدة.
  transferConsumptionId String?               @unique
  transferConsumption   InventoryConsumption? @relation("TransferBornLayer", fields: [transferConsumptionId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  transferConsumptionTenant InventoryConsumption? @relation("InventoryLayer_transferConsumptionId_tenant", fields: [companyId, transferConsumptionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚖️ `ق-١٣٦٤` — **ما رُفع على الوحدة الواحدة ممّا كان قد خرج من الطبقة**، تراكميّاً: كلُّ رفعٍ يصل الطبقةَ وقد خرج منها
  /// شيءٌ يضيف (حصّةَ الخارج ÷ كمّيتِه). والاستهلاكُ يحفظ قيمتَه لحظةَ خروجه (`exitedRaiseAtExit`) — فالوحدةُ التي **تعود**
  /// تعود «بالتكلفة التي خرجت بها، وما رُفع عليها بعد خروجها يُعاد من تكلفة المبيعات إلى المخزون» (بنصّ المالك): الفرقُ بينهما.
  exitedRaise Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  consumptions InventoryConsumption[]
  /// ⚖️ `ق-١٣٦٤` حصصُ الرفع على هذه الطبقة ومخارجها.
  costShares LayerCostShare[]
  /// ٧ نصيبُ هذه الطبقة من تكاليفَ محمَّلة وُزِّعت عليها (`Restrict`: طبقةٌ عليها توزيعٌ لا تُحذف).
  landedCostLines LandedCostLine[]
  /// `ق-١٣٤٢` حصصُ ضريبة المدخلات غيرِ القابلة للخصم التي حملتها هذه الطبقة (`Restrict`).
  nonDeductibleVatEventLines NonDeductibleVatEventLine[]
  /// ٣٠ سطرُ الإعلان الافتتاحيّ الذي أنشأ هذه الطبقة (`OPENING`).
  openingLine     StockOpeningLine? @relation("OpeningLineLayer")

  /// ترتيب الاستهلاك: `acquiredAt` ثم `createdAt` — والثاني فاصلٌ حاسم كي لا
  /// يعتمد الترتيب على الصدفة حين تتساوى التواريخ.
  @@index([companyId, productId, warehouseId, acquiredAt, createdAt])
  @@index([batchId])
  @@map("inventory_layers")
  inventoryConsumption_layerId_tenant InventoryConsumption[] @relation("InventoryConsumption_layerId_tenant")
  stockOpeningLine_layerId_tenant StockOpeningLine[] @relation("StockOpeningLine_layerId_tenant")
  landedCostLine_layerId_tenant LandedCostLine[] @relation("LandedCostLine_layerId_tenant")
  nonDeductibleVatEventLine_layerId_tenant NonDeductibleVatEventLine[] @relation("NonDeductibleVatEventLine_layerId_tenant")
  layerCostShare_layerId_tenant LayerCostShare[] @relation("LayerCostShare_layerId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ٥+٦ **الدفعةُ كياناً** (`ق-١٠٨٦` · 2026-09-18) — لا نصّاً على الحركة: رقمٌ وانتهاءٌ واحد لصنفٍ في منشأة،
/// تشير إليه الطبقةُ فيُقرأ منه الصرفُ بالأقرب انتهاءً والتقريرُ بالمتبقّي. **بلا دفعةٍ بلا انتهاء** (`ق-١٠٨١`).
///
/// ⚖️ **المفتاحُ صنفٌ ورقمٌ — بلا الانتهاء** (حكمُ المالك `ق-١٠٩٠`): الدفعةُ هويّةٌ، وما يُعلَّق عليه التاريخُ لا يتغيّر؛ ورقمٌ يُعاد
/// بانتهاءٍ مختلف يُرفض باسمه (`common/batches/stock-batch.util.ts`) — والقاعدةُ تحرسه بهذا المفتاح فلا يُترك البابُ لمن يأتي
/// بعدنا. (كان المفتاحُ رباعياً يقبل البديلين حتى الحكم — `ق-١٠٨٦`.)
model StockBatch {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product @relation("StockBatch_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  batchNo    String
  expiryDate DateTime @db.Date

  createdAt DateTime @default(now())

  layers InventoryLayer[]

  @@unique([companyId, productId, batchNo])
  @@index([companyId, productId, expiryDate])
  @@map("stock_batches")
  inventoryLayer_batchId_tenant InventoryLayer[] @relation("InventoryLayer_batchId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⭐ **سجلّ الاستهلاك — أيّ طبقةٍ خرجت ولأي حركة.**
///
/// **بدونه لا يُعكس مرتجع، ولا يُدقَّق COGS، ولا يُعاد إنتاج رقم سنةٍ مضت.**
/// والرصيد المتبقّي في الطبقة مشتقٌّ منه منطقياً، ومخزَّنٌ فيها للأداء —
/// والاثنان يجب أن يتّفقا، وحارسٌ يفحص ذلك.
model InventoryConsumption {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// ⚠️ **فارغٌ للاستهلاك المؤقّت وحده** — وهو الحالة التي لا طبقةَ لها:
  /// بيعٌ سبق استلامه. واختلاقُ طبقةٍ وهمية له كان سيُفسد «كم استلمنا فعلاً»،
  /// فالكذبة تُحصر في التكلفة ولا تمتدّ إلى تاريخ الشراء.
  layerId String?
  layer   InventoryLayer? @relation(fields: [layerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  layerTenant InventoryLayer? @relation("InventoryConsumption_layerId_tenant", fields: [companyId, layerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// حركة الإخراج التي استهلكت — والمرتجع يعكسها بسطرٍ سالب لا بحذف.
  movementId String
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  movementTenant StockMovement @relation("InventoryConsumption_movementId_tenant", fields: [companyId, movementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  qty      Decimal @db.Decimal(18, 3)
  /// تكلفة الوحدة **وقت الاستهلاك** — تُثبَّت هنا ولا تُقرأ من الطبقة لاحقاً.
  unitCost Decimal @db.Decimal(18, 6)

  /// ⭐ **الاستهلاك الذي سوّى هذا المؤقّت — واقعةٌ لا حالة.**
  ///
  /// ⚠️ **ولا علَم `isProvisional`.** أوّل صياغةٍ حملت علَماً، وهو
  /// `lineType: SERVICE` بعينه: **علَمٌ يستطيع أن يخالف الواقع**، فيلزم من
  /// يحكم أيّهما يكذب. و«مؤقّت» ليس وصفاً يُضاف — هو **`layerId IS NULL`
  /// نفسه**: استهلاكٌ لا طبقة له لأنه سبق استلامها.
  ///
  /// والتسوية **صفٌّ جديد يشير إلى الأصل**، لا تعديلٌ على الأصل: وقائع لا
  /// حالات، كما في سجل المهام. فالمفتوح يُشتقّ ولا يُخزَّن:
  ///
  ///     layerId IS NULL  AND  NOT EXISTS (تسويةٌ تشير إليه)
  settlesId String?               @unique
  settles   InventoryConsumption? @relation("ProvisionalSettlement", fields: [settlesId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  settlesTenant InventoryConsumption? @relation("InventoryConsumption_settlesId_tenant", fields: [companyId, settlesId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  settledBy InventoryConsumption? @relation("ProvisionalSettlement")

  /// ⚖️ `ق-١٣٦٤` — `exitedRaise` طبقتِه لحظةَ الخروج، **يكتبه مُشغِّل القاعدة لا الشيفرة** (فمسارُ استهلاكٍ جديد لا ينساه):
  /// والعائدُ يستردّ الفرقَ بينه وبين ما صار عليه (`restoreConsumption*`). صفرٌ للمؤقّت (لا طبقة) ولما سبق البناء.
  exitedRaiseAtExit Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  /// ⚖️ `ق-١٣٦٤` الطبقةُ التي وُلدت من هذه الشريحة بتحويل — إليها يتبع ما رُفع بعده.
  transferBornLayer InventoryLayer? @relation("TransferBornLayer")
  /// ⚖️ `ق-١٣٦٤` حصصُ فرق التسوية حين يكون هذا الصفُّ تسويةَ مؤقّت.
  settlementCostShares LayerCostShare[] @relation("SettlementCostShare")

  @@index([companyId, layerId])
  @@index([companyId, movementId])
  @@map("inventory_consumptions")
  inventoryConsumption_settlesId_tenant InventoryConsumption[] @relation("InventoryConsumption_settlesId_tenant")
  inventoryLayer_transferConsumptionId_tenant InventoryLayer[] @relation("InventoryLayer_transferConsumptionId_tenant")
  layerCostShare_settlementId_tenant LayerCostShare[] @relation("LayerCostShare_settlementId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// ⚖️ `ق-١٣٦٤` ما الذي رفع (أو خفض) تكلفةَ الطبقة.
enum LayerCostEvent {
  /// توزيعُ تكلفةٍ محمَّلة (شحنٌ · تخليصٌ · رسوم).
  LANDED_COST
  /// إشعارُ سعرٍ من المورّد بلا بضاعة.
  PRICE_NOTE
  /// ضريبةُ مدخلاتٍ غيرُ قابلةٍ للخصم (`ق-١٣٤٢`).
  NON_DEDUCTIBLE_VAT
  /// فرقُ تسوية مؤقّت: التكلفةُ الحقيقية عُرفت بعد أن خرجت الوحدةُ بآخر تكلفةٍ معروفة.
  SETTLEMENT
}

/// ⚖️ **`ق-١٣٦٤` — حصّةُ رفعٍ على طبقة: أين ذهب كلُّ ريالٍ منه** — الرفُّ (`1300`) أو مخارجُ الطبقة بأنواعها.
///
/// **بنصّ المالك** (⑤): «التحويل: ما رُفع من تكلفة الطبقة يتبع الوحدةَ إلى طبقة المقصِد، ولا يُعدّ مستهلكاً. والإتلاف:
/// حصّتُه إلى حساب خسائر الإتلاف لا تكلفة المبيعات.» فحصّةُ ما خرج **تُقسَم على مخارجه بكمّياتها**: الشطبُ إلى `5800` ·
/// الإخراجُ اليدويّ إلى `5810` (أصلُه قُيّد عليها — `ق-١٣٦٣`) · التحويلُ **يتبع إلى طبقة المقصِد** (صفٌّ ابنٌ هنا بـ`parentId`)
/// · والبيعُ الصافي (وإعادةُ المورّد كما كانت) إلى `5100`.
///
/// **وهو مادّةُ الحارس الثاني** (`inventory-distribution.util`): يُعيد اشتقاقَ القسمة من صفوف الاستهلاك نفسِها — مستقلّاً عن
/// الموزِّع — ويطابقها بالدفتر. `CHECK`: الحصّةُ = الرفّ + المبيعات + الإتلاف + الفروقات + التابع.
model LayerCostShare {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  layerId String
  layer   InventoryLayer @relation(fields: [layerId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  layerTenant InventoryLayer @relation("LayerCostShare_layerId_tenant", fields: [companyId, layerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الحصّةُ التي تبعت منها هذه إلى طبقة المقصِد — `null` للحصّة الأصل.
  parentId String?
  parent   LayerCostShare? @relation("CostShareFollow", fields: [parentId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  parentTenant LayerCostShare? @relation("LayerCostShare_parentId_tenant", fields: [companyId, parentId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  children     LayerCostShare[] @relation("CostShareFollow")

  event LayerCostEvent
  /// الحدثُ بمفتاحٍ حقيقيّ لكلِّ نوع (§6.3) — واحدٌ لا غير، بقيد `CHECK`.
  landedCostDistributionId String?
  landedCostDistribution   LandedCostDistribution? @relation(fields: [landedCostDistributionId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  landedCostDistributionTenant LandedCostDistribution? @relation("LayerCostShare_landedCostDistributionId_tenant", fields: [companyId, landedCostDistributionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  nonDeductibleVatEventId String?
  nonDeductibleVatEvent   NonDeductibleVatEvent? @relation(fields: [nonDeductibleVatEventId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  nonDeductibleVatEventTenant NonDeductibleVatEvent? @relation("LayerCostShare_nonDeductibleVatEventId_tenant", fields: [companyId, nonDeductibleVatEventId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// إشعارُ السعر من المورّد (المستند).
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  purchaseTenant Purchase? @relation("LayerCostShare_purchaseId_tenant", fields: [companyId, purchaseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  /// صفُّ التسوية (استهلاكٌ يشير إلى مؤقّته).
  settlementId String?
  settlement   InventoryConsumption? @relation("SettlementCostShare", fields: [settlementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  settlementTenant InventoryConsumption? @relation("LayerCostShare_settlementId_tenant", fields: [companyId, settlementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// الطبقةُ لحظةَ الحصّة: ما استُلم فيها · ما بقي على الرفّ · وما خرج منها (= الأوّل − الثاني).
  qtyReceived    Decimal @db.Decimal(18, 3)
  qtyRemainingAt Decimal @db.Decimal(18, 3)
  exitedQtyAt    Decimal @db.Decimal(18, 3)

  /// الحصّةُ بإشارتها (موجبٌ رفع · سالبٌ خفض) = الرفّ + المبيعات + الإتلاف + الفروقات + التابع.
  baseAmount   Decimal @db.Decimal(18, 2)
  baseShelf    Decimal @db.Decimal(18, 2)
  baseCogs     Decimal @db.Decimal(18, 2)
  baseWriteOff Decimal @db.Decimal(18, 2)
  baseVariance Decimal @db.Decimal(18, 2)
  baseFollow   Decimal @db.Decimal(18, 2)

  unitCostBefore    Decimal @db.Decimal(18, 6)
  unitCostAfter     Decimal @db.Decimal(18, 6)
  exitedRaiseBefore Decimal @db.Decimal(18, 6)
  exitedRaiseAfter  Decimal @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@index([layerId])
  @@index([parentId])
  @@index([landedCostDistributionId])
  @@index([nonDeductibleVatEventId])
  @@index([purchaseId])
  @@index([settlementId])
  @@map("layer_cost_shares")
  layerCostShare_parentId_tenant LayerCostShare[] @relation("LayerCostShare_parentId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// حالة واقعة الشطب — **والاعتماد هو الحدث المحاسبي، لا التسجيل**.
///
/// من يستقبل البضاعة لا يُقرّر إعدامها (`SPEC 30.7`): الكاشير يسجّل بصلاحية
/// `record`، وصاحب `review` يعتمد. **وقبل الاعتماد لا يخرج شيء من المخزون ولا
/// يُرحَّل قيد** — فبضاعةٌ موسومةٌ للتلف ما تزال على الرفّ حتى يُقرَّر.
enum WriteOffStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// ⭐ **واقعة شطب مخزون — تلفٌ أو فقدٌ أو سرقة** (`SPEC 30.5`).
///
/// ## لماذا كيانٌ مستقل لا علَمٌ على حركة
///
/// الشطب **قرارٌ يُعتمد** لا تسويةُ رصيد: له سببٌ إلزامي، وشاهدٌ سجّله، وآخر
/// اعتمده، وتاريخُ وقوعٍ يسبق تسجيله. وحركةُ المخزون **أثرُه** لا هو — فمن
/// يكتب الشطب حركةً بلا مستند يفقد كل ما سبق، **ويُفقد معه سؤال «كم أتلفنا
/// ومن اعتمده»** الذي هو مؤشر سرقةٍ قبل الجرد.
///
/// ## ورمز السبب نصٌّ لا `enum` في القاعدة — عمداً
///
/// القائمة الحاكمة `apps/api/src/common/writeoff-reasons.ts`: كل رمزٍ يحمل
/// **مساره الضريبي في تعريفه** (`ق-١٣٧`) وسنده النظامي. و`enum` في القاعدة
/// كان سينسخ الأسماء بلا مساراتها، **فتصير نسختان تفترقان بصمت** — وأسوأ ما
/// فيه أن الافتراق يقع في تصنيفٍ ضريبي لا في لافتة. والتحقّق يقع عند الكتابة
/// من المصدر الواحد.
///
/// ⚠️ **والتاريخ تاريخُ الوقوع لا التسجيل** (`ق-١٢٩`): تلفٌ وقع أمس ويُسجَّل
/// اليوم يُقيَّد بأمس، وإلا صارت تقارير التلف تقيس **نشاط الموظّف** لا الواقع.
model InventoryWriteOff {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  branchTenant Branch? @relation("InventoryWriteOff_branchId_tenant", fields: [companyId, branchId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  warehouseTenant Warehouse @relation("InventoryWriteOff_warehouseId_tenant", fields: [companyId, warehouseId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  productTenant Product @relation("InventoryWriteOff_productId_tenant", fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// سلسلةٌ مستقلة `WO-YYYY-NNNN` — لا يتزاحم الشطب مع الفواتير على عدّاد.
  no String

  qty Decimal @db.Decimal(18, 3)

  /// رمزٌ من `WRITEOFF_REASONS` — يُتحقَّق منه عند الكتابة من المصدر الواحد.
  reasonCode String
  note       String?

  /// تاريخ **وقوع** التلف.
  occurredAt DateTime @db.Date

  status WriteOffStatus @default(PENDING_REVIEW)

  /// مَن سجّل ومَن اعتمد — **بلا مفتاحٍ أجنبي**، كسجل المهام: واقعةٌ لا
  /// يُبطلها حذفُ من قام بها.
  recordedById    String
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  /// تكلفة ما خرج من الطبقات فعلاً — **تُملأ عند الاعتماد ولا تُقدَّر قبله**.
  baseCost Decimal? @db.Decimal(18, 2)

  /// أثرا الاعتماد: الحركة والقيد. وكلاهما `@unique` — **فلا واقعةٌ تُعتمد
  /// مرّتين** بحركتين أو قيدين.
  movementId String?        @unique
  movement   StockMovement? @relation("WriteOffMovement", fields: [movementId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  movementTenant StockMovement? @relation("InventoryWriteOff_movementId_tenant", fields: [companyId, movementId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("InventoryWriteOffEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  journalEntryTenant JournalEntry? @relation("InventoryWriteOff_journalEntryId_tenant", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments InventoryWriteOffAttachment[]

  @@unique([companyId, no])
  @@index([companyId, status])
  @@index([companyId, productId, warehouseId])
  @@index([companyId, occurredAt])
  @@map("inventory_write_offs")
  inventoryWriteOffAttachment_writeOffId_tenant InventoryWriteOffAttachment[] @relation("InventoryWriteOffAttachment_writeOffId_tenant")
  /// ق-١٢٥٢ — هدفُ المفاتيح المركّبة (companyId, id).
  @@unique([companyId, id])
}

/// مرفقات واقعة الشطب — **الدليل الذي تطلبه الهيئة إن سألت**.
///
/// `م٤٩(٥)` تجعل القيد في السجلات كافياً **وللهيئة طلب أدلة**: صورة البضاعة
/// التالفة · محضر الإتلاف · **تقرير الشرطة في السرقة** (وهو من الأدلة
/// المسمّاة). فالمرفق ليس زينةً بل **ما يُقدَّم عند الطلب**.
///
/// والبنية نفسها التي في `PurchaseAttachment`: البايتات في تخزين الكائنات،
/// **والصفّ المنطاق بالمستأجر هو سجلّ التصريح**.
///
/// ⚠️ **ولا تُرفع صور الهويات** — القاعدة عامة في المنصة، وموضعها التحذير في
/// الواجهة لا هنا.
model InventoryWriteOffAttachment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  writeOffId String
  writeOff   InventoryWriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  writeOffTenant InventoryWriteOff @relation("InventoryWriteOffAttachment_writeOffId_tenant", fields: [companyId, writeOffId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// مفتاح التخزين: companies/{companyId}/{uuid}-{filename}.
  fileKey  String
  filename String
  size     Int
  mimeType String

  uploadedAt DateTime @default(now())

  @@index([writeOffId])
  @@map("inventory_write_off_attachments")
}

/// A government-compliance checklist item — deliberately minimal, matching
/// the mockup exactly: no due date, no amount, no penalty, no recurrence.
/// `body` is the government entity name (free text, not its own table — the
/// mockup never normalizes it either) and `done` is manually toggled with no
/// automatic reset. The standard 9-item checklist (ZATCA/MOC/GOSI) is
/// auto-seeded per company on first read (`ObligationsService.list`) rather
/// than at signup, so it works regardless of how the company was created.
/// **بلا أبٍ** — كيانٌ جذريّ للمنشأة: قائمةٌ تُبذَر لها عند أوّل قراءة.
model GovernmentObligation {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  body  String
  title String
  done  Boolean @default(false)
  /// Fixed display order within the seeded checklist — `createdAt` can't be
  /// used for this since every row from the same `createMany` seed call
  /// shares an identical statement-level timestamp in Postgres.
  order Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("government_obligations")
}

/// Which contact group a message template is meant for — matches the
/// mockup's `audience` field ('مستأجرون'|'عملاء'|'موظفون'), translated to
/// English enum values like every other status/category field in this app.
enum ScriptAudience {
  TENANT
  CUSTOMER
  EMPLOYEE
}

/// A reusable message template ("قوالب الرسائل") for contacting tenants,
/// customers, or employees. Confirmed by reading the mockup: there's no
/// {{placeholder}} token system — authors just type a literal bracketed name
/// like "[الاسم]" into `text` and the one consumer (a WhatsApp deep-link
/// button elsewhere in the app) does a plain string replace before opening
/// wa.me. That WhatsApp wiring itself is a browser-only cosmetic hook spread
/// across the Customers/Contracts/Employees screens and is deliberately not
/// ported here — this model only backs the standalone CRUD screen.
/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: نصُّ رسالةٍ جاهز.
model MessageScript {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  audience ScriptAudience
  title    String
  text     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  /// Soft delete: set instead of removing the row, so it can be restored
  /// from the trash within 30 days. Reads filter it out centrally.
  deletedAt DateTime?
  /// Hidden from day-to-day lists but still counted in the books.
  archived  Boolean  @default(false)

  @@map("message_scripts")
}

// ═════════════════════════════════════════════════════════════════════════
// ثلاثة جداول كانت في القاعدة ولم تكن في المخطَّط
// ═════════════════════════════════════════════════════════════════════════
//
// أُنشئت بترحيلاتٍ **مكتوبةٍ بيد** (`20260812150000_delegation_log` ·
// `20260813180000_tasks`) لأنها تحمل ما لا يُعبَّر عنه في Prisma: مُشغِّلات
// «ملحق فقط»، وعزل صفوف بـ`FORCE`، وقيود `CHECK`. ونماذجها **لم تُكتب قطّ**
// — لا حُذفت: `git log -S "model Task {"` لا يجد التزاماً أضافها يوماً.
//
// فكان المخطَّط يجهل ثلاثة جداول تحمل بيانات (٤٠٥ صفوف في التطوير · ٥ على
// خادم العرض)، وأثرُه ملموس: `prisma migrate diff` يقرأ الغياب **نيّةَ حذف**
// فيولّد `DROP TABLE` لثلاثتها. وقد ولّدها فعلاً عند بناء `م٣`، ولولا قراءة
// المولَّد قبل تمريره لمُحيت عند أول `migrate deploy`.
//
// ⚠️ **وهذه النماذج تصف ولا تمسّ.** لا ترحيل معها ولا تغيير بيانات — كل
// عمودٍ وقيدٍ وفهرسٍ أدناه **قُرئ من `pg_attribute` و`pg_constraint`
// و`pg_indexes` لحظة الكتابة**، لا من ذاكرةٍ ولا من الترحيل. والإثبات أن
// `migrate diff` يعود **فارغاً** بعدها.
//
// وما لا تصفه Prisma يبقى حيث هو ويُحرَس بحرّاسه الحيّة: المُشغِّلات
// و`FORCE RLS` وقيود `CHECK` الثلاثة على `tasks`
// (`tasks_status_closed_list` · `tasks_target_both_or_neither` ·
// `tasks_recurrence_needs_anchor`). و`migrate diff` لا يراها فلا يمسّها.

/// المهمة — **الحالة الحاضرة**، وسجلُّها ([[TaskLog]]) يحمل كيف وصلت إليها.
///
/// والفصل مقصود: السجل ملحقٌ فقط لا يُعدَّل بحال (وقائع لا حالات)، والحالة
/// تتغيّر. وخلطُهما يفرض أحد الشرَّين: سجلٌّ يُعدَّل، أو حالةٌ تُستنتج بقراءة
/// كل الانتقالات عند كل عرض.
///
/// ⚠️ ولا حقل `canOpenTarget` هنا **عمداً**: يُحسب عند القراءة من التقاطع
/// الحيّ. وتخزينه نسخةٌ تتقادم عند أول سحب — وهو العطل الذي تجنّبه التقاطع
/// أصلاً. وحارسٌ في `apps/web` وآخر في `apps/api` يمنعان عودته.
///
/// أولويةُ المهمّة (`SPEC 14.2`) — القيمُ الثلاث نفسُها في النموذج: عاجل · مرتفع · عادي.
/// ⚠️ **وهي عينُ `MaintenancePriority`** — نوعان بقيمٍ واحدة لأن Prisma لا يشارك
/// نوعاً بين نموذجين باسمين؛ **ومن غيّر أحدَهما غيّر الآخر**.
enum TaskPriority {
  URGENT
  HIGH
  NORMAL
}

/// **بلا أبٍ** — كيانٌ جذريّ يملكه التاجر: **ولا مفتاحَ أجنبيّ إلى هدفها**،
/// فالهدفُ يُشار إليه بنوعه ومعرّفه ويُقرأ حيّاً عند الفتح.
///
/// **والتذكرةُ الداخليةُ مهمّةٌ بحقلين لا محرّكٌ ثانٍ** (`SPEC 1.11` · `ق-٥٣٢`):
/// `priority` و`department` — والمسؤولُ والحالةُ والرابطُ والسجلُّ قائمةٌ أصلاً،
/// **والتعليقُ بلا انتقالٍ سطرٌ في `TaskLog` حالتُه من وإلى سواء**.
model Task {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  title        String
  createdById  String
  assigneeId   String
  /// ⭐ **وسمُ فضاء المكلَّف** (`ق-٦٣٩`): `OWNER` ⇒ `assigneeId` هو معرّفُ المنشأة
  /// نفسِها؛ `USER` ⇒ معرّفُ حسابٍ فرعيّ. **إلزاميٌّ بلا افتراض** — فحقلٌ يقبل
  /// فراغاً يعود إلى الحقل المتعدّد الشكل (`ق-٦٢٩`) من بابٍ آخر. والقيدُ
  /// `tasks_owner_assignee_is_company` في القاعدة يمسك ما لا يمرّ بالخدمة.
  assigneeKind TaskAssigneeKind
  /// الأولوية — من قائمةٍ مغلقةٍ في القاعدة (نوعُ `TaskPriority`)، والافتراضُ عادي.
  priority     TaskPriority @default(NORMAL)
  /// القسمُ المختصّ — نصٌّ حرّ يُرشَّح منه في الواجهة؛ فارغٌ لمهمّةٍ بلا قسم.
  department   String?
  /// المستند المقصود — الاثنان معاً أو لا شيء، يحرسه
  /// `tasks_target_both_or_neither` في القاعدة.
  targetScreen String?
  targetId     String?
  /// نصٌّ لا `enum`: القائمة المغلقة يحرسها `tasks_status_closed_list` في
  /// القاعدة، وهي المكان الذي تلتقي عنده كل مسارات الكتابة.
  status       String  @default("OPEN")
  note         String?
  /// صفرٌ يعني «لا تكرار». و`dueAnchor` لازمٌ متى كان موجباً — يحرسه
  /// `tasks_recurrence_needs_anchor`.
  recurEveryDays Int      @default(0)
  dueAnchor      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([companyId, assigneeId])
  @@index([companyId, assigneeKind, assigneeId])
  @@index([companyId, status])
  @@index([companyId, targetScreen, targetId])
  @@map("tasks")
}

/// فضاءُ معرّف المكلَّف في المهمّة (`ق-٦٣٩`) — يُقرأ منه `DTO` والخدمة، لا يُنسخ.
enum TaskAssigneeKind {
  OWNER
  USER
}

/// سجل انتقالات المهمة — **ملحقٌ فقط**، والمنع في القاعدة لا في الخدمة.
///
/// ولا مفتاح أجنبي على `taskId` ولا `actorId` **عمداً**: سجلُّ واقعةٍ لا
/// يُبطله حذفُ ما يشير إليه. وإضافةُ مفتاحٍ هنا تجعل حذف مهمةٍ يهدم تاريخها.
/// **بلا أبٍ** — سجلُّ واقعةٍ لا يُحذف (`ق-١١٠`): **ولا مفتاحَ أجنبيّ عمداً**،
/// فحذفُ مهمّةٍ لا يهدم تاريخها.
model TaskLog {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// تسلسل لكل منشأة يبدأ من ١. الفهرس الفريد يمنع التكرار، وكاشف الفجوات
  /// يكشف القفز — وهما شيئان مختلفان.
  seq        Int
  taskId     String
  actorId    String
  fromStatus String?
  toStatus   String
  note       String?

  createdAt DateTime @default(now())

  @@unique([companyId, seq])
  @@index([companyId, taskId])
  @@map("task_logs")
}

/// سجل التفويض — **ملحقٌ فقط**، والمنع في القاعدة لا في الخدمة.
///
/// ⚠️ لماذا في القاعدة لا في TypeScript (القاعدة السابعة): حارسٌ يفحص
/// `DelegationLogService.remove()` لا يحرس شيئاً — يمرّ عليه
/// `prisma.delegationLog.deleteMany()`، و`DELETE` خاماً عبر `$executeRaw`،
/// و**الحذف المتسلسل** عبر `ON DELETE CASCADE`. والمسارات الثلاثة تلتقي عند
/// القاعدة، فالمنع يقع حيث تلتقي.
///
/// والمصدر النصّي: الملحق (1) من قرار ZATCA تحت «Tampering of e-invoices or
/// their associated notes or logs» — تعديل السجل أو حذفه · توليدٌ غير
/// متسلسل · طوابع زمنية غير دقيقة.
/// **بلا أبٍ** — سجلُّ واقعةٍ لا يُعدَّل ولا يُحذف بسندٍ نظاميّ (ملحق ZATCA):
/// **ولا مفتاحَ أجنبيّ عمداً** كي لا يُبطله حذفُ ما يشير إليه.
model DelegationLog {
  id        String  @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// تسلسل لكل منشأة يبدأ من ١ — انظر [[TaskLog]].seq.
  seq       Int
  grantorId String
  granteeId String
  nodeKey   String
  grants    String[]
  state     String   @default("ACTIVE")

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([companyId, seq])
  @@index([companyId, createdAt])
  @@map("delegation_logs")
}

/// حالة صفّ الـOutbox — تُقرأ بالتسلسل: PENDING ← SENT أو FAILED.
enum OutboxStatus {
  /// لم يُرسَل بعد، ويُلتقط حين يحلّ `availableAt`.
  PENDING
  /// أُرسل وقُبل — لا يُعاد.
  SENT
  /// استُنفدت المحاولات؛ يبقى ليُرى ويُعاد يدوياً، ولا يُحذف.
  FAILED
}

/// ⭐ **نمط Outbox — الفاتورة وحدثُها في معاملةٍ واحدة** (`ق-٤٩` · `ق-١٢٨`).
///
/// العطل الذي يُغلقه: إرسال ZATCA اليوم **يدويّ** بنقطة `POST /zatca/invoices/:id/submit`.
/// فما من شيءٍ يضمن أن فاتورةً أُنشئت ستصل الهيئة — **تُنشأ وتُنسى**. والإرسال
/// المتزامن داخل الطلب ليس حلاً: انقطاع الشبكة يُسقط البيع نفسه.
///
/// فالصفّ يُكتب **في معاملة المستند** بوصفه حدث امتثال (`emitCompliance`): إن
/// تعذّرت كتابته **تُلغى الفاتورة**، فلا تبقى فاتورةٌ بلا طابور. ثم يلتقطه
/// موزّعٌ مستقل ويعيد المحاولة بتراجعٍ أُسّي.
/// **بلا أبٍ** — مستنبَطٌ **يُدار بحالته لا بحذفه**: `PENDING` ⟵ `SENT`/`FAILED`.
/// **ولا مفتاحَ أجنبيّ إلى مستنَده عمداً**: يُكتب في معاملته ويبقى بعده أثراً.
model OutboxEvent {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// نوع الحدث بمعناه (`invoice.issued`) — لا اسم دالّة ولا مسار.
  type    String
  /// حمولةٌ صغيرة: معرّفاتٌ لا نسخةٌ من المستند. المستند مصدره الجدول نفسه،
  /// ونسخُه هنا يخلق نسختين تتباعدان.
  payload Json

  status   OutboxStatus @default(PENDING)
  attempts Int          @default(0)
  /// لا يُلتقط قبل هذا الوقت — به يقع التراجع الأُسّي بلا جدولٍ ثانٍ.
  availableAt DateTime  @default(now())
  /// آخر سببِ فشلٍ بنصّه — فمن يفتح الطابور يعرف لماذا وقف.
  /// @external-text
  lastError   String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  /// الفهرس الذي يقرأه الموزّع في كل دورة.
  @@index([status, availableAt])
  @@index([companyId, type])
  @@map("outbox_events")
}

/// ⭐ **عدّادُ تسلسل المستندات** (`ق-٣٢٨`) — رقمٌ يُشتقّ من عدّادٍ لا من مسح.
///
/// ── العلّة ────────────────────────────────────────────────────────────────
///
/// كان كلُّ ترقيمٍ يقرأ **كلَّ صفوف السنة** ثم يأخذ الأعلى: **سبعةُ مواضع**
/// (فاتورة · قيد · سند · عقد · شراء · إعدام · **عرضُ سعر**) — والسابعُ وجده
/// الحارسُ المشتقُّ بعد أن قال القياسُ ستة. **فمتجرٌ بمئة بيعةٍ يومياً يقرأ
/// ملايينَ الصفوف** — ثلاثَ مرّاتٍ في كل بيعة — **والبطءُ يتضاعف حتى يتوقّف
/// الكاشير**، ولا يظهر في السير لأن قاعدته فارغة (`ق-٣١٨`).
///
/// ⚠️ **والقراءةُ السريعة لا تُصلحها**: صفٌّ واحد بـ`ORDER BY no DESC` **ترتيبٌ
/// نصّيّ** — و`…-9999` يسبق `…-10000` أبجدياً، **فيُعطي رقماً مستعمَلاً**.
/// **فالمشكلتان واحدة، والعدّادُ يُلغي الترتيبَ النصّيَّ أصلاً.**
///
/// ⚠️ **والتزامنُ بنيةٌ لا محاولةٌ تُعاد**: `UPDATE … RETURNING` يقفل الصفَّ
/// فيُسلسل الطالبَين — **بخلاف `MAX+1` الذي يظلّ محتاجاً القيدَ الفريد وإعادةَ
/// المحاولة مهما سرُع** (درسُ `ICV`).
/// **بلا أبٍ** — عدّادٌ **يتراكم بحكمٍ مقصود**: رقمٌ صدر لا يُعاد استعمالُه،
/// فحذفُ المستند لا يُنزل العدّاد ولا ينبغي.
model DocumentSequence {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// مفتاحُ السلسلة — **عشرةٌ مقروءةٌ من مواضعها لا من الذاكرة**: `INV` ·
  /// `CN` · `DN` · `JE` · `RCV` · `RFD` · `EJ` · `PUR` · `WO` · `Q`.
  kind String
  /// سنةُ المستند — التسلسل يبدأ من جديدٍ كلَّ سنة، كما كان.
  year Int

  /// **آخرُ رقمٍ صدر** — لا التالي: فما لا يُبذَر يبدأ من صفرٍ فأولُ رقمٍ `1`.
  last Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ **القيدُ الفريد هو ما يجعل البذرَ مرّةً واحدة بنيةً لا انضباطاً**:
  /// الإدراجُ الثاني يصطدم به، فتشغيلٌ ثانٍ للبذر **لا يغيّر شيئاً**.
  @@unique([companyId, kind, year])
  @@map("document_sequences")
}

/// ═══ موافقةُ التاجر على المعالجين الفرعيين (`ق-٥٨١` · `ق-٥٨٩`) ═══
///
/// معالجٌ فرعيٌّ نستعين به في معالجة بيانات التجّار — **واللائحةُ توجب موافقةَ جهة التحكم
/// المسبقة قبل التعاقد معه** (م١٧/٥/ج)، **وجهةُ التحكم هي التاجر لا نحن**.
///
/// ⚠️ **جدولُ منصّةٍ لا مستأجر** — **بلا أبٍ عمداً (كيانٌ جذريٌّ تملكه المنصّة)**: قائمةٌ
/// واحدةٌ لكلِّ التجّار، فلا `companyId` فيها ولا عزلَ مستأجر.
model SubProcessor {
  id      String @id @default(uuid())
  name    String
  purpose String
  /// **الموقعُ الجغرافيّ** — وهو ما يحكم النقلَ خارج المملكة، فلا يُحذف من العرض.
  location String
  /// فئاتُ البيانات التي يعالجها (م١٧/١/ب).
  dataCategories String[]

  addedAt   DateTime  @default(now())
  /// يُرفع من القائمة ولا يُحذف صفُّه — فما وقعت الموافقةُ عليه يبقى مقروءاً.
  removedAt DateTime?

  @@map("sub_processors")
}

/// نسخةٌ **منشورة** من القائمة — **والموافقةُ تقع على نصٍّ ثابتٍ لا على جدولٍ متحرّك**:
/// فلو قُبلت «القائمة» لصار تعديلُ صفٍّ فيها تغييراً لِما وُوفق عليه بلا موافقةٍ جديدة.
///
/// ⚠️ **جدولُ منصّةٍ لا مستأجر — بلا أبٍ عمداً (كيانٌ جذريٌّ تملكه المنصّة)**.
model SubProcessorListVersion {
  id      String @id @default(uuid())
  version Int    @unique

  publishedAt DateTime @default(now())
  /// **لا تُلزِم قبل هذا التاريخ** — ومهلتُه **ثلاثون يوماً على الأقلّ** من النشر
  /// (`ق-٥٨٩/①`): فتغييرُ معالجٍ فرعيٍّ يُعرف قبل وقوعه ولا يُعلَن يومَه.
  effectiveFrom DateTime

  /// ما تغيّر في هذه النسخة — بلغةِ التاجر لا بلغة الجدول.
  summary String
  /// **لقطةُ القائمة وقتَ النشر** — هي نصُّ ما وُوفق عليه.
  entries Json

  acceptances ProcessingAgreementAcceptance[]

  @@map("sub_processor_list_versions")
}

/// قبولُ التاجر لنسخةٍ بعينها — **صفٌّ يُثبت لا ادّعاءٌ يُحكى**: من قبِل، ومتى، ومن أيّ عنوان.
model ProcessingAgreementAcceptance {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  version     Int
  listVersion SubProcessorListVersion @relation(fields: [version], references: [version], onDelete: Restrict)

  acceptedAt     DateTime @default(now())
  /// من قبِل — **الاسمُ وقتَ القبول**، فتغييرُ اسمٍ لاحقاً لا يُعيد كتابة التاريخ.
  acceptedById   String
  acceptedByName String
  ip             String?

  /// قبولٌ واحدٌ لكلِّ نسخة — والقيدُ هو الضمانة لا الشيفرة.
  @@unique([companyId, version])
  @@map("processing_agreement_acceptances")
}

/// ⑬A1 (`ق-١٣٣٣`) — **عدّادُ البريد المُرسَل بالساعة**: حدُّ المزوّد «Emails sent in **last 24 hours**»
/// (`max-emails-day` — جدولُ حدود أوراكل) **نافذةٌ متحرّكة لا يومٌ تقويميّ** — فمئتان في الحادية عشرة ليلاً
/// ومئتان في الواحدة بعدها أربعمئةٌ عند المزوّد ومئتان في عدّادٍ يوميّ. فيُعدّ بالساعة ويُجمع آخرُ أربعٍ وعشرين.
///
/// ⚠️ **بلا `companyId` عمداً**: الحدُّ على **حساب المنصّة عند المزوّد** لا على منشأة — عدّادٌ للمنصّة كلِّها،
/// ولا بياناتِ مستأجرٍ فيه (رقمٌ وساعة) فلا سياسةَ عزل.
model MailSendCount {
  /// أوّلُ الساعة بتوقيتٍ عالميّ — مفتاحُ الدلو.
  hour DateTime @id @db.Timestamptz(3)
  sent Int      @default(0)

  @@map("mail_send_counts")
}


// ─────────────────────────────────────────────────────────────────────────────
// ⚖️ محرّكُ النماذج المهيكلة — الموجةُ ١أ: الأنواعُ والقوالبُ المُصدَّرة (توجيه ٢٧٨ · `ق-١٦٣٤`)
// الخطّة: docs/plans/handover-forms-master-plan.md §٦.١ و§٦.٢ · والموجةُ صفر: docs/plans/handover-forms-wave-zero.md §١
// ─────────────────────────────────────────────────────────────────────────────

/// حالُ إصدار القالب. **المسوّدةُ** وحدَها تُحرَّر؛ **والمنشورُ** لا يُعدَّل بل يُنشأ إصدارٌ بعده (القاعدة ١ من §٦.٢)؛
/// **والمؤرشَفُ** إصدارٌ نُشر بعده أحدثُ منه، يبقى مقروءاً لأن السجلّاتِ المعبّأةَ تشير إلى إصدارها.
enum FormTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// نوعُ البند في القالب (§٦.١ من الخطّة). ما يُلتقط بصورةٍ وخريطةِ الضرر ومستوى الوقود يُضاف مع موجته (الأدلة ٢ · المركبات ٧).
enum FormItemType {
  /// حالةٌ تُوصف (مقبول · تالف …) ومعها ملاحظة.
  CONDITION
  /// عددٌ صحيح يُسلَّم أو يُستلم (المفاتيح · القطع).
  QTY
  /// رقمٌ عامّ بنطاقٍ اختياريّ.
  NUMBER
  /// قراءةُ عدّاد (كهرباء · ماء · مسافة).
  METER_READING
  /// درجةُ حرارة بنطاقٍ مقبول (الأدوية 2–8 مثلاً).
  TEMPERATURE
  /// نعم أو لا.
  BOOLEAN
  /// نصٌّ حرّ.
  TEXT
}

/// **نوعُ النموذج** — تملكه المنصّة (`ق-١٥٩٩` قرارُ الخطّة ٤٣): «تسليمُ وحدة» · «استلامُ وحدةٍ عند نهاية العقد» · «فحصُ مركبة».
/// بلا `companyId` عمداً: كتالوجُ المنصّة يراه كلُّ مستأجر ولا بياناتِ تاجرٍ فيه، والكتابةُ عليه من لوحة المطوّر وحدَها.
/// وما يُلزمه النوعُ في موجاتٍ لاحقة (الحدثُ المُشغِّل · الاقتران · نصابُ التوقيع · مدّةُ الحفظ · مدّةُ التوقيع) يُضاف مع موجته.
model FormType {
  id          String  @id @default(uuid())
  /// مفتاحٌ ثابت لا يتغيّر بتغيّر الاسم (`UNIT_HANDOVER`).
  code        String  @unique
  name        String
  description String?
  /// نشاطُ المنشأة الذي يخصّه (من `activities/sectors.ts`)، وفارغٌ = لكلِّ الأنشطة. وصفٌ يُقرأ لا فرعٌ في المحرّك.
  sector      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates FormTemplate[]

  @@map("form_types")
}

/// **إصدارُ قالبِ نموذج** — صفٌّ لكلِّ إصدار، والإصداراتُ يجمعها `familyId`.
/// ⚖️ **فاعلان** (`CLAUDE.md §3.5` · قرارُ الخطّة ٤٣): `companyId` فارغٌ = قالبٌ عامٌّ تملكه المنصّة في لوحة المطوّر،
/// ومملوءٌ = نسخةُ التاجر في شاشات منشأته، **منسوخةٌ من إصدارٍ عامٍّ بعينه** (`sourceTemplateId`) فلا يغيّرها تعديلُ المنصّة لاحقاً.
/// والعزلُ في القاعدة بصياغةٍ ثنائية النطاق (العامُّ يُقرأ من كلِّ سياق، والكتابةُ لصاحبها) — الهجرة `20261004000000_form_templates`.
model FormTemplate {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  formTypeId String
  formType   FormType @relation(fields: [formTypeId], references: [id], onDelete: Restrict)

  /// يجمع إصداراتِ القالب الواحد؛ وهو معرّفُ إصداره الأوّل.
  familyId String
  version  Int
  status   FormTemplateStatus @default(DRAFT)

  name        String
  description String?

  /// للنسخة وحدَها: الإصدارُ العامُّ الذي نُسخت منه — وفارغٌ لقالب المنصّة.
  sourceTemplateId String?
  sourceTemplate   FormTemplate?  @relation("FormTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: Restrict)
  copies           FormTemplate[] @relation("FormTemplateSource")

  /// وقتُ النشر من الخادم؛ وفارغٌ للمسوّدة وحدَها (قيدُ `form_templates_published_stamped`).
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       FormTemplateItem[]
  itemsTenant FormTemplateItem[] @relation("FormTemplateItem_templateId_tenant")

  instances       FormInstance[]
  instancesTenant FormInstance[] @relation("FormInstance_templateId_tenant")

  @@unique([familyId, version])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("form_templates")
}

/// **بندٌ في إصدار القالب** — يتجمّد بنشر إصداره، ويُنسخ مع الإصدار الجديد ومع نسخة التاجر.
/// `companyId` يتبع قالبَه: فارغٌ للعامّ ومملوءٌ للنسخة، والمركّبُ يحرس ألّا يُعلَّق بندُ منشأةٍ على قالب غيرها.
model FormTemplateItem {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  templateId     String
  template       FormTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  templateTenant FormTemplate? @relation("FormTemplateItem_templateId_tenant", fields: [companyId, templateId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ترتيبُ البند في القالب، من ١ بلا فجوة.
  lineNo   Int
  label    String
  itemType FormItemType
  /// بندٌ فارغٌ يمنع الختم.
  required Boolean @default(false)
  /// النطاقُ المقبول لما هو رقم (العددُ والرقمُ والعدّادُ والحرارة)، وكلاهما اختياريّ.
  minValue Decimal? @db.Decimal(18, 4)
  maxValue Decimal? @db.Decimal(18, 4)
  /// قيمةٌ خارج النطاق تمنع الختم؛ وإلا سُجّلت انحرافاً ومضى (القاعدةُ ٣ من §٦.٢: الانحرافُ يُحسب لا يُكتب).
  isBlocking Boolean @default(false)
  /// وحدةُ القياس كما تُعرض (°م · ك.و.س).
  unit     String?
  helpText String?

  values       FormValue[]
  valuesTenant FormValue[] @relation("FormValue_itemId_tenant")

  @@unique([templateId, lineNo])
  @@unique([companyId, id])
  @@map("form_template_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// ⚖️ محرّكُ النماذج — الموجةُ ١ج: السجلُّ المعبّأ والختم (توجيه ٢٧٨ · `ق-١٦٣٥` · `ق-١٦٣٦`)
// ─────────────────────────────────────────────────────────────────────────────

/// حالُ السجلّ المعبّأ في الموجة ١: مسوّدةٌ تُعبّأ، ثم مختومٌ لا يُعدَّل ولا يُحذف (القاعدةُ ٢ من §٦.٢ · ③ب: القاعدةُ مع البرنامج).
/// وما بعدها (انتظارُ التواقيع · معترَضٌ عليه · منقَضٍ · مستبدَلٌ بنموذجٍ تصحيحيّ) يُضاف مع موجته.
enum FormInstanceStatus {
  DRAFT
  SEALED
}

/// **سجلٌّ معبّأ على إصدارٍ منشورٍ من قالب المنشأة** (القاعدةُ ١ من §٦.٢: السجلُّ يشير إلى الإصدار لا إلى القالب).
/// والموضوعُ (`subjectType` · `subjectId`) يكتبه النشاطُ الذي يطلب النموذج بعد أن يتحقّق منه — **والمحرّكُ لا يعرف نشاطاً** (`CLAUDE.md §3` أ)،
/// فلا مفتاحَ أجنبيّاً إلى العقد هنا. والختمُ (`ق-١٦٣٦`): رقمٌ `FRM-<السنة>-<التسلسل>` وموضعٌ في سلسلة أختام المنشأة وبصمةُ السجلّ كلِّه
/// وبصمةُ الختم السابق؛ ومُشغِّلٌ في القاعدة يمنع تعديلَ المختوم وحذفَه (`ق-١٦٣٥` ③ب).
model FormInstance {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  templateId     String
  template       FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — المركّبُ يحرس أن يُعبّأ السجلُّ على قالب المنشأة نفسِها لا على قالبٍ عامٍّ ولا قالبِ غيرها.
  templateTenant FormTemplate @relation("FormInstance_templateId_tenant", fields: [companyId, templateId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ما يخصّه السجلّ، يكتبه النشاطُ الطالب (`contract`) بمعرّفه.
  subjectType String
  subjectId   String

  /// تاريخُ التعبئة — ومنه سنةُ الرقم لا من ساعة الخادم (`ق-١٦٣٦` ج).
  formDate DateTime           @db.Date
  status   FormInstanceStatus @default(DRAFT)

  filledById   String
  filledByName String

  /// يُكتب عند الختم وحدَه، وقيدُ `form_instances_sealed_stamped` يُلزمها معاً للمختوم ويمنعها للمسوّدة.
  no           String?
  sealSeq      Int?
  contentHash  String?
  prevHash     String?
  sealedById   String?
  sealedByName String?
  sealedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values       FormValue[]
  valuesTenant FormValue[] @relation("FormValue_instanceId_tenant")

  @@unique([companyId, id])
  @@unique([companyId, no])
  @@unique([companyId, sealSeq])
  @@index([companyId, subjectType, subjectId])
  @@map("form_instances")
}

/// **قيمةُ بندٍ في السجلّ** — نوعُها من نوع البند، ولا تُكتب ولا تُعدَّل ولا تُحذف بعد الختم (مُشغِّلٌ في القاعدة).
/// والانحرافُ عن النطاق يُحسب من القيمة والبند لا يُكتب (القاعدةُ ٣ من §٦.٢).
model FormValue {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  instanceId     String
  instance       FormInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  instanceTenant FormInstance @relation("FormValue_instanceId_tenant", fields: [companyId, instanceId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  itemId     String
  item       FormTemplateItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// ق-١٢٥٢ — حارسُ الكتابة عبر المنشآت: المركّبُ بجانب المفرد، بلا فعلٍ عند الحذف (المفردُ يحمله).
  itemTenant FormTemplateItem @relation("FormValue_itemId_tenant", fields: [companyId, itemId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  textValue   String?
  numberValue Decimal? @db.Decimal(18, 4)
  boolValue   Boolean?
  note        String?

  @@unique([instanceId, itemId])
  @@map("form_values")
}
