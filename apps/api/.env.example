DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/mad_app?schema=public"
# Superuser connection, used only by `prisma migrate dev` to create its
# throwaway shadow database — never used at runtime.
SHADOW_DATABASE_URL="postgresql://mad_app:mad_app_dev_password@localhost:5432/mad_app_shadow?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
# Refresh tokens are opaque random values (hashed in the DB), not JWTs, so
# there's no separate refresh secret to configure — only their lifetime.
JWT_REFRESH_TTL="30d"

PORT=3000
WEB_ORIGIN="http://localhost:5173"

S3_ENDPOINT="http://localhost:9100"
S3_ACCESS_KEY="mad_app"
S3_SECRET_KEY="mad_app_dev_password"
S3_BUCKET="mad-app-files"

DEV_SEED_PLATFORM_ADMIN_USERNAME="Arsan"
DEV_SEED_PLATFORM_ADMIN_PASSWORD="change-me-strong-password"

SECRETS_ENCRYPTION_KEY="change-me-at-least-32-characters-long"
