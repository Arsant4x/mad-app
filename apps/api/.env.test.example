# قالب بيئة الاختبار — **مصدر واحد** يستهلكه المحلي والحاوية والسير.
#
# لماذا وُجد: أضعنا أربع دورات تشغيل (~ساعة ونصف) على تفاوت متغيّرات بين
# البيئات — مرّة بأربعة متغيّرات من عشرة، ومرّة بكلمة مرور مديرٍ تخالف
# المبذورة، ومرّة بلا MinIO. وكل سقوطٍ منها بدا **عطلاً في المنصة** حتى
# فُحص، فأُهدر الوقت مرّتين: في التشغيل وفي التشخيص الخاطئ.
#
#   انسخه:  cp .env.test.example .env.test
#
# ولا يُلتزم `.env.test` نفسه — الخطاف يمنعه (.env* محجوبة).

# ── قاعدة الاختبار ──────────────────────────────────────────────────────
# app_user لا الدور الأعلى: الأخير يتجاوز عزل الصفوف بصمت، واختبارٌ يعمل
# به لا يختبر العزل أصلاً.
DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/mad_app?schema=public"

# ── الجلسات ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="test-jwt-secret-not-used-outside-tests-0123456789"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
WEB_ORIGIN="http://localhost:5173"

# ── تشفير أسرار ZATCA ───────────────────────────────────────────────────
# ⚠️ غيابه يجعل `/zatca/onboarding/start` يرتدّ بـ400 فتسقط ثلاث مجموعات
# بسببٍ يبدو منطقياً وليس كذلك. لا تحذفه.
SECRETS_ENCRYPTION_KEY="test-secrets-key-at-least-32-characters-long"

# ── تشفيرُ الحقول الحسّاسة في التطبيق (ق-١٣٤٥) ──────────────────────────
# ⚠️ غيابُها يُسقط إنشاءَ موظفٍ بهويّته (`employee-identity`) برسالة إعداد. قيمٌ للاختبار وحدَه — بايتٌ واحدٌ مكرَّر
# عمداً، والإنتاجُ يرفضها. والمعرّفان `test1`/`tb1` تقرؤهما الحزمةُ في صيغة القيمة المخزَّنة.
PII_ENCRYPTION_KEYS="test1:ERERERERERERERERERERERERERERERERERERERERERE="
PII_ENCRYPTION_KEY_ID="test1"
PII_BLIND_INDEX_KEY="tb1:IiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiI="

# ── مزوّدا الرسائل والهويّة (توجيه ٢٨٧) — التجريبيّان وحدَهما في الاختبار؛ والإنتاجُ يرفضهما عند الإقلاع وعند الاستعمال ──
SMS_PROVIDER="MOCK"
IDENTITY_PROVIDER="MOCK"
AUTHORITY_PROVIDER="MOCK"

# ── تخزين الملفات ───────────────────────────────────────────────────────
# ⚠️ بلا MinIO يرتدّ رفع الشعار بـ500 وتسقط company-profile.
S3_ENDPOINT="http://localhost:9100"
S3_ACCESS_KEY="mad_app"
S3_SECRET_KEY="mad_app_dev_password"
S3_BUCKET="mad-app-files"

# ── مدير المنصة ─────────────────────────────────────────────────────────
# ⚠️ يجب أن تطابق ما بُذرت به القاعدة: `bootstrapPlatform` لا يعيد ضبط كلمة
# مرور حسابٍ قائم (`update: {}` — وهو سلوكٌ صحيح يمنع إعادة التشغيل من إبطال
# تدوير كلمة مرور). فبذرةٌ بكلمة واختبارٌ بأخرى ⇒ 401 في كل مسار إداري.
DEV_SEED_PLATFORM_ADMIN_USERNAME="Arsan_admin"
DEV_SEED_PLATFORM_ADMIN_PASSWORD="TestAdminPass123!"
