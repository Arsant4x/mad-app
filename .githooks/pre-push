#!/bin/sh
# اللغة تُضبط أولاً — §8.7 الوجه السادس: grep بلا لغةٍ يعامل النصّ العربي
# بايتاتٍ لا أحرفاً ويعود صفراً بلا خطأ. ويحرسه `locale-gate.spec.ts`.
export LC_ALL=C.UTF-8
#
# ⛔ السجلّاتُ لا تُخلط بالشيفرة (`ق-٣٧١` · `ق-٣٧٩`)
#
# `docs/decisions.md` و`docs/engines.md` **سجلّا أرقامٍ محجوزة**: فرعٌ يمسّهما
# مع شيفرةٍ يصنع **سباقَ ترقيمٍ ومكرَّرات** — وقد أمسك الحارسُ `ق-319` مكرَّراً
# في جلسةٍ واحدة. ومعهما قاعدةُ «سجلٌّ واحد لكل جلسة».
#
# ── لماذا عند الدفع لا عند الدمج ─────────────────────────────────────────
#
# **الضررُ يقع عند الدفع**: في 2026-09-09 بُنيت بوّابةٌ وسبعةُ حرّاسٍ **على فرع
# السجل** — أُنشئ فرعُ الشيفرة ثم انتُقل للتسجيل ولم يُعَد — **فبلغت الشيفرةُ
# طلباً منشوراً قبل أن يراها أحد**. **وهي الرابعة من صنفها.**
#
# **وخطوةُ السير تبقى** (`registry-not-with-code`): هذا الخطّاف يُتجاوَز
# بـ`--no-verify` **ويغيب على نسخةٍ لم تُثبَّت** — فالخطّافُ يمنع والسيرُ يضمن.
#
# ⚠️ **و`CLAUDE.md` مستثنىً صراحةً** (`ق-٣٧٢`): قواعدُ تشغيلٍ لا سجلُّ أرقام،
# **وقاعدةٌ تُستخرَج من إصلاحٍ هي غرضُه نفسه**. **والاستثناءُ يُسمّى ولا
# يُستنتَج** — فلا يمتدّ إلى وثيقةٍ ثالثة بحجّة أنها «ليست سجلاً».
#
# التفعيل (مرة واحدة لكل نسخة):   git config core.hooksPath .githooks
# التجاوز عند الحاجة الحقيقية:     git push --no-verify

base=$(git merge-base HEAD origin/main 2>/dev/null) || exit 0
[ -n "$base" ] || exit 0

changed=$(git diff --name-only "$base" HEAD)
[ -n "$changed" ] || exit 0

registry=$(printf '%s\n' "$changed" | grep -E '^docs/(decisions|engines)\.md$')
code=$(printf '%s\n' "$changed" | grep -E '^(apps|packages)/')

if [ -n "$registry" ] && [ -n "$code" ]; then
  echo "⛔ السجلّاتُ لا تُخلط بالشيفرة (ق-٣٧١) — والفرعُ يمسّ الاثنين:" >&2
  echo "" >&2
  echo "  السجلّات:" >&2
  printf '    · %s\n' $registry >&2
  echo "  والشيفرة:" >&2
  printf '    · %s\n' $code | head -8 >&2
  echo "" >&2
  echo "  فالسجلُّ في طلبه، والشيفرةُ في طلبها — «PR واحد = غرضٌ واحد»." >&2
  echo "  والسببُ الغالب: أُنشئ فرعُ الشيفرة ثم انتُقل للتسجيل ولم يُعَد." >&2
  echo "" >&2
  echo "  العلاج: git cherry-pick <التزام الشيفرة> على فرعها، ثم" >&2
  echo "          git rebase --onto <ما قبله> <التزام الشيفرة> على فرع السجل." >&2
  exit 1
fi

exit 0
