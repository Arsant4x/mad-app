#!/bin/sh
# اللغة تُضبط أولاً — §8.7 الوجه السادس: grep بلا لغةٍ يعامل النصّ العربي
# بايتاتٍ لا أحرفاً ويعود صفراً بلا خطأ. ويحرسه `locale-gate.spec.ts`.
export LC_ALL=C.UTF-8
# حارس الأسرار — يمنع تكرار ما حدث مع backup-before-cleanup.sql.
#
# الدرس الذي وُلد منه هذا الملف: كان المسار مذكوراً في .gitignore منذ يوم
# إضافته، ومع ذلك بقي يُدفع إلى GitHub تسعة أشهر — لأن **قواعد التجاهل لا
# تسري على ملف متتبَّع أصلاً**. فالحماية بـ.gitignore وحدها وهمٌ يُطمئن.
#
# هذا الخطاف يفحص ما هو **مُدرَج للالتزام فعلاً**، فيمسك الحالتين معاً:
# الملف الجديد الذي يتجاوز التجاهل بـ`git add -f`، والملف المتتبَّع سلفاً.
#
# التفعيل (مرة واحدة لكل نسخة):   git config core.hooksPath .githooks
# التجاوز عند الحاجة الحقيقية:     git commit --no-verify
#
# ملاحظة: git لا يشارك .git/hooks بين النسخ، ولذلك يعيش الخطاف هنا داخل
# المستودع ويُشار إليه بـcore.hooksPath — وإلا لحمى جهاز كاتبه وحده.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

blocked=""
reason=""

for f in $staged; do
  case "$f" in
    # المسموح صراحةً أولاً — هجرات Prisma وسكربتات تهيئة Postgres مصدرٌ لا بيانات.
    apps/api/prisma/migrations/*|docker/postgres-init/*|docker/postgres-init-prod/*) continue ;;
    # بذرُ قياس المراجع الخارجيّ — مصدرُ قياسٍ خارجيّ، لا بيانات (generate_series بلا صفٍّ منقول ولا هاش ولا مفتاح).
    # أذن به المالك 2026-09-20 (التوجيه ٢٤١ · ق-١٢١٧) **بالمسار الكامل لا بنمط** — فنمطٌ على المجلد يفتح ما لم يُقرأ —
    # وفحصُ المحتوى أدناه يبقى عليه (مُثبَتٌ بسرٍّ مزروعٍ يُرفض). ملفٌّ آخر في المجلد نفسه يبقى مرفوضاً بالنوع.
    bench/external-review-2026-09/seed.sql) continue ;;
    # القوالب الفارغة مقصودة.
    *.env.example|*.env.test.example|.env.example|.env.production.example|.env.test.example) continue ;;
  esac

  case "$f" in
    *.sql)   blocked="$blocked\n  $f  — ملف SQL خارج مجلد الهجرات (مقلب قاعدة؟)" ;;
    *.dump|*.bak|*.backup) blocked="$blocked\n  $f  — مقلب/نسخة احتياطية" ;;
    *.pem|*.key|*.p12|*.pfx|*.jks) blocked="$blocked\n  $f  — مفتاح أو شهادة" ;;
    .env|.env.*|*/.env|*/.env.*) blocked="$blocked\n  $f  — ملف بيئة (أسرار)" ;;
  esac
done

# فحص المحتوى: الاسم قد يكون بريئاً والحمولة سرّاً. يفحص النسخة **المُدرَجة**
# (:$f) لا التي على القرص — فما يُلتزم هو ما في الفهرس.
for f in $staged; do
  case "$f" in
    apps/api/prisma/migrations/*) continue ;;
    *.spec.ts|*.e2e-spec.ts|*.md) continue ;;  # توكيدات ووثائق تذكر الأنماط نصاً
    # والخطاف نفسه: أنماط البحث مكتوبة داخله حرفياً، فبدون هذا السطر يرفض
    # نفسه عند أول التزام — وقد فعل. الأنماط كودٌ لا حمولة، كحال الاختبارات.
    .githooks/*) continue ;;
  esac
  content=$(git show ":$f" 2>/dev/null | head -c 2000000) || continue
  case "$content" in
    *'$argon2id$v='*)          reason="$reason\n  $f  — يحتوي هاش كلمة مرور argon2id" ;;
  esac
  case "$content" in
    *'-----BEGIN'*'PRIVATE KEY-----'*) reason="$reason\n  $f  — يحتوي مفتاحاً خاصاً" ;;
  esac
done

if [ -n "$blocked" ] || [ -n "$reason" ]; then
  printf '\n'
  printf '════════════════════════════════════════════════════════════\n'
  printf '  رُفض الالتزام: ملفات قد تحمل أسراراً\n'
  printf '════════════════════════════════════════════════════════════\n'
  [ -n "$blocked" ] && printf '  بحسب النوع:%b\n' "$blocked"
  [ -n "$reason" ]  && printf '  بحسب المحتوى:%b\n' "$reason"
  printf '\n'
  printf '  ما دخل التاريخ لا يخرج منه إلا بإعادة كتابته ودفعٍ قسري\n'
  printf '  لكل الفروع — وحتى بعدها يُعامل السرّ كمكشوف.\n'
  printf '\n'
  printf '  انقل الملف خارج المستودع، أو أزله من الإدراج:\n'
  printf '    git restore --staged <path>\n'
  printf '  وإن كان مقصوداً فعلاً:  git commit --no-verify\n'
  printf '════════════════════════════════════════════════════════════\n\n'
  exit 1
fi

exit 0
