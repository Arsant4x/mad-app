# انسخ هذا الملف إلى .env.production واملأ كل قيمة قبل التشغيل.
# أي قيمة فيها change-me يجب تغييرها — لا تُشغّل الإنتاج بقيم المثال.

# ---- قاعدة البيانات ----
POSTGRES_USER=mad_app
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=mad_app
# كلمة مرور دور التطبيق (app_user) — غير الدور الأعلى عمداً، لأن الدور الأعلى
# يتجاوز عزل الصفوف (RLS) بصمت.
APP_DB_PASSWORD=change-me-strong-app-password

# ---- الجلسات ----
# ولّدها بـ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- العناوين العامة ----
# عنوان الواجهة كما يراه المتصفح (يظهر في روابط الاستعادة وCORS).
WEB_ORIGIN=https://app.example.com
# عنوان الـAPI كما يراه المتصفح — يُخبز داخل بناء الواجهة.
PUBLIC_API_URL=https://api.example.com

# ---- تخزين الملفات (MinIO) ----
S3_ACCESS_KEY=mad_app
S3_SECRET_KEY=change-me-strong-minio-password
S3_BUCKET=mad-app-files
# العنوان الذي يفتحه **متصفح العميل** لتنزيل المرفقات. العنوان الداخلي
# (http://minio:9000) لا يُحلّ خارج شبكة Docker، فبدون هذا يُرفع كل مرفق
# بنجاح ولا يُنزَّل أبداً. وجّه نطاقاً فرعياً عبر الوسيط العاكس إلى منفذ
# MinIO 9000 — تماماً كما يوجَّه app. وapi.
S3_PUBLIC_URL=https://files.example.com

# ---- تشفير أسرار ZATCA ----
SECRETS_ENCRYPTION_KEY=change-me-at-least-32-characters-long

# ---- تشفير بيانات اعتماد بوابات الدفع للتجار ----
# ⚠️ أخطر مفتاح في الملف: بديله داخل الكود ثابتٌ **نصّه منشور في المستودع
# العام**، فغيابه يعني أن بيانات اعتماد التجار «مشفَّرة» بمفتاح يعرفه الجميع.
# لذلك يرفض الخادم الإقلاع بدونه بدل أن يعود للبديل بصمت.
INTEGRATIONS_ENC_KEY=change-me-at-least-32-characters-long

# ---- تشفير الحقول الحسّاسة في التطبيق: هويّة الموظف وحسابه ورقم تأميناته (ق-١٣٤٥) ----
# «معرّفٌ:مفتاح» — المفتاحُ ٣٢ بايتاً بـbase64، يولَّد على جهازك: openssl rand -base64 32
# الحلقةُ تقبل أكثر من مفتاح (مفصولةً بفواصل): الجديدُ يُكتب بالنشيط، والقديمُ يُقرأ بمعرّفه في كلِّ قيمة —
# فالتدويرُ إضافةُ مفتاحٍ وتبديلُ المعرّف النشيط، **لا إعادةُ تشفير**. ⚠️ لا يُحذف مفتاحٌ ما دامت به قيمة.
# ⚠️ **وتُحفظ نسختُها خارج الخادم** (خزنةُ كلمات المرور): ضياعُها ضياعُ تلك الحقول بلا استرداد.
PII_ENCRYPTION_KEYS=k2026a:change-me-openssl-rand-base64-32
PII_ENCRYPTION_KEY_ID=k2026a
# مفتاحُ بصمة البحث برقم الهويّة — منفصلٌ عن مفاتيح التشفير (يرفض الإقلاعُ أن يكون أحدَها).
PII_BLIND_INDEX_KEY=b2026a:change-me-openssl-rand-base64-32

# ---- مزوّدا الرسائل القصيرة والتحقّق من الهويّة (توجيه ٢٨٧) ----
# فارغان حتى يُتعاقد مع مزوّدٍ داخل المملكة (شرطُ تشغيل)؛ وبلا قيمةٍ يُرفض إرسالُ رابط التوقيع باسمه. و«MOCK» يرفضه الإقلاع.
SMS_PROVIDER=
IDENTITY_PROVIDER=
AUTHORITY_PROVIDER=

# ---- البريد (استعادة كلمة المرور) — أوراكل «Email Delivery» في الرياض (ق-١٣٣٣) ----
# فارغاً = لا بريد. **ومتى ضُبط SMTP_HOST** يطلب الإقلاعُ SMTP_FROM من نطاقٍ حقيقيّ وMAIL_DAILY_LIMIT،
# ويرفض deploy.sh النشرَ حتى تحضر سجلّاتُ SPF وDKIM وDMARC للنطاق (DEPLOY.md: «البريد»).
SMTP_HOST=
# أوراكل: TLS على 465 من أوّل الاتصال — والخادمُ يفعّله حين يكون المنفذُ 465.
SMTP_PORT=465
# بياناتُ SMTP يولّدها الكونسول للمستخدم (Generate SMTP Credentials) — لا كلمةُ مرور الحساب.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# المنتقي كما يعرضه الكونسول بعد «Generate DKIM Record» — يفحص به deploy.sh سجلَّ DKIM.
MAIL_DKIM_SELECTOR=
# حدُّ «Emails sent in last 24 hours» كما تعرضه حجرةُ الحدود (max-emails-day) — رقمٌ يُقرأ من وحدة التحكّم
# لا يُخمَّن. يُنذر السجلُّ عند ٨٠٪ ليُطلب الرفعُ قبل أن يُبلغ.
MAIL_DAILY_LIMIT=

# ---- تتبّع الأخطاء (GlitchTip) — ق-١٣٣١ ----
# ⛔ فارغاً حتى يوجد الخادمُ المستقلّ داخل المملكة (شرطُ تشغيل: docs/licensing-and-operations.md).
# ومتى ضُبط: https://<المفتاح>@<الخادم>/<رقم المشروع> — ويُرسَل خطأُ 5xx وحدَه بقائمة سماح: المسارُ والخطأُ
# والتتبّعُ ومعرّفُ الطلب ومعرّفُ المستخدم مُبصَّماً؛ ولا جسمَ ولا ترويسةَ ولا كوكي.
ERROR_TRACKING_DSN=

# ---- سياسة المنصة ----
TRIAL_DAYS=14
REGISTRATION_ENABLED=true
# وثائق Swagger مطفأة في الإنتاج: المستند يعدّد كل نقطة نهاية وكل حقل بلا
# مصادقة — خريطةُ سطح هجوم مقدَّمة مجاناً. اجعلها true مؤقتاً عند التشخيص.
ENABLE_API_DOCS=false
# المصادقة المتعددة إلزامية لحسابات المنصّة، وحارس الإقلاع يرفض أي قيمة غير true.
# المدير الذي لم يفعّلها بعد يُطلب منه تفعيلها عند أول دخول ثم يدخل بالرمز.
MFA_REQUIRED_FOR_PLATFORM_ADMIN=true

# ---- حساب مدير المنصة (يُنشأ عند تشغيل seed) ----
PLATFORM_ADMIN_USERNAME=Arsan
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# ---- النسخةُ خارج المضيف (ق-٥٧٣ … ق-٥٧٧ · ق-٧٣٤) — مستودعُ restic على مخزنٍ متوافقٍ مع S3 ----
# بلا هذه الأربعة تبقى الخدمةُ «unconfigured» وتُعلن ذلك كلَّ ساعة. القيمُ من صاحب المشروع
# مباشرةً — لا تُكتب في المستودع ولا تمرّ بمحادثة. مثالُ أوراكل (الرياض):
#   RESTIC_REPOSITORY=s3:https://<namespace>.compat.objectstorage.me-riyadh-1.oraclecloud.com/<bucket>
#   OFFSITE_REGION=me-riyadh-1
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
OFFSITE_REGION=us-east-1
# 1 = مفتاحُ الرفع لا يحذف (سياسةُ الدلو تسمح بالحذف على locks/* فقط) ⇒ لا تقليمَ يومياً؛ التقليمُ شهرياً بمفتاح الحذف
OFFSITE_APPEND_ONLY=0
